func printy<T: Showable>(showable: T) {
	print_raw(showable.show())
	print_raw("\n")
}

struct Fizz {
	let a: Int
	let b: Float
}

struct Buzz {
	let fizz: Fizz
	let b: Int
}

printy(showable: 123)
printy(showable: 1.23)
printy(showable: "a string")
printy(showable: Fizz(a: 123, b: 1.23))
printy(showable: [1, 2, 3])
printy(showable: Buzz(fizz: Fizz(a: 123, b: 1.23), b: 456))
