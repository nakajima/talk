// Chat echo server
//
// Listens on port 9900, accepts connections, echoes messages back.
// Test with: nc localhost 9900
//
// Usage: talk run examples/ChatServer.tlk

@unsafe {
	let server = _io_socket(domain: AF_INET, socktype: SOCK_STREAM, proto: 0)
	_io_bind(fd: server, addr: INADDR_ANY, port: 9900)
	_io_listen(fd: server, backlog: 128)
	print("Listening on port 9900")

	loop {
		print("waiting for accept...")
		let client = _io_accept(fd: server)

		let greeting = "Welcome! Send a message:\n"
		_io_write(fd: client, buf: greeting.storage.base, count: greeting.byte_count)

		loop {
			let buf = _alloc(count: 1024)
			let n = _io_read(fd: client, buf: buf, count: 1024)
			if n <= 0 {
				break
			}

			let response = _alloc(count: 1030)
			let prefix = "echo: "
			_copy(from: prefix.storage.base, to: response, length: prefix.byte_count)
			let dest = _ptr_add(ptr: response, offset: prefix.byte_count)
			_copy(from: buf, to: dest, length: n)
			_io_write(fd: client, buf: response, count: prefix.byte_count + n)
		}

		_io_close(fd: client)
	}
}
