// Sinatra-esque API demo in pure Talk.
//
// Run:
//   talk run examples/WebApi.tlk
//
// Try:
//   curl http://localhost:3000/
//   curl http://localhost:3000/health
let http = HTTP.Server()
http.get(path: "/", handler: func() { "hello from talk" })
http.get(path: "/health", handler: func() { "ok" })

print("Listening on http://localhost:3000")
http.run(port: 3000)
