// The self-hosted parser (ADR 0043 stage 2). A port of the reference
// recursive-descent/Pratt parser over the Talk lexer's token stream,
// validated construct-by-construct against the frozen dump corpus.
//
// Errors carry the reference diagnostic code and rendered message so
// the validation dump matches byte-for-byte.
//
// The reference parser streams tokens with previous/current/next plus
// a previous-before-newline cursor for span ends. Here the scanner runs
// up front and `pos` indexes the token list: `current` is `tokens[pos]`
// (end-of-stream yields EOF tokens forever, like the reference lexer),
// and the previous-before-newline cursor is recovered by scanning
// backward past newline tokens.

use package::Lexer::{ Token, TokenKind, TokenRange, ScanResult, Comment, scan, kind_spelling, append, append_int }
use package::Ast::{
	Expr, ExprKind, CallArg, MemberLabel, Parameter, Block, RecordField,
	Pattern, PatternKind, RecordFieldPattern, RecordFieldPatternKind,
	TypeAnnotation, TypeAnnotationKind, GenericArg, EffectSet,
	StaticExpr, StaticExprKind, StaticOpKind, MacroParam,
	MetaToken, NodeMeta,
	RecordFieldTypeAnnotation, AnyAssocBinding,
	Decl, DeclKind, Import, ImportedSymbol, ImportedSymbols,
	Stmt, StmtKind, Item, MatchArm, ArgMode, IRValue, IRInstruction,
	ParamMode, ParamLabel, CaptureMode, CaptureSpec, GenericDecl,
	WherePredicateKind, WherePredicate, WhereClause,
	Func, FuncSignature, Body, TypeApplication, ReceiverMode,
	MacroToken, macro_token
}

// A function-type parameter's ownership-mode prefix (ADR 0018), held
// only until the parenthesized list resolves to a function type.
enum TypeParamMode {
	case unadorned
	case mut_mode
	case consume_mode
	case consume_mut_mode
}

// The body context a block parses under (the reference `BlockContext`):
// it decides brace recovery (if/loop), the no-brace single-statement
// form (match arms), and member dispatch inside nominal bodies.
enum BlockContext {
	case plain
	case func_body
	case if_body
	case loop_body
	case match_arm_body
	case struct_body
	case enum_body
	case protocol_body
	case extend_body
}

func context_is_nominal(context: BlockContext) -> Bool {
	context == .struct_body || context == .enum_body || context == .protocol_body || context == .extend_body
}

// Whether trailing-block calls are allowed at the cursor (the reference
// `ParseContext`): disabled inside control-flow headers, where the `{`
// belongs to the construct's body.
enum ParseContext {
	case top_level
	case match_scrutinee
	case if_condition
	case loop_condition
	case for_iterable
}

// One comma-separated `if` condition clause: a boolean expression or a
// `let pattern = scrutinee` binder.
enum ConditionalClause {
	case boolean(Expr)
	case let_clause(Pattern, Expr)
}

func context_is_top_level(context: &ParseContext) -> Bool {
	match context {
		.top_level -> true,
		.match_scrutinee -> false,
		.if_condition -> false,
		.loop_condition -> false,
		.for_iterable -> false
	}
}

func clause_is_boolean(clause: &ConditionalClause) -> Bool {
	match clause {
		.boolean(_) -> true,
		.let_clause(_, _) -> false
	}
}

func all_boolean(clauses: &[ConditionalClause]) -> Bool {
	for clause in clauses {
		if clause_is_boolean(clause: clause) == false { return false }
	}
	true
}

// A member chain flattened into a dotted type path with per-segment
// generic arguments, or not-a-path (the reference `flatten_type_path`
// returns an Option).
enum TypePath {
	case not_a_path
	case path(String, [[GenericArg]])
}

func count_path_segments(path: String) -> Int {
	let bytes = path.utf8()
	let n = bytes.count()
	let count = 1
	let i = 0
	loop i < n {
		if bytes.at(index: i)._toInt() == 46 { count = count + 1 } // "."
		i = i + 1
	}
	count
}

func flatten_type_path(expr: &Expr) -> TypePath {
	match expr.kind {
		.variable(name) -> {
			let no_args: [GenericArg] = []
			return .path(name, [no_args])
		},
		.constructor(name, segments) -> {
			// A constructor minted without explicit args records no
			// segments; pad so the lists parallel the path.
			let copied: [[GenericArg]] = segments
			loop copied.count < count_path_segments(path: name) {
				let empty: [GenericArg] = []
				copied.push(empty)
			}
			return .path(name, copied)
		},
		.member(label, _, _, receiver) -> {
			if let .named(member_name) = label {
				if receiver.count == 0 { return .not_a_path }
				match flatten_type_path(expr: receiver[0]) {
					.path(path, segments) -> {
						let empty: [GenericArg] = []
						segments.push(empty)
						return .path(path + "." + member_name, segments)
					},
					.not_a_path -> return .not_a_path
				}
			}
			.not_a_path
		},
		_ -> .not_a_path
	}
}

// A trailing-block closure with no declared parameters synthesizes one
// positional parameter per `$N` its body references (the reference
// `prepare_closure_block`).
func prepare_closure_block(consume block: Block) -> Block {
	if block.params.count > 0 { return block }
	let max_index = max_bound_var_in_block(block: block)
	if max_index < 0 { return block }
	let params: [Parameter] = []
	let i = 0
	loop i <= max_index {
		let no_label: ParamLabel? = .none
		let no_mode: ParamMode? = .none
		let no_annotation: TypeAnnotation? = .none
		params.push(Parameter(label: no_label, label_start: -1, label_end: -1, name: "$" + i.show(), name_start: -1, name_end: -1, mode: no_mode, mode_start: -1, mode_end: -1, annotation: no_annotation, start: -1, end: -1))
		i = i + 1
	}
	let body = block.body
	Block(params: params, body: body, start: block.start, end: block.end, copied: block.copied)
}

// The index of a `$N` bound-variable name, or -1 for anything else.
func bound_var_index(name: String) -> Int {
	let bytes = name.utf8()
	let n = bytes.count()
	if n < 2 { return -1 }
	if bytes.at(index: 0)._toInt() != 36 { return -1 } // "$"
	let value = 0
	let i = 1
	loop i < n {
		let b = bytes.at(index: i)._toInt()
		if b < 48 || b > 57 { return -1 }
		value = value * 10 + (b - 48)
		i = i + 1
	}
	value
}

func max_int(a: Int, b: Int) -> Int {
	if a > b { return a }
	b
}

// The highest `$N` referenced in a block, or -1 — the reference
// `max_positional_block_arg` walk. Trailing blocks themselves are not
// walked into, matching the reference.
func max_bound_var_in_block(block: &Block) -> Int {
	let best = -1
	for item in block.body {
		best = max_int(a: best, b: max_bound_var_in_item(item: item))
	}
	best
}

func max_bound_var_in_item(item: &Item) -> Int {
	match item {
		.decl_item(d) -> max_bound_var_in_decl(decl: d),
		.stmt_item(s) -> max_bound_var_in_stmt(stmt: s),
		.expr_item(e) -> max_bound_var_in_expr(expr: e),
		.pattern_item(_) -> -1,
		.type_item(_) -> -1
	}
}

func max_bound_var_in_decl(decl: &Decl) -> Int {
	match decl.kind {
		.let_decl(_, _, rhs) -> max_bound_var_in_optional_expr(expr: rhs),
		.property(_, _, _, _, _, value) -> max_bound_var_in_optional_expr(expr: value),
		_ -> -1
	}
}

func max_bound_var_in_optional_expr(expr: &Expr?) -> Int {
	if let .some(e) = expr { return max_bound_var_in_expr(expr: e) }
	-1
}

func max_bound_var_in_optional_block(block: &Block?) -> Int {
	if let .some(b) = block { return max_bound_var_in_block(block: b) }
	-1
}

func max_bound_var_in_exprs(exprs: &[Expr]) -> Int {
	let best = -1
	for e in exprs {
		best = max_int(a: best, b: max_bound_var_in_expr(expr: e))
	}
	best
}

func max_bound_var_in_stmt(stmt: &Stmt) -> Int {
	match stmt.kind {
		.expr_stmt(e) -> max_bound_var_in_expr(expr: e),
		.if_stmt(cond, then_block, else_block) -> max_int(a: max_bound_var_in_expr(expr: cond), b: max_int(a: max_bound_var_in_block(block: then_block), b: max_bound_var_in_optional_block(block: else_block))),
		.return_stmt(e) -> max_bound_var_in_optional_expr(expr: e),
		.break_stmt -> -1,
		.assignment(parts) -> max_bound_var_in_exprs(exprs: parts),
		.loop_stmt(cond, body) -> max_int(a: max_bound_var_in_optional_expr(expr: cond), b: max_bound_var_in_block(block: body)),
		.for_stmt(iterable, _, body, _) -> max_int(a: max_bound_var_in_expr(expr: iterable), b: max_bound_var_in_block(block: body)),
		.continue_stmt -> -1,
		.resume_stmt(e) -> max_bound_var_in_optional_expr(expr: e),
		.handle_stmt(_, _, _, body) -> max_bound_var_in_block(block: body)
	}
}

func max_bound_var_in_expr(expr: &Expr) -> Int {
	match expr.kind {
		.variable(name) -> bound_var_index(name: name),
		.unary(_, operands) -> max_bound_var_in_exprs(exprs: operands),
		.binary(_, operands) -> max_bound_var_in_exprs(exprs: operands),
		.call(callee, _, args, _) -> {
			let best = max_bound_var_in_exprs(exprs: callee)
			for arg in args {
				best = max_int(a: best, b: max_bound_var_in_expr(expr: arg.value))
			}
			best
		},
		.member(_, _, _, receiver) -> max_bound_var_in_exprs(exprs: receiver),
		.tuple(items) -> max_bound_var_in_exprs(exprs: items),
		.literal_array(items) -> max_bound_var_in_exprs(exprs: items),
		.subscript_expr(parts) -> max_bound_var_in_exprs(exprs: parts),
		.block(inner) -> max_bound_var_in_block(block: inner),
		.unsafe_expr(inner) -> max_bound_var_in_block(block: inner),
		.if_expr(cond, then_block, else_block) -> max_int(a: max_bound_var_in_exprs(exprs: cond), b: max_int(a: max_bound_var_in_block(block: then_block), b: max_bound_var_in_block(block: else_block))),
		.match_expr(scrutinee, arms) -> {
			let best = max_bound_var_in_exprs(exprs: scrutinee)
			for arm in arms {
				best = max_int(a: best, b: max_bound_var_in_block(block: arm.body))
			}
			best
		},
		.as_cast(operands, _) -> max_bound_var_in_exprs(exprs: operands),
		.propagate(operands) -> max_bound_var_in_exprs(exprs: operands),
		.force_unwrap(operands) -> max_bound_var_in_exprs(exprs: operands),
		.call_effect(_, _, _, _, args) -> {
			let best = -1
			for arg in args {
				best = max_int(a: best, b: max_bound_var_in_expr(expr: arg.value))
			}
			best
		},
		.record_literal(fields, spread) -> {
			let best = max_bound_var_in_exprs(exprs: spread)
			for field in fields {
				best = max_int(a: best, b: max_bound_var_in_expr(expr: field.value))
			}
			best
		},
		.macro_call(_, _, _, _, _, _, args) -> max_bound_var_in_exprs(exprs: args),
		_ -> -1
	}
}

// Precedence levels, mirroring the reference `Precedence` enum's order.
let prec_none = 0
let prec_assignment = 1
let prec_or = 2
let prec_and = 3
let prec_equality = 4
let prec_comparison = 5
let prec_range = 6
let prec_bit_or = 7
let prec_bit_xor = 8
let prec_bit_and = 9
let prec_shift = 10
let prec_term = 11
let prec_factor = 12
let prec_unary = 13
let prec_call = 14
let prec_primary = 15

// ASCII bytes for the blank-line check.
let blank_newline_byte = 10 // "\n"
let blank_space_byte = 32 // " "
let blank_tab_byte = 9 // "\t"
let blank_return_byte = 13 // "\r"

pub struct Fail {
	pub let code: String
	pub let message: String
	// The diagnostic's source position (-1 = none): the offending
	// token or construct, feeding editor ranges and quick fixes.
	pub let start: Int
	pub let end: Int
	// For unexpected-token diagnostics: the kind the parser wanted
	// (delimiter- and else-insertion quick fixes key on it).
	pub let expected: TokenKind?
}

pub struct ParseOutcome {
	pub let items: [Item]
	pub let failure: Fail?
	pub let diags: [Fail]
	pub let comments: [Comment]
	// Per-node meta in the canonical pre-order the bridge adapter
	// walks (ADR 0043 option A); one entry per adapter-constructed
	// node, synthesized nodes carrying the no-meta marker.
	pub let metas: [NodeMeta]
}

// The reference lex-error rendering: 1-based line, 0-based column,
// derived from the scan cursor at the point of failure. Columns count
// CHARACTERS (the reference bumps per char), so continuation bytes
// don't count.
func lexer_error_message(source: String, pos: Int, message: String) -> String {
	let view = source.utf8()
	let line = 0
	let col = 0
	let i = 0
	loop i < pos {
		let b = view.at(index: i)._toInt()
		if b == blank_newline_byte {
			line = line + 1
			col = 0
		} else if b < 128 || b >= 192 {
			col = col + 1
		}
		i = i + 1
	}
	let buf: [Byte] = []
	append(buf: buf, text: "Lex error at line ")
	append_int(buf: buf, value: line + 1)
	append(buf: buf, text: ", column ")
	append_int(buf: buf, value: col)
	append(buf: buf, text: ": ")
	append(buf: buf, text: message)
	String.from_bytes(bytes: buf)
}

// A kind described for a user-facing message (the reference
// `describe_kind`): literal spellings in backticks, classes in words.
pub func describe_kind(kind: TokenKind) -> String {
	if kind == .eof { return "end of input" }
	if kind == .newline { return "a newline" }
	if kind == .identifier { return "an identifier" }
	if kind == .int_number { return "an integer literal" }
	if kind == .float_number { return "a float literal" }
	if kind == .string_literal { return "a string literal" }
	if kind == .character_literal { return "a character literal" }
	"`" + kind_spelling(kind: kind) + "`"
}

// The infix binding power of a token, from the reference handler table.
// Tokens absent from the table bind at `none`.
func infix_precedence(kind: TokenKind) -> Int {
	if kind == .pipe_pipe { return prec_or }
	if kind == .amp_amp { return prec_and }
	if kind == .equals_equals || kind == .bang_equals { return prec_equality }
	if kind == .less || kind == .less_equals || kind == .greater || kind == .greater_equals { return prec_comparison }
	if kind == .dot_dot || kind == .dot_dot_less { return prec_range }
	if kind == .pipe { return prec_bit_or }
	if kind == .caret { return prec_bit_xor }
	if kind == .amp { return prec_bit_and }
	if kind == .less_less || kind == .greater_greater { return prec_shift }
	if kind == .plus || kind == .minus { return prec_term }
	if kind == .star || kind == .slash { return prec_factor }
	if kind == .tilde { return prec_unary }
	if kind == .dot || kind == .bang || kind == .question_mark || kind == .left_bracket { return prec_call }
	if kind == .left_brace || kind == .keyword_enum || kind == .keyword_struct || kind == .keyword_extend || kind == .keyword_protocol { return prec_call }
	if kind == .keyword_if || kind == .keyword_match || kind == .effect_name || kind == .attribute || kind == .hash || kind == .at_sign { return prec_primary }
	if kind == .int_number || kind == .float_number || kind == .string_literal || kind == .character_literal { return prec_primary }
	if kind == .keyword_import || kind == .keyword_use || kind == .keyword_unreachable { return prec_primary }
	if kind == .left_paren || kind == .keyword_func || kind == .keyword_let { return prec_assignment }
	prec_none
}

// Whether a token can begin an expression (the reference handler
// table's prefix column). A token with no prefix leaves the Pratt loop
// without a left-hand side, which is its own error shape.
func has_prefix(kind: TokenKind) -> Bool {
	if kind == .int_number || kind == .float_number || kind == .string_literal || kind == .character_literal { return true }
	if kind == .keyword_true || kind == .keyword_false || kind == .identifier { return true }
	if kind == .minus || kind == .bang || kind == .tilde || kind == .dot { return true }
	if kind == .left_paren || kind == .left_brace || kind == .left_bracket { return true }
	if kind == .keyword_if || kind == .keyword_match || kind == .keyword_func || kind == .keyword_unreachable { return true }
	if kind == .effect_name || kind == .attribute || kind == .hash || kind == .bound_var { return true }
	false
}

// Whether a token has an infix handler at all: a token can out-rank the
// context (`prec_primary` literals) yet never continue an expression.
func has_infix(kind: TokenKind) -> Bool {
	if kind == .plus || kind == .minus || kind == .star || kind == .slash { return true }
	if kind == .less || kind == .less_equals || kind == .greater || kind == .greater_equals { return true }
	if kind == .equals_equals || kind == .bang_equals { return true }
	if kind == .caret || kind == .pipe || kind == .pipe_pipe || kind == .amp || kind == .amp_amp { return true }
	if kind == .less_less || kind == .greater_greater { return true }
	if kind == .dot_dot || kind == .dot_dot_less { return true }
	if kind == .dot || kind == .bang || kind == .question_mark || kind == .left_bracket { return true }
	false
}

// Root dispatch (the reference `next_root`): these keywords start a
// declaration; everything else is a statement.
func is_decl_keyword(kind: TokenKind) -> Bool {
	if kind == .keyword_protocol || kind == .keyword_struct || kind == .keyword_enum { return true }
	if kind == .keyword_let || kind == .keyword_func || kind == .keyword_mut { return true }
	if kind == .keyword_consuming || kind == .keyword_case || kind == .keyword_extend { return true }
	if kind == .keyword_typealias || kind == .keyword_effect || kind == .keyword_use { return true }
	if kind == .keyword_pub || kind == .keyword_public || kind == .keyword_linear || kind == .keyword_macro { return true }
	false
}

func dummy_expr() -> Expr {
	Expr(kind: .literal_true, start: 0, end: 0)
}

// Dotted-path segments joined with ".".
func join_path(segments: &[String]) -> String {
	let buf: [Byte] = []
	let i = 0
	loop i < segments.count {
		if i > 0 { append(buf: buf, text: ".") }
		append(buf: buf, text: segments[i])
		i = i + 1
	}
	String.from_bytes(bytes: buf)
}

// A decimal integer, or none when any byte is not a digit.
func parse_decimal(text: String) -> Int? {
	let bytes = text.utf8()
	let n = bytes.count()
	if n == 0 { return .none }
	let value = 0
	let i = 0
	loop i < n {
		let b = bytes.at(index: i)._toInt()
		if b < 48 || b > 57 { return .none } // outside "0"–"9"
		value = value * 10 + (b - 48)
		i = i + 1
	}
	.some(value)
}

func dummy_pattern() -> Pattern {
	Pattern(kind: .wildcard, start: 0, end: 0, meta_start: 0 - 1, meta_end: 0 - 1)
}

func dummy_stmt() -> Stmt {
	Stmt(kind: .expr_stmt(dummy_expr()), start: 0, end: 0)
}

func dummy_static_expr() -> StaticExpr {
	StaticExpr(kind: .int_literal("0"), start: 0, end: 0)
}

func static_op_node(op: StaticOpKind, consume lhs: StaticExpr, consume rhs: StaticExpr, end: Int) -> StaticExpr {
	let start = lhs.start
	StaticExpr(kind: .static_op(op, [lhs, rhs]), start: start, end: end)
}

func dummy_decl_kind() -> DeclKind {
	.let_decl(dummy_pattern(), .none, .none)
}

func dummy_decl() -> Decl {
	Decl(kind: dummy_decl_kind(), is_public: false, start: 0, end: 0)
}

func dummy_generic_decl() -> GenericDecl {
	let no_generics: [GenericDecl] = []
	let no_conformances: [TypeAnnotation] = []
	let no_default: GenericArg? = .none
	let no_static_ty: TypeAnnotation? = .none
	GenericDecl(name: "", name_start: -1, name_end: -1, generics: no_generics, conformances: no_conformances, default_value: no_default, static_ty: no_static_ty, start: 0, end: 0)
}

func dummy_predicate() -> WherePredicate {
	WherePredicate(kind: .type_eq(.type_arg(dummy_type()), .type_arg(dummy_type())), start: 0, end: 0)
}

// A macro parameter must be identifier-shaped: its first byte may not
// be a digit (the reference checks `is_alphabetic || '_'`).
// The reference checks `char::is_uppercase` on the first character;
// ASCII suffices for the static-parameter names the grammar admits.
func starts_uppercase(name: String) -> Bool {
	let bytes = name.utf8()
	if bytes.count() == 0 { return false }
	let b = bytes.at(index: 0)._toInt()
	b >= 65 && b <= 90
}

func macro_param_is_identifier_shaped(name: String) -> Bool {
	let bytes = name.utf8()
	if bytes.count() == 0 { return false }
	let b = bytes.at(index: 0)._toInt()
	if b >= 48 && b <= 57 { return false }
	true
}

func dummy_type() -> TypeAnnotation {
	TypeAnnotation(kind: .nominal("", -1, -1, []), start: 0, end: 0)
}

func dummy_block() -> Block {
	let no_params: [Parameter] = []
	let no_body: [Item] = []
	Block(params: no_params, body: no_body, start: 0, end: 0, copied: false)
}

// The reference span for synthesized nodes (desugared conditionals).
func synthesized_block(consume body: [Item]) -> Block {
	let no_params: [Parameter] = []
	Block(params: no_params, body: body, start: 0 - 1, end: 0 - 1, copied: false)
}

// The reference deep-copies blocks with freshened node ids when a
// multi-clause `if` duplicates its else block; spans are unchanged, so
// a value copy is the same tree.
func copy_block(block: &Block) -> Block {
	Block(params: block.params, body: block.body, start: block.start, end: block.end, copied: true)
}

func copy_optional_block(block: &Block?) -> Block? {
	if let .some(b) = block { return .some(copy_block(block: b)) }
	.none
}

// Does the pattern contain alternatives anywhere? Or-pattern lets
// desugar to a single-arm match (see `desugar_let_else`).
func pattern_contains_or(pattern: &Pattern) -> Bool {
	match pattern.kind {
		.or_pattern(_) -> true,
		.tuple(items) -> any_pattern_contains_or(patterns: items),
		.variant(_, _, _, _, _, fields, _) -> any_pattern_contains_or(patterns: fields),
		.record(fields) -> {
			for field in fields {
				if let .equals_field(_, _, _, value) = field.kind {
					if pattern_contains_or(pattern: value) { return true }
				}
			}
			false
		},
		.struct_pattern(_, _, fields, _, _) -> any_pattern_contains_or(patterns: fields),
		_ -> false
	}
}

func any_pattern_contains_or(patterns: &[Pattern]) -> Bool {
	for p in patterns {
		if pattern_contains_or(pattern: p) { return true }
	}
	false
}

// Binder names in declaration order (the reference
// `collect_pattern_binder_names`); or-patterns contribute the first
// alternative's binders only.
func collect_pattern_binders(pattern: &Pattern, mut names: [String]) -> Void {
	match pattern.kind {
		.bind(name) -> names.push(name),
		.tuple(items) -> collect_all_pattern_binders(patterns: items, names: names),
		.variant(_, _, _, _, _, fields, _) -> collect_all_pattern_binders(patterns: fields, names: names),
		.or_pattern(items) -> {
			if items.count > 0 {
				collect_pattern_binders(pattern: items[0], names: names)
			}
		},
		.record(fields) -> {
			for field in fields {
				match field.kind {
					.bind_field(name) -> names.push(name),
					.equals_field(_, _, _, value) -> collect_pattern_binders(pattern: value, names: names),
					.rest_field -> {}
				}
			}
		},
		.struct_pattern(_, _, fields, _, _) -> collect_all_pattern_binders(patterns: fields, names: names),
		_ -> {}
	}
}

func collect_all_pattern_binders(patterns: &[Pattern], mut names: [String]) -> Void {
	for p in patterns {
		collect_pattern_binders(pattern: p, names: names)
	}
}

// Desugars `let PAT = EXPR else { BODY }` into a synthesized match (the
// reference `desugar_let_else`); or-pattern lets take the same road
// with no else arm:
// - 0 binders: `let _ = match EXPR { PAT -> (), _ -> BODY }`
// - 1 binder:  `let x = match EXPR { PAT -> x, _ -> BODY }`
// - N binders: `let (a, b) = match EXPR { PAT -> (a, b), _ -> BODY }`
func desugar_let_else(consume pattern: Pattern, consume annotation: TypeAnnotation?, consume rhs: Expr?, consume else_body: Block?, start: Int, end: Int) -> Decl {
	let no_items: [Expr] = []
	let scrutinee = Expr(kind: .tuple(no_items), start: 0 - 1, end: 0 - 1)
	if let .some(r) = rhs { scrutinee = r }
	// A `let pattern: T = …` annotation pins the scrutinee.
	if let .some(a) = annotation {
		scrutinee = Expr(kind: .as_cast([scrutinee], a), start: 0 - 1, end: 0 - 1)
	}
	let names: [String] = []
	collect_pattern_binders(pattern: pattern, names: names)

	let empty_items: [Expr] = []
	let success_expr = Expr(kind: .tuple(empty_items), start: 0 - 1, end: 0 - 1)
	if names.count == 1 {
		success_expr = Expr(kind: .variable(names[0]), start: 0 - 1, end: 0 - 1)
	}
	if names.count > 1 {
		let variables: [Expr] = []
		for name in names {
			variables.push(Expr(kind: .variable(name), start: 0 - 1, end: 0 - 1))
		}
		success_expr = Expr(kind: .tuple(variables), start: 0 - 1, end: 0 - 1)
	}
	let success_items: [Item] = [.expr_item(success_expr)]
	let arms: [MatchArm] = [MatchArm(pattern: pattern, body: synthesized_block(body: success_items), start: 0 - 1, end: 0 - 1)]
	// With an else, a miss runs it (let-else); without one (or-pattern
	// lets), a miss is the match machinery's miss.
	if let .some(eb) = else_body {
		let wildcard = Pattern(kind: .wildcard, start: 0 - 1, end: 0 - 1, meta_start: 0 - 1, meta_end: 0 - 1)
		arms.push(MatchArm(pattern: wildcard, body: eb, start: 0 - 1, end: 0 - 1))
	}
	let match_expr = Expr(kind: .match_expr([scrutinee], arms), start: 0 - 1, end: 0 - 1)

	let outer = Pattern(kind: .wildcard, start: 0 - 1, end: 0 - 1, meta_start: 0 - 1, meta_end: 0 - 1)
	if names.count == 1 {
		outer = Pattern(kind: .bind(names[0]), start: 0 - 1, end: 0 - 1, meta_start: 0 - 1, meta_end: 0 - 1)
	}
	if names.count > 1 {
		let binds: [Pattern] = []
		for name in names {
			binds.push(Pattern(kind: .bind(name), start: 0 - 1, end: 0 - 1, meta_start: 0 - 1, meta_end: 0 - 1))
		}
		outer = Pattern(kind: .tuple(binds), start: 0 - 1, end: 0 - 1, meta_start: 0 - 1, meta_end: 0 - 1)
	}
	let no_annotation: TypeAnnotation? = .none
	Decl(kind: .let_decl(outer, no_annotation, .some(match_expr)), is_public: false, start: start, end: end)
}

// One folded conditional layer (`build_conditional_expr`'s body): a
// boolean clause becomes an if expression, a let clause a two-arm match.
func clause_expr(consume clause: ConditionalClause, consume success: Block, consume failure: Block, start: Int, end: Int) -> Expr {
	match clause {
		.boolean(cond) -> {
			let cond_arr: [Expr] = [cond]
			return Expr(kind: .if_expr(cond_arr, success, failure), start: start, end: end)
		},
		.let_clause(pat, scrutinee) -> {
			let wildcard = Pattern(kind: .wildcard, start: 0 - 1, end: 0 - 1, meta_start: 0 - 1, meta_end: 0 - 1)
			let arms: [MatchArm] = [
				MatchArm(pattern: pat, body: success, start: 0 - 1, end: 0 - 1),
				MatchArm(pattern: wildcard, body: failure, start: 0 - 1, end: 0 - 1)
			]
			let scrutinee_arr: [Expr] = [scrutinee]
			return Expr(kind: .match_expr(scrutinee_arr, arms), start: start, end: end)
		}
	}
}

func decl_is_import(decl: &Decl) -> Bool {
	if let .import_decl(_) = decl.kind { return true }
	false
}

func item_is_import(item: &Item) -> Bool {
	match item {
		.decl_item(decl) -> decl_is_import(decl: decl),
		.stmt_item(_) -> false,
		.expr_item(_) -> false,
		.pattern_item(_) -> false,
		.type_item(_) -> false
	}
}

func mode_keyword(mode: &TypeParamMode) -> String {
	match mode {
		.unadorned -> "",
		.mut_mode -> "mut",
		.consume_mode -> "consume",
		.consume_mut_mode -> "consume mut"
	}
}

func is_borrow_annotation(annotation: &TypeAnnotation) -> Bool {
	match annotation.kind {
		.quantified_type(_, _, _) -> false,
		.borrow(_, _) -> true,
		.unique(_) -> false,
		.func_type(_, _, _) -> false,
		.nominal_path(_, _, _, _, _) -> false,
		.nominal(_, _, _, _) -> false,
		.tuple(_) -> false,
		.record_type(_) -> false,
		.any_type(_, _) -> false,
		.macro_call_type(_, _, _, _, _, _) -> false
	}
}

func macro_argument_expr(source: String, consume tokens: [Token]) -> Expr? {
	if tokens.count == 0 { return .none }
	let input = TokenRange(
		tokens: tokens,
		span: tokens[0].span.lower..<tokens[tokens.count - 1].span.upper
	)
	let outcome = parse_expr_tokens(source: source.clone(), input: input)
	if let .some(_) = outcome.failure { return .none }
	if outcome.items.count != 1 { return .none }
	for item in outcome.items {
		match item {
			.expr_item(expr) -> return .some(expr),
			_ -> return .none
		}
	}
	.none
}

func string_array_contains(items: &[String], candidate: String) -> Bool {
	for item in items {
		if item == candidate { return true }
	}
	false
}

func macro_expression_arguments(source: String, consume tokens: [Token]) -> [Expr]? {
	if tokens.count == 0 { return .some([]) }
	let args: [Expr] = []
	let segment: [Token] = []
	let depth = 0
	for token in tokens {
		if token.kind == .left_paren || token.kind == .left_bracket || token.kind == .left_brace {
			depth = depth + 1
		}
		if token.kind == .comma && depth == 0 {
			if segment.count == 0 { return .none }
			if let .some(expr) = macro_argument_expr(source: source, tokens: segment) {
				args.push(expr)
			} else { return .none }
			segment = []
			continue
		}
		segment.push(Token(kind: token.kind, span: token.span.lower..<token.span.upper, lexeme: token.lexeme.lower..<token.lexeme.upper))
		if token.kind == .right_paren || token.kind == .right_bracket || token.kind == .right_brace {
			depth = depth - 1
		}
	}
	if segment.count > 0 {
		if let .some(expr) = macro_argument_expr(source: source, tokens: segment) {
			args.push(expr)
		} else { return .none }
	}
	.some(args)
}

struct Parser {
	let tokens: [Token]
	let token_count: Int
	let source: String
	// The source extent owned by this parse. Token-range parses retain
	// original byte offsets and place synthetic EOF at this range's end.
	let input_span: Range<Int>
	let pos: Int
	// A `>>` closing nested generics is split: when set, `current()`
	// synthesizes the second `>` in place (the reference replaces its
	// current token; here the token list is immutable).
	let split_greater: Bool
	let failed: Fail?
	let diags: [Fail]
	let items: [Item]
	// The trailing-block context stack (the reference `context_stack`).
	let contexts: [ParseContext]
	// An assignment parsed inside the expression grammar (the reference
	// returns `Node::Stmt` there): at most one, claimed by the statement
	// layer or rejected by `require_expr`.
	let assign_slot: [Stmt]
	// In where-predicate operands `<` doubles as the static comparison
	// operator (ADR 0035): when set, a generic-argument list must sit
	// adjacent to its head name.
	let angle_adjacency: Bool
	// A scan failure (pre-rendered `Lex error at …`): the token list is
	// truncated at the failure, and the reference reports the lex error
	// instead of any downstream missing-token symptom.
	let lex_error_message: String?
	// The reference push_identifier log (ADR 0043 option A): identifier
	// tokens in consumption order, recorded at the reference's three
	// ports (identifier consumption and identifier-kinded consumes).
	let id_log: [Token]
	// Parallel to id_log: entries pushed during a rolled-back block-args
	// probe. The reference leaves them in the BLOCK's frame (the probe
	// runs before any statement frame opens), so only blocks claim them.
	let id_log_probe: [Bool]

	// MARK: Token stream

	func token_at(index: Int) -> Token {
		if index >= 0 && index < self.token_count {
			let t = self.tokens[index]
			return Token(kind: t.kind, span: t.span, lexeme: t.lexeme)
		}
		Token(kind: .eof, span: self.input_span.upper..<self.input_span.upper, lexeme: self.input_span.upper..<self.input_span.upper)
	}

	func current() -> Token {
		if self.split_greater {
			let t = self.token_at(index: self.pos)
			return Token(kind: .greater, span: (t.span.lower + 1)..<t.span.upper, lexeme: (t.lexeme.lower + 1)..<t.lexeme.upper)
		}
		self.token_at(index: self.pos)
	}

	func next_kind() -> TokenKind {
		self.token_at(index: self.pos + 1).kind
	}

	mut func advance() -> Void {
		self.split_greater = false
		self.pos = self.pos + 1
	}

	// Consumes the `>` closing a generic list; a `>>` splits back into
	// two `>` so nested generics like `Set<Set<Int>>` parse.
	mut func did_match_generic_close() -> Bool {
		self.skip_newlines()
		let k = self.current().kind
		if k == .greater {
			self.advance()
			return true
		}
		if k == .greater_greater {
			self.split_greater = true
			return true
		}
		false
	}

	func peek_is(kind: TokenKind) -> Bool {
		self.current().kind == kind
	}

	func prev_was_newline() -> Bool {
		if self.pos == 0 { return false }
		self.token_at(index: self.pos - 1).kind == .newline
	}

	// The reference previous-before-newline cursor: the end of the last
	// non-newline token already consumed (the EOF sentinel counts once
	// the stream has advanced past the end).
	func span_end() -> Int {
		if self.pos - 1 >= self.token_count { return self.input_span.upper }
		let i = self.pos - 1
		loop i >= 0 {
			let t = self.tokens[i]
			if t.kind == .newline {
				i = i - 1
			} else {
				return t.span.upper
			}
		}
		if self.pos > 0 { return self.token_at(index: self.pos - 1).span.upper }
		self.input_span.lower
	}

	func lexeme(token: Token) -> String {
		self.slice_text(start: token.lexeme.lower, end: token.lexeme.upper)
	}

	func slice_text(start: Int, end: Int) -> String {
		let view = self.source.utf8()
		let buf: [Byte] = []
		let i = start
		loop i < end {
			buf.push(view.at(index: i))
			i = i + 1
		}
		String.from_bytes(bytes: buf)
	}

	// MARK: Failure

	func is_failed() -> Bool {
		if let .some(_) = self.failed { return true }
		false
	}

	mut func fail(code: String, message: String) -> Void {
		let no_expected: TokenKind? = .none
		self.fail_full(code: code, message: message, start: -1, end: -1, expected: no_expected)
	}

	// A positioned failure (editor ranges and quick fixes read it).
	mut func fail_at(code: String, message: String, start: Int, end: Int) -> Void {
		let no_expected: TokenKind? = .none
		self.fail_full(code: code, message: message, start: start, end: end, expected: no_expected)
	}

	mut func fail_full(code: String, message: String, start: Int, end: Int, expected: TokenKind?) -> Void {
		if self.is_failed() { return () }
		self.failed = .some(Fail(code: code, message: message, start: start, end: end, expected: expected))
	}

	mut func fail_expected(kind: TokenKind) -> Void {
		let cur = self.current()
		self.fail_full(code: "parser.unexpected-token", message: self.expected_message(kind: kind), start: cur.span.lower, end: cur.span.upper, expected: .some(kind))
	}

	mut func record_expected(kind: TokenKind) -> Void {
		let cur = self.current()
		self.diags.push(Fail(code: "parser.unexpected-token", message: self.expected_message(kind: kind), start: cur.span.lower, end: cur.span.upper, expected: .some(kind)))
	}

	func expected_message(kind: TokenKind) -> String {
		"Unexpected token: expected `" + kind_spelling(kind: kind) + "`, got " + describe_kind(kind: self.current().kind)
	}

	// MARK: Trivia

	mut func skip_newlines() -> Void {
		loop self.peek_is(kind: .newline) {
			self.advance()
		}
	}

	mut func skip_semicolons_and_newlines() -> Void {
		loop self.peek_is(kind: .semicolon) || self.peek_is(kind: .newline) {
			self.advance()
		}
	}

	// A single line break may continue an expression; a blank line is a
	// statement boundary.
	mut func skip_continuation_newlines() -> Void {
		loop self.peek_is(kind: .newline) && self.at_blank_line() == false {
			self.advance()
		}
	}

	mut func skip_semicolons_and_continuation_newlines() -> Void {
		loop self.peek_is(kind: .semicolon) || (self.peek_is(kind: .newline) && self.at_blank_line() == false) {
			self.advance()
		}
	}

	func at_blank_line() -> Bool {
		let cur = self.current()
		if cur.kind == .newline { } else { return false }
		let view = self.source.utf8()
		let newlines = 0
		let i = cur.span.lower
		loop i < cur.span.upper {
			if view.at(index: i)._toInt() == blank_newline_byte {
				newlines = newlines + 1
			}
			i = i + 1
		}
		if newlines > 1 { return true }
		let nxt = self.token_at(index: self.pos + 1)
		if nxt.kind == .newline { } else { return false }
		let j = cur.span.upper
		loop j < nxt.span.lower {
			let b = view.at(index: j)._toInt()
			if b == blank_space_byte || b == blank_tab_byte || b == blank_return_byte || b == blank_newline_byte { } else {
				return false
			}
			j = j + 1
		}
		true
	}

	// MARK: Matching

	mut func did_match(kind: TokenKind) -> Bool {
		self.skip_newlines()
		if self.peek_is(kind: kind) {
			self.advance()
			return true
		}
		false
	}

	mut func consume(kind: TokenKind) -> Token {
		self.skip_newlines()
		let cur = self.current()
		if cur.kind == kind {
			if cur.kind == .identifier {
				self.id_log.push(cur)
				self.id_log_probe.push(false)
			}
			self.advance()
			return cur
		}
		self.fail_expected(kind: kind)
		cur
	}

	func at_delimiter_recovery_boundary() -> Bool {
		let k = self.current().kind
		k == .right_brace || k == .right_paren || k == .right_bracket || k == .eof
	}

	mut func consume_or_recover_closer(kind: TokenKind) -> Void {
		self.skip_newlines()
		if self.peek_is(kind: kind) {
			self.advance()
			return ()
		}
		if self.at_delimiter_recovery_boundary() {
			self.record_expected(kind: kind)
			return ()
		}
		self.fail_expected(kind: kind)
	}

	mut func consume_or_recover_closer_after_newline(kind: TokenKind) -> Void {
		self.skip_newlines()
		if self.peek_is(kind: kind) {
			self.advance()
			return ()
		}
		if self.at_delimiter_recovery_boundary() || self.prev_was_newline() {
			self.record_expected(kind: kind)
			return ()
		}
		self.fail_expected(kind: kind)
	}

	mut func identifier() -> String {
		self.skip_semicolons_and_newlines()
		let cur = self.current()
		if cur.kind == .identifier || cur.kind == .keyword_use {
			self.id_log.push(cur)
			self.id_log_probe.push(false)
			self.advance()
			return self.lexeme(token: cur)
		}
		self.fail_at(code: "parser.expected-identifier", message: "Expected an identifier, got " + describe_kind(kind: cur.kind), start: cur.span.lower, end: cur.span.upper)
		""
	}

	// `identifier()` exposing the consumed token, for name-span capture.
	// On failure the returned token is the offending one; callers bail
	// on is_failed before using it.
	mut func identifier_token() -> Token {
		self.skip_semicolons_and_newlines()
		let cur = self.current()
		if cur.kind == .identifier || cur.kind == .keyword_use {
			self.id_log.push(cur)
			self.id_log_probe.push(false)
			self.advance()
			return cur
		}
		self.fail_at(code: "parser.expected-identifier", message: "Expected an identifier, got " + describe_kind(kind: cur.kind), start: cur.span.lower, end: cur.span.upper)
		cur
	}

	// MARK: Contexts and assignment plumbing

	func allows_trailing_blocks() -> Bool {
		let n = self.contexts.count
		if n == 0 { return true }
		context_is_top_level(context: self.contexts[n - 1])
	}

	func has_pending_assign() -> Bool {
		self.assign_slot.count > 0
	}

	mut func fail_cannot_assign() -> Void {
		self.fail(code: "parser.cannot-assign", message: "Cannot assign in this context")
	}

	// The reference `into_expr`: a node that parsed as an assignment
	// statement cannot stand where an expression is required.
	mut func require_expr(consume e: Expr) -> Expr {
		if self.has_pending_assign() {
			let _ = self.assign_slot.pop()
			self.fail_cannot_assign()
		}
		e
	}

	// A control-flow condition: trailing-block calls are disabled (the
	// following `{` belongs to the construct's body) and an assignment
	// is rejected — a condition must be an expression.
	mut func condition(ctx: ParseContext) -> Expr {
		self.contexts.push(ctx)
		let e = self.expr()
		let _ = self.contexts.pop()
		self.require_expr(e: e)
	}

	// MARK: Expressions

	mut func expr() -> Expr {
		self.expr_with_precedence(prec: prec_assignment)
	}

	mut func expr_with_precedence(prec: Int) -> Expr {
		self.skip_newlines()
		if self.is_failed() { return dummy_expr() }
		let can_assign = prec <= prec_assignment
		if has_prefix(kind: self.current().kind) == false {
			// The current token cannot begin an expression; error here
			// rather than letting the infix loop discover it can never
			// make progress.
			let cur = self.current()
			self.advance()
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected an expression, got " + describe_kind(kind: cur.kind))
			return dummy_expr()
		}
		let lhs = self.prefix(can_assign: can_assign)
		if self.is_failed() { return dummy_expr() }
		let i = 0
		loop true {
			self.skip_continuation_newlines()
			let kind = self.current().kind
			if prec < infix_precedence(kind: kind) { } else { break }
			if has_infix(kind: kind) == false { break }
			if self.has_pending_assign() {
				// The reference feeds the assignment statement to the next
				// infix handler's `into_expr`, which rejects it.
				let _ = self.assign_slot.pop()
				self.fail_cannot_assign()
				return dummy_expr()
			}
			i = i + 1
			lhs = self.infix(can_assign: can_assign, lhs: lhs)
			if self.is_failed() { return dummy_expr() }
			if self.did_match(kind: .newline) { break }
			if i > 100 {
				self.advance()
				self.fail(code: "parser.infinite-loop", message: "Parser failed to make forward progress at " + describe_kind(kind: self.current().kind))
				return dummy_expr()
			}
		}
		self.check_as(lhs: lhs)
	}

	mut func check_as(lhs: Expr) -> Expr {
		if self.did_match(kind: .keyword_as) {
			if self.has_pending_assign() {
				let _ = self.assign_slot.pop()
				self.fail_cannot_assign()
				return lhs
			}
			let start = lhs.start
			let annotation = self.type_annotation()
			if self.is_failed() { return dummy_expr() }
			return Expr(kind: .as_cast([lhs], annotation), start: start, end: self.span_end())
		}
		lhs
	}

	mut func prefix(can_assign: Bool) -> Expr {
		let k = self.current().kind
		if k == .int_number || k == .float_number || k == .string_literal || k == .character_literal { return self.literal() }
		if k == .keyword_true || k == .keyword_false { return self.literal() }
		if k == .identifier && self.lexeme(token: self.current()) == "quote" && self.next_kind() == .left_brace { return self.syntax_quote() }
		if k == .identifier { return self.variable(can_assign: can_assign) }
		if k == .minus || k == .bang || k == .tilde { return self.unary() }
		if k == .dot { return self.member_prefix(can_assign: can_assign) }
		if k == .left_paren { return self.tuple() }
		if k == .left_brace { return self.block_expr() }
		if k == .left_bracket { return self.array_literal() }
		if k == .keyword_if { return self.if_expr_prefix() }
		if k == .keyword_match { return self.match_expr_prefix() }
		if k == .keyword_func { return self.func_expr_prefix() }
		if k == .attribute { return self.macro_call() }
		if k == .bound_var { return self.bound_var_expr() }
		if k == .effect_name { return self.effect_callee() }
		if k == .keyword_unreachable { return self.unreachable_prefix() }
		if k == .hash { return self.compiler_prefix() }
		// Unreachable while has_prefix stays in sync with the arms above;
		// fail like the caller's gate if they ever drift.
		self.advance()
		self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected an expression, got " + describe_kind(kind: k))
		dummy_expr()
	}

	mut func unreachable_prefix() -> Expr {
		let tok = self.current()
		self.advance()
		Expr(kind: .unreachable_expr, start: tok.span.lower, end: self.span_end())
	}

	// Capture the balanced delimiter group following an @macro name. Returns
	// the input's source extent and the canonical tokens, outer delimiters
	// included. Shared by every invocation position (expression, declaration,
	// pattern, type): the category that parses the substituted expansion
	// decides what the tokens mean.
	mut func macro_input_capture() -> (Int, Int, [MacroToken], [Token]) {
		let open = self.current()
		let outer_close: TokenKind
		match open.kind {
			.left_paren -> outer_close = .right_paren,
			.left_bracket -> outer_close = .right_bracket,
			.left_brace -> outer_close = .right_brace,
			_ -> {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a macro delimiter, got " + describe_kind(kind: open.kind))
				return (0, 0, [], [])
			}
		}
		self.advance()
		let expected: [TokenKind] = [outer_close]
		let inner: [Token] = []
		let close = open
		loop expected.count > 0 {
			let token = self.current()
			if token.kind == .eof {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a closing macro delimiter, got end of input")
				return (0, 0, [], [])
			}
			let nested_close: TokenKind?
			match token.kind {
				.left_paren -> nested_close = .some(.right_paren),
				.left_bracket -> nested_close = .some(.right_bracket),
				.left_brace -> nested_close = .some(.right_brace),
				_ -> nested_close = .none
			}
			if let .some(kind) = nested_close {
				expected.push(kind)
				inner.push(token)
				self.advance()
				continue
			}
			if token.kind == .right_paren || token.kind == .right_bracket || token.kind == .right_brace {
				let wanted = expected.pop()
				if let .some(kind) = wanted {
					if token.kind != kind {
						self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected " + describe_kind(kind: kind) + ", got " + describe_kind(kind: token.kind))
						return (0, 0, [], [])
					}
				}
				close = token
				self.advance()
				if expected.count == 0 { break }
				inner.push(token)
				continue
			}
			inner.push(token)
			self.advance()
		}

		let canonical: [MacroToken] = [macro_token(token: open)]
		for token in inner { canonical.push(macro_token(token: token)) }
		canonical.push(macro_token(token: close))
		return (open.span.lower, close.span.upper, canonical, inner)
	}

	// An @macro invocation in declaration position.
	mut func macro_call_decl() -> Decl {
		let name_tok = self.current()
		let name = self.lexeme(token: name_tok)
		self.consume(kind: .attribute)
		if self.is_failed() { return dummy_decl() }
		let (input_start, input_end, canonical, inner) = self.macro_input_capture()
		if self.is_failed() { return dummy_decl() }
		let args: [Expr] = []
		if canonical[0].kind == .left_paren {
			let parsed = macro_expression_arguments(source: self.source, tokens: inner)
			if let .some(values) = parsed { args = values }
		}
		Decl(kind: .macro_call_decl(name, name_tok.lexeme.lower, name_tok.lexeme.upper, input_start, input_end, canonical, args), is_public: false, start: name_tok.span.lower, end: self.span_end())
	}

	// An @macro invocation in pattern position.
	mut func macro_call_pattern() -> Pattern {
		let name_tok = self.current()
		let name = self.lexeme(token: name_tok)
		self.consume(kind: .attribute)
		if self.is_failed() { return dummy_pattern() }
		let (input_start, input_end, canonical, _) = self.macro_input_capture()
		if self.is_failed() { return dummy_pattern() }
		Pattern(kind: .macro_call_pattern(name, name_tok.lexeme.lower, name_tok.lexeme.upper, input_start, input_end, canonical), start: name_tok.span.lower, end: self.span_end(), meta_start: 0 - 1, meta_end: 0 - 1)
	}

	// An @macro invocation in type position.
	mut func macro_call_type() -> TypeAnnotation {
		let name_tok = self.current()
		let name = self.lexeme(token: name_tok)
		self.consume(kind: .attribute)
		if self.is_failed() { return dummy_type() }
		let (input_start, input_end, canonical, _) = self.macro_input_capture()
		if self.is_failed() { return dummy_type() }
		TypeAnnotation(kind: .macro_call_type(name, name_tok.lexeme.lower, name_tok.lexeme.upper, input_start, input_end, canonical), start: name_tok.span.lower, end: self.span_end())
	}

	// An @macro owns one arbitrary balanced token tree. Parenthesized trees that
	// are also ordinary comma-separated Talk expressions retain their parsed
	// arguments for the legacy declarative expander.
	mut func macro_call() -> Expr {
		let name_tok = self.current()
		let name = self.lexeme(token: name_tok)
		self.consume(kind: .attribute)
		if self.is_failed() { return dummy_expr() }
		let (input_start, input_end, canonical, inner) = self.macro_input_capture()
		if self.is_failed() { return dummy_expr() }
		let args: [Expr] = []
		if canonical[0].kind == .left_paren {
			let parsed = macro_expression_arguments(source: self.source, tokens: inner)
			if let .some(values) = parsed { args = values }
		}
		Expr(
			kind: .macro_call(name, name_tok.lexeme.lower, name_tok.lexeme.upper, input_start, input_end, canonical, args),
			start: name_tok.span.lower,
			end: self.span_end()
		)
	}

	// Opaque expression quotation for procedural macro units. Canonical tokens
	// are retained in the AST so lowering can embed them without re-lexing.
	mut func syntax_quote() -> Expr {
		let start = self.current()
		self.advance()
		let open = self.current()
		self.consume(kind: .left_brace)
		if self.is_failed() { return dummy_expr() }
		let expected: [TokenKind] = [.right_brace]
		let inner: [Token] = []
		let close = open
		loop expected.count > 0 {
			let token = self.current()
			if token.kind == .eof {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a closing quotation delimiter, got end of input")
				return dummy_expr()
			}
			let nested_close: TokenKind?
			match token.kind {
				.left_paren -> nested_close = .some(.right_paren),
				.left_bracket -> nested_close = .some(.right_bracket),
				.left_brace -> nested_close = .some(.right_brace),
				_ -> nested_close = .none
			}
			if let .some(kind) = nested_close {
				expected.push(kind)
				inner.push(token)
				self.advance()
				continue
			}
			if token.kind == .right_paren || token.kind == .right_bracket || token.kind == .right_brace {
				let wanted = expected.pop()
				if let .some(kind) = wanted {
					if token.kind != kind {
						self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected " + describe_kind(kind: kind) + ", got " + describe_kind(kind: token.kind))
						return dummy_expr()
					}
				}
				close = token
				self.advance()
				if expected.count == 0 { break }
				inner.push(token)
				continue
			}
			inner.push(token)
			self.advance()
		}
		let canonical: [MacroToken] = [macro_token(token: open)]
		let splices: [String] = []
		for token in inner {
			canonical.push(macro_token(token: token))
			if token.kind == .bound_var {
				let name = self.source.utf8().slice(start: token.lexeme.lower, byte_count: token.lexeme.upper - token.lexeme.lower).to_string()
				let first = name.utf8().at(index: 0)._toInt()
				if (first < 48 || first > 57) && string_array_contains(items: splices, candidate: name) == false {
					splices.push(name)
				}
			}
		}
		canonical.push(macro_token(token: close))
		Expr(kind: .syntax_quote(self.source.clone(), canonical, splices), start: start.span.lower, end: self.span_end())
	}

	// `'effect(args)`: an effect call. The node's span includes the sigil;
	// the recorded effect-name span uses the token's lexeme.
	mut func effect_callee() -> Expr {
		let tok = self.current()
		self.advance()
		let name = self.lexeme(token: tok)
		let type_args: [GenericArg] = []
		if self.peek_is(kind: .less) {
			self.advance()
			type_args = self.generic_args_list()
			if self.is_failed() { return dummy_expr() }
		}
		self.consume(kind: .left_paren)
		if self.is_failed() { return dummy_expr() }
		let args: [CallArg] = []
		if self.did_match(kind: .right_paren) {
			// Empty argument list.
		} else {
			if self.at_delimiter_recovery_boundary() {
				self.record_expected(kind: .right_paren)
			} else {
				args = self.arguments()
				self.consume_or_recover_closer_after_newline(kind: .right_paren)
			}
		}
		Expr(kind: .call_effect(name, tok.lexeme.lower, tok.lexeme.upper, type_args, args), start: tok.span.lower, end: self.span_end())
	}

	// A macro-template binder (`$x`): a variable whose name and node span
	// keep the sigil.
	mut func bound_var_expr() -> Expr {
		let tok = self.current()
		self.advance()
		let name = "$" + self.lexeme(token: tok)
		Expr(kind: .variable(name), start: tok.span.lower, end: self.span_end())
	}

	mut func infix(can_assign: Bool, lhs: Expr) -> Expr {
		let k = self.current().kind
		if k == .dot { return self.member_infix(can_assign: can_assign, lhs: lhs) }
		if k == .bang { return self.force_unwrap(lhs: lhs) }
		if k == .question_mark { return self.propagate(lhs: lhs) }
		if k == .left_bracket { return self.subscript(can_assign: can_assign, lhs: lhs) }
		self.binary(lhs: lhs)
	}

	// Postfix `!`: the hidden failure expression starts as `unreachable`
	// spanning the bang; desugaring sends it to 'panic.
	mut func force_unwrap(lhs: Expr) -> Expr {
		let start = lhs.start
		let bang = self.current()
		self.advance()
		let failure = Expr(kind: .unreachable_expr, start: bang.span.lower, end: bang.span.upper)
		Expr(kind: .force_unwrap([lhs, failure]), start: start, end: self.span_end())
	}

	// Postfix `?` early propagation.
	mut func propagate(lhs: Expr) -> Expr {
		let start = lhs.start
		self.advance()
		Expr(kind: .propagate([lhs]), start: start, end: self.span_end())
	}

	mut func literal() -> Expr {
		let tok = self.current()
		self.advance()
		let k = tok.kind
		if k == .int_number {
			return Expr(kind: .literal_int(self.lexeme(token: tok)), start: tok.span.lower, end: self.span_end())
		}
		if k == .float_number {
			return Expr(kind: .literal_float(self.lexeme(token: tok)), start: tok.span.lower, end: self.span_end())
		}
		if k == .keyword_true {
			return Expr(kind: .literal_true, start: tok.span.lower, end: self.span_end())
		}
		if k == .keyword_false {
			return Expr(kind: .literal_false, start: tok.span.lower, end: self.span_end())
		}
		// String and character literals keep escapes, quotes stripped.
		let inner = self.slice_text(start: tok.span.lower + 1, end: tok.span.upper - 1)
		if k == .string_literal {
			return Expr(kind: .literal_string(inner), start: tok.span.lower, end: self.span_end())
		}
		Expr(kind: .literal_character(inner), start: tok.span.lower, end: self.span_end())
	}

	mut func unary() -> Expr {
		let op = self.current()
		self.advance()
		let sub_prec = if op.kind == .bang { prec_factor } else { infix_precedence(kind: op.kind) }
		let rhs = self.expr_with_precedence(prec: sub_prec)
		Expr(kind: .unary(op.kind, [rhs]), start: op.span.lower, end: self.span_end())
	}

	mut func binary(lhs: Expr) -> Expr {
		let start = lhs.start
		self.skip_semicolons_and_newlines()
		let op = self.current()
		self.advance()
		let rhs = self.expr_with_precedence(prec: infix_precedence(kind: op.kind))
		Expr(kind: .binary(op.kind, [lhs, rhs]), start: start, end: self.span_end())
	}

	mut func variable(can_assign: Bool) -> Expr {
		let start_tok = self.current()
		let name = self.identifier()
		loop self.did_match(kind: .double_colon) {
			name = name + "::" + self.identifier()
		}
		let var_expr = Expr(kind: .variable(name), start: start_tok.span.lower, end: self.span_end())
		self.skip_continuation_newlines()
		let (extended, did_call) = self.check_call(callee: var_expr, can_assign: can_assign)
		if did_call { return extended }
		if can_assign {
			if self.did_match(kind: .equals) {
				let rhs = self.require_expr(e: self.expr())
				if self.is_failed() { return dummy_expr() }
				let lhs_start = extended.start
				let parts: [Expr] = [extended, rhs]
				self.assign_slot.push(Stmt(kind: .assignment(parts), start: lhs_start, end: self.span_end()))
				return dummy_expr()
			}
		}
		extended
	}

	// MARK: Members

	// A leading-dot member (`.some`): no receiver; resolution supplies
	// the enum from context.
	mut func member_prefix(can_assign: Bool) -> Expr {
		let start_tok = self.current()
		self.consume(kind: .dot)
		let no_receiver: [Expr] = []
		let cur = self.current()
		if cur.kind == .identifier {
			let name_tok = self.identifier_token()
			let name = self.lexeme(token: name_tok)
			let member = Expr(kind: .member(.named(name), name_tok.lexeme.lower, name_tok.lexeme.upper, no_receiver), start: start_tok.span.lower, end: self.span_end())
			return self.member_postfix(member: member, can_assign: can_assign)
		}
		if cur.kind == .int_number {
			self.advance()
			let member = self.positional_member(receiver: no_receiver, start: start_tok.span.lower, token: cur)
			return self.member_postfix(member: member, can_assign: can_assign)
		}
		self.record_expected_identifier()
		Expr(kind: .incomplete_member(no_receiver), start: start_tok.span.lower, end: self.span_end())
	}

	mut func member_infix(can_assign: Bool, lhs: Expr) -> Expr {
		let start = lhs.start
		self.consume(kind: .dot)
		let cur = self.current()
		if cur.kind == .identifier {
			let name_tok = self.identifier_token()
			let name = self.lexeme(token: name_tok)
			let member = Expr(kind: .member(.named(name), name_tok.lexeme.lower, name_tok.lexeme.upper, [lhs]), start: start, end: self.span_end())
			return self.member_postfix(member: member, can_assign: can_assign)
		}
		if cur.kind == .int_number {
			self.advance()
			let receiver: [Expr] = [lhs]
			let member = self.positional_member(receiver: receiver, start: start, token: cur)
			return self.member_postfix(member: member, can_assign: can_assign)
		}
		if cur.kind == .float_number {
			// `x.0.1` lexes `0.1` as one float; the reference splits it
			// into two positional accesses, both spanning the chain.
			self.advance()
			let text = self.lexeme(token: cur)
			let bytes = text.utf8()
			let n = bytes.count()
			let dot_index = -1
			let j = 0
			loop j < n {
				if bytes.at(index: j)._toInt() == 46 { dot_index = j; break } // "."
				j = j + 1
			}
			if dot_index > 0 {
				let first = parse_decimal(text: self.slice_text(start: cur.span.lower, end: cur.span.lower + dot_index))
				let second = parse_decimal(text: self.slice_text(start: cur.span.lower + dot_index + 1, end: cur.span.upper))
				if let .some(first_value) = first {
					if let .some(second_value) = second {
						let inner = Expr(kind: .member(.positional(first_value), cur.span.lower, cur.span.lower + dot_index, [lhs]), start: start, end: self.span_end())
						let outer = Expr(kind: .member(.positional(second_value), cur.span.lower + dot_index + 1, cur.span.upper, [inner]), start: start, end: self.span_end())
						return self.member_postfix(member: outer, can_assign: can_assign)
					}
				}
			}
			self.fail(code: "parser.bad-label", message: "Unable to parse label: " + text)
			return dummy_expr()
		}
		self.record_expected_identifier()
		Expr(kind: .incomplete_member([lhs]), start: start, end: self.span_end())
	}

	mut func positional_member(consume receiver: [Expr], start: Int, token: Token) -> Expr {
		let index = parse_decimal(text: self.lexeme(token: token))
		if let .some(value) = index {
			// Reference quirk: the label span is the FOLLOWING token's.
			let after = self.current()
			return Expr(kind: .member(.positional(value), after.span.lower, after.span.upper, receiver), start: start, end: self.span_end())
		}
		self.fail(code: "parser.bad-label", message: "Unable to parse label: " + self.lexeme(token: token))
		dummy_expr()
	}

	// The shared member tail: postfix calls, then the assignment check —
	// which, unlike after a plain variable, runs even when a call landed.
	// Reference quirk: a member assignment's statement span starts at the
	// RHS (the reference pushes a fresh source location after the `=`).
	mut func member_postfix(member: Expr, can_assign: Bool) -> Expr {
		self.skip_semicolons_and_continuation_newlines()
		let (extended, _) = self.check_call(callee: member, can_assign: can_assign)
		if self.is_failed() { return dummy_expr() }
		if self.did_match(kind: .equals) {
			if can_assign {
				let rhs_tok = self.current()
				let rhs = self.require_expr(e: self.expr())
				if self.is_failed() { return dummy_expr() }
				let parts: [Expr] = [extended, rhs]
				self.assign_slot.push(Stmt(kind: .assignment(parts), start: rhs_tok.span.lower, end: self.span_end()))
				return dummy_expr()
			}
			self.fail_cannot_assign()
			return extended
		}
		extended
	}

	mut func record_expected_identifier() -> Void {
		let cur = self.current()
		let no_expected: TokenKind? = .none
		self.diags.push(Fail(code: "parser.expected-identifier", message: "Expected an identifier, got " + describe_kind(kind: cur.kind), start: cur.span.lower, end: cur.span.upper, expected: no_expected))
	}

	// MARK: Arrays and subscripts

	mut func array_literal() -> Expr {
		let start_tok = self.current()
		self.consume(kind: .left_bracket)
		let items: [Expr] = []
		loop true {
			self.skip_newlines()
			if self.did_match(kind: .right_bracket) { break }
			if self.at_delimiter_recovery_boundary() {
				self.record_expected(kind: .right_bracket)
				break
			}
			items.push(self.require_expr(e: self.expr()))
			if self.is_failed() { return dummy_expr() }
			let _ = self.did_match(kind: .comma)
		}
		Expr(kind: .literal_array(items), start: start_tok.span.lower, end: self.span_end())
	}

	mut func subscript(can_assign: Bool, lhs: Expr) -> Expr {
		let start = lhs.start
		self.consume(kind: .left_bracket)
		let index = self.require_expr(e: self.expr_with_precedence(prec: prec_assignment))
		if self.is_failed() { return dummy_expr() }
		self.consume_or_recover_closer(kind: .right_bracket)
		if self.is_failed() { return dummy_expr() }
		let parts: [Expr] = [lhs, index]
		let sub = Expr(kind: .subscript_expr(parts), start: start, end: self.span_end())
		if self.did_match(kind: .equals) {
			if can_assign == false {
				self.fail_cannot_assign()
				return dummy_expr()
			}
			let rhs = self.require_expr(e: self.expr_with_precedence(prec: prec_assignment))
			if self.is_failed() { return dummy_expr() }
			let assign_parts: [Expr] = [sub, rhs]
			self.assign_slot.push(Stmt(kind: .assignment(assign_parts), start: start, end: self.span_end()))
			return dummy_expr()
		}
		sub
	}

	// MARK: Control flow

	// `if` in expression position: the else branch is mandatory (a
	// missing one records a diagnostic and recovers empty).
	mut func if_expr_prefix() -> Expr {
		let start_tok = self.current()
		self.consume(kind: .keyword_if)
		let clauses = self.conditional_clauses()
		if self.is_failed() { return dummy_expr() }
		let body = self.block(context: .if_body, consumes_left_brace: true)
		if self.is_failed() { return dummy_expr() }
		let alt = dummy_block()
		if self.did_match(kind: .keyword_else) {
			alt = self.else_block(expr_position: true)
		} else {
			self.record_expected(kind: .keyword_else)
			let no_body: [Item] = []
			alt = synthesized_block(body: no_body)
		}
		if self.is_failed() { return dummy_expr() }
		self.build_conditional_expr(clauses: clauses, body: body, alt: alt, start: start_tok.span.lower, end: self.span_end())
	}

	mut func if_stmt() -> Stmt {
		let start_tok = self.current()
		self.consume(kind: .keyword_if)
		let clauses = self.conditional_clauses()
		if self.is_failed() { return dummy_stmt() }
		let body = self.block(context: .if_body, consumes_left_brace: true)
		if self.is_failed() { return dummy_stmt() }
		let alt: Block? = .none
		if self.did_match(kind: .keyword_else) {
			alt = .some(self.else_block(expr_position: false))
			if self.is_failed() { return dummy_stmt() }
		}
		if all_boolean(clauses: clauses) {
			return self.build_boolean_statement(clauses: clauses, body: body, alt: alt, start: start_tok.span.lower, end: self.span_end())
		}
		// Pattern-bearing ifs desugar to a match expression; a missing
		// else recovers as an empty synthesized block (no diagnostic in
		// statement position).
		let alt_block = dummy_block()
		if let .some(b) = alt {
			alt_block = b
		} else {
			let no_body: [Item] = []
			alt_block = synthesized_block(body: no_body)
		}
		let e = self.build_conditional_expr(clauses: clauses, body: body, alt: alt_block, start: start_tok.span.lower, end: self.span_end())
		if self.is_failed() { return dummy_stmt() }
		let e_start = e.start
		let e_end = e.end
		Stmt(kind: .expr_stmt(e), start: e_start, end: e_end)
	}

	// The alternative after an already-consumed `else`; `else if` chains
	// nest inside a synthesized block.
	mut func else_block(expr_position: Bool) -> Block {
		if self.peek_is(kind: .keyword_if) == false {
			return self.block(context: .if_body, consumes_left_brace: true)
		}
		let items: [Item] = []
		if expr_position {
			items.push(.expr_item(self.if_expr_prefix()))
		} else {
			items.push(.stmt_item(self.if_stmt()))
		}
		synthesized_block(body: items)
	}

	mut func conditional_clauses() -> [ConditionalClause] {
		let clauses: [ConditionalClause] = []
		loop true {
			if self.did_match(kind: .keyword_let) {
				let pat = self.pattern()
				if self.is_failed() { return clauses }
				self.consume(kind: .equals)
				if self.is_failed() { return clauses }
				let scrutinee = self.condition(ctx: .if_condition)
				clauses.push(.let_clause(pat, scrutinee))
			} else {
				clauses.push(.boolean(self.condition(ctx: .if_condition)))
			}
			if self.is_failed() { return clauses }
			if self.did_match(kind: .comma) == false { break }
		}
		clauses
	}

	// The desugared conditional (the reference `build_conditional_expr`):
	// a boolean clause becomes an if expression, a pattern clause a
	// two-arm match with synthesized arms. Multi-clause chains duplicate
	// the else block in the reference; the port defers them until the
	// AST grows a deep-copy walk.
	// Clauses fold right-to-left into nested conditionals; only the
	// outermost carries source spans. Every inner layer duplicates the
	// alternative (the reference deep-copies it with freshened ids).
	mut func build_conditional_expr(consume clauses: [ConditionalClause], consume body: Block, consume alt: Block, start: Int, end: Int) -> Expr {
		let success = body
		let result = dummy_expr()
		loop true {
			let popped = clauses.pop()
			if let .some(clause) = popped {
				if clauses.count == 0 {
					result = clause_expr(clause: clause, success: success, failure: alt, start: start, end: end)
					break
				}
				let failure = copy_block(block: alt)
				let e = clause_expr(clause: clause, success: success, failure: failure, start: 0 - 1, end: 0 - 1)
				let wrapped: [Item] = [.expr_item(e)]
				success = synthesized_block(body: wrapped)
			} else {
				break
			}
		}
		result
	}

	// Boolean `if` chains fold right-to-left into nested statements; only
	// the outermost carries source spans (the reference synthesizes the
	// inner chain), and each inner layer duplicates the else block.
	mut func build_boolean_statement(consume clauses: [ConditionalClause], consume body: Block, consume alt: Block?, start: Int, end: Int) -> Stmt {
		let inner = body
		let outer_alt = alt
		let result = dummy_stmt()
		loop true {
			let popped = clauses.pop()
			if let .some(clause) = popped {
				let cond = dummy_expr()
				match clause {
					.boolean(c) -> { cond = c },
					.let_clause(_, _) -> {}
				}
				if clauses.count == 0 {
					result = Stmt(kind: .if_stmt(cond, inner, outer_alt), start: start, end: end)
					break
				}
				let failure = copy_optional_block(block: outer_alt)
				let s = Stmt(kind: .if_stmt(cond, inner, failure), start: 0 - 1, end: 0 - 1)
				let wrapped: [Item] = [.stmt_item(s)]
				inner = synthesized_block(body: wrapped)
			} else {
				break
			}
		}
		result
	}

	mut func match_expr_prefix() -> Expr {
		let start_tok = self.current()
		self.consume(kind: .keyword_match)
		self.contexts.push(.match_scrutinee)
		let scrutinee = self.require_expr(e: self.expr())
		let _ = self.contexts.pop()
		if self.is_failed() { return dummy_expr() }
		// A missing `{` records a diagnostic and yields an empty match.
		self.skip_newlines()
		if self.peek_is(kind: .left_brace) {
			self.advance()
		} else {
			self.record_expected(kind: .left_brace)
			let no_arms: [MatchArm] = []
			let scrutinee_arr: [Expr] = [scrutinee]
			return Expr(kind: .match_expr(scrutinee_arr, no_arms), start: start_tok.span.lower, end: self.span_end())
		}
		let arms: [MatchArm] = []
		loop true {
			self.skip_newlines()
			if self.did_match(kind: .right_brace) { break }
			if self.peek_is(kind: .eof) {
				self.record_expected(kind: .right_brace)
				break
			}
			let arm_tok = self.current()
			let pat = self.pattern()
			if self.is_failed() { return dummy_expr() }
			self.consume(kind: .arrow)
			if self.is_failed() { return dummy_expr() }
			let body = self.block(context: .match_arm_body, consumes_left_brace: true)
			if self.is_failed() { return dummy_expr() }
			arms.push(MatchArm(pattern: pat, body: body, start: arm_tok.span.lower, end: self.span_end()))
			let _ = self.did_match(kind: .comma)
			self.skip_newlines()
		}
		let scrutinee_arr: [Expr] = [scrutinee]
		Expr(kind: .match_expr(scrutinee_arr, arms), start: start_tok.span.lower, end: self.span_end())
	}

	mut func loop_stmt() -> Stmt {
		let start_tok = self.current()
		self.consume(kind: .keyword_loop)
		let cond: Expr? = .none
		if self.peek_is(kind: .left_brace) == false {
			cond = .some(self.condition(ctx: .loop_condition))
			if self.is_failed() { return dummy_stmt() }
		}
		let body = self.block(context: .loop_body, consumes_left_brace: true)
		if self.is_failed() { return dummy_stmt() }
		Stmt(kind: .loop_stmt(cond, body), start: start_tok.span.lower, end: self.span_end())
	}

	mut func for_stmt() -> Stmt {
		let start_tok = self.current()
		self.consume(kind: .keyword_for)
		let pat = self.pattern()
		if self.is_failed() { return dummy_stmt() }
		self.consume(kind: .keyword_in)
		if self.is_failed() { return dummy_stmt() }
		self.contexts.push(.for_iterable)
		let (mode, _, _) = self.arg_mode()
		let iterable = self.require_expr(e: self.expr())
		let _ = self.contexts.pop()
		if self.is_failed() { return dummy_stmt() }
		let body = self.block(context: .loop_body, consumes_left_brace: true)
		if self.is_failed() { return dummy_stmt() }
		// Reference quirk: block arguments on the body replace the loop
		// pattern (`for x in xs { y in … }` iterates as `y`), which
		// inherits the Parameter's meta (its after-name span) as extents.
		if body.params.count > 0 {
			let name_start = body.params[0].name_start
			let name_end = body.params[0].name_end
			let param_start = body.params[0].start
			let param_end = body.params[0].end
			pat = Pattern(kind: .bind(self.slice_text(start: name_start, end: name_end)), start: name_start, end: name_end, meta_start: param_start, meta_end: param_end)
			let b_start = body.start
			let b_end = body.end
			let no_params: [Parameter] = []
			body = Block(params: no_params, body: body.body, start: b_start, end: b_end, copied: body.copied)
		}
		Stmt(kind: .for_stmt(iterable, pat, body, mode), start: start_tok.span.lower, end: self.span_end())
	}

	// An ownership marker on a for-loop's iterable, only when a plain
	// name follows (`consume` alone is an ordinary variable).
	mut func arg_mode() -> (ArgMode?, Int, Int) {
		if self.peek_is(kind: .keyword_mut) {
			let tok = self.current()
			self.advance()
			let m: ArgMode? = .some(.mut_mode)
			return (m, tok.span.lower, tok.span.upper)
		}
		let cur = self.current()
		if cur.kind == .identifier && self.next_kind() == .identifier {
			let text = self.lexeme(token: cur)
			let mode: ArgMode? = .none
			if text == "consume" { mode = .some(.consume_mode) }
			if text == "copy" { mode = .some(.copy_mode) }
			if text == "borrow" { mode = .some(.borrow_mode) }
			if let .some(m) = mode {
				self.advance()
				let found: ArgMode? = .some(m)
				return (found, cur.span.lower, cur.span.upper)
			}
		}
		let none: ArgMode? = .none
		return (none, -1, -1)
	}

	mut func return_stmt() -> Stmt {
		let start_tok = self.current()
		self.consume(kind: .keyword_return)
		if self.at_implicit_statement_end() {
			let no_rhs: Expr? = .none
			return Stmt(kind: .return_stmt(no_rhs), start: start_tok.span.lower, end: self.span_end())
		}
		let rhs = self.require_expr(e: self.expr_with_precedence(prec: prec_none))
		if self.is_failed() { return dummy_stmt() }
		Stmt(kind: .return_stmt(.some(rhs)), start: start_tok.span.lower, end: self.span_end())
	}

	mut func continue_stmt() -> Stmt {
		let start_tok = self.current()
		self.consume(kind: .keyword_continue)
		if self.at_implicit_statement_end() == false {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected end of statement (`continue` takes no value; use `'continue` to resume an effect handler), got " + describe_kind(kind: self.current().kind))
			return dummy_stmt()
		}
		Stmt(kind: .continue_stmt, start: start_tok.span.lower, end: self.span_end())
	}

	// `'continue expr?` — resumes the enclosing effect handler.
	mut func resume_stmt() -> Stmt {
		let start_tok = self.current()
		self.advance()
		let rhs: Expr? = .none
		if self.at_implicit_statement_end() == false {
			rhs = .some(self.require_expr(e: self.expr()))
			if self.is_failed() { return dummy_stmt() }
		}
		Stmt(kind: .resume_stmt(rhs), start: start_tok.span.lower, end: self.span_end())
	}

	// A value-carrying statement keyword followed by any of these
	// carries no value.
	func at_implicit_statement_end() -> Bool {
		let k = self.current().kind
		k == .newline || k == .semicolon || k == .right_brace || k == .eof
	}

	// MARK: Tuples and blocks

	mut func tuple() -> Expr {
		let start_tok = self.current()
		self.consume(kind: .left_paren)
		let items: [Expr] = []
		if self.did_match(kind: .right_paren) {
			return Expr(kind: .tuple(items), start: start_tok.span.lower, end: self.span_end())
		}
		items.push(self.require_expr(e: self.expr_with_precedence(prec: prec_assignment)))
		if self.is_failed() { return dummy_expr() }
		if self.did_match(kind: .right_paren) {
			return Expr(kind: .tuple(items), start: start_tok.span.lower, end: self.span_end())
		}
		if self.at_delimiter_recovery_boundary() {
			self.record_expected(kind: .right_paren)
			return Expr(kind: .tuple(items), start: start_tok.span.lower, end: self.span_end())
		}
		self.consume(kind: .comma)
		if self.is_failed() { return dummy_expr() }
		let recovered_closer = false
		loop true {
			self.skip_newlines()
			if self.did_match(kind: .right_paren) {
				return Expr(kind: .tuple(items), start: start_tok.span.lower, end: self.span_end())
			}
			if self.at_delimiter_recovery_boundary() {
				self.record_expected(kind: .right_paren)
				recovered_closer = true
				break
			}
			items.push(self.require_expr(e: self.expr_with_precedence(prec: prec_assignment)))
			if self.is_failed() { return dummy_expr() }
			if self.did_match(kind: .comma) == false { break }
		}
		if recovered_closer == false {
			self.consume_or_recover_closer(kind: .right_paren)
		}
		Expr(kind: .tuple(items), start: start_tok.span.lower, end: self.span_end())
	}

	mut func block_expr() -> Expr {
		let start_tok = self.current()
		self.consume(kind: .left_brace)
		if self.peek_is_record_literal() {
			return self.record_literal_body(start_tok: start_tok)
		}
		let inner = self.block(context: .plain, consumes_left_brace: false)
		Expr(kind: .block(inner), start: start_tok.span.lower, end: self.span_end())
	}

	mut func peek_is_record_literal() -> Bool {
		self.skip_newlines()
		let cur = self.current()
		if cur.kind == .dot_dot_dot { return true }
		if cur.kind == .identifier { return self.next_kind() == .colon }
		false
	}

	// `{ label: value, ...spread }` with the `{` already consumed (the
	// reference `record_literal_body`). A spread must close the record.
	mut func record_literal_body(start_tok: Token) -> Expr {
		let fields: [RecordField] = []
		let spread: [Expr] = []
		loop true {
			if self.did_match(kind: .right_brace) { break }
			self.skip_newlines()
			if self.at_delimiter_recovery_boundary() {
				self.record_expected(kind: .right_brace)
				break
			}
			if self.peek_is(kind: .dot_dot_dot) {
				self.advance()
				spread.push(self.require_expr(e: self.expr_with_precedence(prec: prec_assignment)))
				if self.is_failed() { return dummy_expr() }
				self.consume_or_recover_closer_after_newline(kind: .right_brace)
				break
			}
			let field_tok = self.current()
			let label_tok = self.identifier_token()
			let label = self.lexeme(token: label_tok)
			if self.is_failed() { return dummy_expr() }
			self.consume(kind: .colon)
			if self.is_failed() { return dummy_expr() }
			let value = self.require_expr(e: self.expr_with_precedence(prec: prec_assignment))
			if self.is_failed() { return dummy_expr() }
			fields.push(RecordField(label: label, label_start: label_tok.lexeme.lower, label_end: label_tok.lexeme.upper, value: value, start: field_tok.span.lower, end: self.span_end()))
			self.skip_newlines()
			if self.peek_is(kind: .right_brace) {
				let _ = self.did_match(kind: .comma)
			} else {
				if self.at_delimiter_recovery_boundary() || self.prev_was_newline() {
					self.record_expected(kind: .right_brace)
					break
				}
				self.consume(kind: .comma)
				if self.is_failed() { return dummy_expr() }
			}
			self.skip_newlines()
		}
		Expr(kind: .record_literal(fields, spread), start: start_tok.span.lower, end: self.span_end())
	}

	// The shared block body (the reference `block`). With
	// `consumes_left_brace` the span starts at the `{`; without, the
	// caller consumed it and the span starts at the first body token.
	// Match-arm bodies without a brace hold exactly one statement, and
	// if/loop bodies recover from a missing brace with an empty block.
	// Body items go through the declaration dispatch, exactly like roots
	// (non-keywords fall through to statements).
	mut func block(context: BlockContext, consumes_left_brace: Bool) -> Block {
		self.skip_newlines()
		let start_tok = self.current()
		if context == .match_arm_body && self.peek_is(kind: .left_brace) == false {
			let s = self.stmt()
			if self.is_failed() { return dummy_block() }
			let no_params: [Parameter] = []
			let body: [Item] = [.stmt_item(s)]
			return Block(params: no_params, body: body, start: start_tok.span.lower, end: self.span_end(), copied: false)
		}
		if consumes_left_brace {
			if self.peek_is(kind: .left_brace) {
				self.advance()
			} else {
				if context == .if_body || context == .loop_body {
					self.record_expected(kind: .left_brace)
					let no_params: [Parameter] = []
					let no_body: [Item] = []
					return Block(params: no_params, body: no_body, start: start_tok.span.lower, end: self.span_end(), copied: false)
				}
				self.fail_expected(kind: .left_brace)
				return dummy_block()
			}
		}
		let params = self.block_args()
		self.skip_semicolons_and_newlines()
		let body: [Item] = []
		loop true {
			if self.did_match(kind: .right_brace) { break }
			if self.peek_is(kind: .eof) {
				self.record_expected(kind: .right_brace)
				break
			}
			if self.is_failed() { break }
			body.push(self.decl(context: context, is_static: false))
			if self.is_failed() { break }
			self.skip_semicolons_and_newlines()
		}
		Block(params: params, body: body, start: start_tok.span.lower, end: self.span_end(), copied: false)
	}

	// Block arguments (`{ x, y in … }`): probed with rollback — anything
	// that is not a name list ending in `in` is body, not arguments.
	mut func block_args() -> [Parameter] {
		let none: [Parameter] = []
		if self.peek_is(kind: .keyword_in) {
			self.consume(kind: .keyword_in)
			return none
		}
		let checkpoint = self.pos
		let log_mark = self.id_log.count
		let params: [Parameter] = []
		loop true {
			let (mode, mode_start, mode_end) = self.param_mode()
			self.skip_semicolons_and_newlines()
			let name_tok = self.current()
			let name = self.identifier()
			if self.is_failed() {
				self.pos = checkpoint
				self.failed = .none
				self.mark_probe(from: log_mark)
				return none
			}
			let param_start = self.current().span.lower
			let annotation: TypeAnnotation? = .none
			if self.did_match(kind: .colon) {
				// A real argument list from here on: annotation errors
				// propagate rather than rolling back.
				annotation = .some(self.type_annotation())
				if self.is_failed() { return params }
			}
			let no_label: ParamLabel? = .none
			params.push(Parameter(label: no_label, label_start: -1, label_end: -1, name: name, name_start: name_tok.lexeme.lower, name_end: name_tok.lexeme.upper, mode: mode, mode_start: mode_start, mode_end: mode_end, annotation: annotation, start: param_start, end: self.span_end()))
			if self.did_match(kind: .comma) {
				// Next parameter.
			} else {
				if self.did_match(kind: .keyword_in) {
					return params
				}
				self.pos = checkpoint
				self.mark_probe(from: log_mark)
				return none
			}
		}
		params
	}

	// Tag log entries appended by a rolled-back block-args probe.
	mut func mark_probe(from: Int) -> Void {
		let i = from
		loop i < self.id_log_probe.count {
			self.id_log_probe[i] = true
			i = i + 1
		}
	}

	// An optional ownership-mode prefix on a parameter (ADR 0018): `mut`
	// is a hard keyword; `consume`/`borrow` are contextual and only read
	// as modes when a parameter name follows.
	mut func param_mode() -> (ParamMode?, Int, Int) {
		self.skip_semicolons_and_newlines()
		if self.peek_is(kind: .keyword_mut) {
			let tok = self.current()
			self.advance()
			let m: ParamMode? = .some(.mut_param)
			return (m, tok.span.lower, tok.span.upper)
		}
		let cur = self.current()
		if cur.kind == .identifier {
			let text = self.lexeme(token: cur)
			if text == "consume" && self.next_is_parameter_name(allow_mut: true) {
				self.advance()
				if self.peek_is(kind: .keyword_mut) {
					// `consume mut` spans both words.
					let mut_tok = self.current()
					self.advance()
					let m: ParamMode? = .some(.consume_mut_param)
					return (m, cur.span.lower, mut_tok.span.upper)
				}
				let m: ParamMode? = .some(.consume_param)
				return (m, cur.span.lower, cur.span.upper)
			}
			if text == "borrow" && self.next_is_parameter_name(allow_mut: false) {
				self.advance()
				let m: ParamMode? = .some(.borrow_param)
				return (m, cur.span.lower, cur.span.upper)
			}
		}
		let none: ParamMode? = .none
		return (none, -1, -1)
	}

	func next_is_parameter_name(allow_mut: Bool) -> Bool {
		let k = self.next_kind()
		if k == .identifier || k == .underscore { return true }
		if k == .keyword_mut { return allow_mut }
		false
	}

	// The reference `closure_block`: a plain block that synthesizes `$N`
	// positional parameters when its body references bound variables but
	// declares no argument list.
	mut func closure_block() -> Block {
		prepare_closure_block(block: self.block(context: .plain, consumes_left_brace: true))
	}

	// Postfix call forms off a just-parsed callee. Returns the (possibly
	// extended) expression and whether a call consumed it — the caller's
	// assignment check only runs when nothing did.
	mut func check_call(callee: Expr, can_assign: Bool) -> (Expr, Bool) {
		let cur = self.current()
		if cur.kind == .less && self.pos > 0 {
			if self.token_at(index: self.pos - 1).span.upper == cur.span.lower {
				self.advance()
				let type_args = self.generic_args_list()
				if self.is_failed() { return (dummy_expr(), true) }
				if self.did_match(kind: .left_paren) {
					self.skip_newlines()
					return (self.call(callee: callee, type_args: type_args, can_assign: can_assign), true)
				}
				// `Path<Args>` without a call: a specialized type
				// reference — members chain off it or it stands alone
				// (typing rejects bare type values with a real
				// diagnostic). The args land on the segment they follow.
				match flatten_type_path(expr: callee) {
					.path(path, segments) -> {
						if let .some(last) = segments.pop() {
							for arg in consume type_args {
								last.push(arg)
							}
							segments.push(last)
						}
						return (Expr(kind: .constructor(path, segments), start: callee.start, end: self.span_end()), true)
					},
					.not_a_path -> {
						self.consume(kind: .left_paren)
						if self.is_failed() { return (dummy_expr(), true) }
						self.skip_newlines()
						return (self.call(callee: callee, type_args: type_args, can_assign: can_assign), true)
					}
				}
			}
		}
		if self.did_match(kind: .left_paren) {
			self.skip_newlines()
			let no_type_args: [GenericArg] = []
			return (self.call(callee: callee, type_args: no_type_args, can_assign: can_assign), true)
		}
		// Call parens may be omitted before a leading string argument:
		// `foo "sup"` and `foo "sup" { … }`.
		if self.peek_is(kind: .string_literal) && self.prev_was_newline() == false {
			return (self.call_with_leading_string_arg(callee: callee, can_assign: can_assign), true)
		}
		// Trailing-block calls only where the context allows them: inside
		// a control-flow header the `{` opens the construct's body.
		if self.allows_trailing_blocks() && self.peek_is(kind: .left_brace) {
			return (self.call_with_trailing_block_only(callee: callee), true)
		}
		(callee, false)
	}

	// A call with only a trailing block (no parens): `foo { block }`.
	mut func call_with_trailing_block_only(callee: Expr) -> Expr {
		let start = callee.start
		let no_type_args: [GenericArg] = []
		let no_args: [CallArg] = []
		let trailing = self.closure_block()
		Expr(kind: .call([callee], no_type_args, no_args, [trailing]), start: start, end: self.span_end())
	}

	// A call whose parens are omitted before a leading string argument
	// (ADR 0041: the paren-less form omits that argument's label by
	// syntax, like a trailing block omits the final one).
	mut func call_with_leading_string_arg(callee: Expr, can_assign: Bool) -> Expr {
		let start = callee.start
		let first = self.argument()
		let args: [CallArg] = [CallArg(label: first.label, label_start: first.label_start, label_end: first.label_end, mode: first.mode, mode_start: first.mode_start, mode_end: first.mode_end, bare_string: true, value: first.value, start: first.start, end: first.end)]
		loop self.did_match(kind: .comma) {
			if self.is_failed() { return dummy_expr() }
			args.push(self.argument())
		}
		if self.is_failed() { return dummy_expr() }
		let blocks: [Block] = []
		if self.allows_trailing_blocks() && self.peek_is(kind: .left_brace) {
			blocks.push(self.closure_block())
		}
		let no_type_args: [GenericArg] = []
		let call_expr = Expr(kind: .call([callee], no_type_args, args, blocks), start: start, end: self.span_end())
		if self.peek_is(kind: .left_paren) {
			let (chained, _) = self.check_call(callee: call_expr, can_assign: can_assign)
			return chained
		}
		call_expr
	}

	// The opening paren is already consumed.
	mut func call(callee: Expr, type_args: [GenericArg], can_assign: Bool) -> Expr {
		let start = callee.start
		self.skip_newlines()
		let args: [CallArg] = []
		if self.did_match(kind: .right_paren) {
			// Empty argument list.
		} else {
			if self.at_delimiter_recovery_boundary() {
				self.record_expected(kind: .right_paren)
			} else {
				args = self.arguments()
				self.consume_or_recover_closer_after_newline(kind: .right_paren)
			}
		}
		let blocks: [Block] = []
		if self.allows_trailing_blocks() && self.peek_is(kind: .left_brace) {
			blocks.push(self.closure_block())
		} else {
			// The reference pops a final parenthesized `{ … }` argument
			// (unlabeled) into the trailing-block slot.
			if let .some(arg) = args.pop() {
				let label = arg.label
				let label_start = arg.label_start
				let label_end = arg.label_end
				let mode = arg.mode
				let mode_start = arg.mode_start
				let mode_end = arg.mode_end
				let arg_bare = arg.bare_string
				let value = arg.value
				let arg_start = arg.start
				let arg_end = arg.end
				let is_plain = true
				if let .some(_) = label { is_plain = false }
				if let .some(_) = mode { is_plain = false }
				if is_plain {
					let v_start = value.start
					let v_end = value.end
					match value.kind {
						.block(inner) -> blocks.push(prepare_closure_block(block: inner)),
						other_kind -> {
							let no_label: String? = .none
							let no_mode: ArgMode? = .none
							args.push(CallArg(label: no_label, label_start: label_start, label_end: label_end, mode: no_mode, mode_start: mode_start, mode_end: mode_end, bare_string: arg_bare, value: Expr(kind: other_kind, start: v_start, end: v_end), start: arg_start, end: arg_end))
						}
					}
				} else {
					args.push(CallArg(label: label, label_start: label_start, label_end: label_end, mode: mode, mode_start: mode_start, mode_end: mode_end, bare_string: arg_bare, value: value, start: arg_start, end: arg_end))
				}
			}
		}
		let call_expr = Expr(kind: .call([callee], type_args, args, blocks), start: start, end: self.span_end())
		if self.peek_is(kind: .left_paren) {
			let (chained, _) = self.check_call(callee: call_expr, can_assign: can_assign)
			return chained
		}
		call_expr
	}

	mut func arguments() -> [CallArg] {
		let args: [CallArg] = []
		loop true {
			self.skip_newlines()
			if self.peek_is(kind: .right_paren) || self.at_delimiter_recovery_boundary() { return args }
			if self.is_failed() { return args }
			args.push(self.argument())
			if self.did_match(kind: .comma) {
				// Next argument.
			} else {
				self.skip_newlines()
				return args
			}
		}
		args
	}

	mut func argument() -> CallArg {
		let start_tok = self.current()
		// ADR 0041: `_:` parses as a written label (never valid —
		// semantic analysis reports it and the LSP can remove it).
		if start_tok.kind == .underscore && self.next_kind() == .colon {
			self.advance()
			self.consume(kind: .colon)
			let (mode, mode_start, mode_end) = self.arg_mode()
			let value = self.require_expr(e: self.expr_with_precedence(prec: prec_assignment))
			let underscore_label: String? = .some("_")
			return CallArg(label: underscore_label, label_start: start_tok.span.lower, label_end: start_tok.span.upper, mode: mode, mode_start: mode_start, mode_end: mode_end, bare_string: false, value: value, start: start_tok.span.lower, end: self.span_end())
		}
		let label: String? = .none
		let label_start = -1
		let label_end = -1
		if start_tok.kind == .identifier && self.next_kind() == .colon {
			let label_tok = self.identifier_token()
			label = .some(self.lexeme(token: label_tok))
			label_start = label_tok.lexeme.lower
			label_end = label_tok.lexeme.upper
			self.consume(kind: .colon)
		}
		let (mode, mode_start, mode_end) = self.arg_mode()
		let value = self.require_expr(e: self.expr_with_precedence(prec: prec_assignment))
		CallArg(label: label, label_start: label_start, label_end: label_end, mode: mode, mode_start: mode_start, mode_end: mode_end, bare_string: false, value: value, start: start_tok.span.lower, end: self.span_end())
	}

	// MARK: Patterns

	mut func pattern() -> Pattern {
		let start_tok = self.current()
		let k = start_tok.kind
		let kind: PatternKind = .wildcard
		if k == .attribute {
			return self.macro_call_pattern()
		}
		if k == .int_number {
			kind = .literal_int(self.lexeme(token: start_tok))
			self.advance()
		} else if k == .float_number {
			kind = .literal_float(self.lexeme(token: start_tok))
			self.advance()
		} else if k == .character_literal {
			kind = .literal_character(self.slice_text(start: start_tok.span.lower + 1, end: start_tok.span.upper - 1))
			self.advance()
		} else if k == .string_literal {
			kind = .literal_string(self.slice_text(start: start_tok.span.lower + 1, end: start_tok.span.upper - 1))
			self.advance()
		} else if k == .keyword_true {
			kind = .literal_true
			self.advance()
		} else if k == .keyword_false {
			kind = .literal_false
			self.advance()
		} else if k == .identifier {
			kind = self.named_pattern(start_tok: start_tok)
			if self.is_failed() { return dummy_pattern() }
		} else if k == .underscore {
			self.advance()
			kind = .wildcard
		} else if k == .dot {
			self.advance()
			let variant_tok = self.identifier_token()
			let variant_name = self.lexeme(token: variant_tok)
			if self.is_failed() { return dummy_pattern() }
			let (fields, labels) = self.pattern_fields()
			if self.is_failed() { return dummy_pattern() }
			let no_generics: [[GenericArg]] = []
			kind = .variant(.none, no_generics, variant_name, variant_tok.lexeme.lower, variant_tok.lexeme.upper, fields, labels)
		} else if k == .left_paren {
			self.advance()
			let items: [Pattern] = []
			loop self.did_match(kind: .right_paren) == false {
				if self.is_failed() { return dummy_pattern() }
				items.push(self.pattern())
				if self.is_failed() { return dummy_pattern() }
				self.did_match(kind: .comma)
			}
			kind = .tuple(items)
		} else if k == .left_brace {
			self.advance()
			kind = self.record_pattern_body()
			if self.is_failed() { return dummy_pattern() }
		} else {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected Pattern, got " + describe_kind(kind: k))
			return dummy_pattern()
		}
		if self.peek_is(kind: .pipe) {
			let first = Pattern(kind: kind, start: start_tok.span.lower, end: self.span_end(), meta_start: 0 - 1, meta_end: 0 - 1)
			let patterns = [first]
			loop self.did_match(kind: .pipe) {
				patterns.push(self.pattern())
				if self.is_failed() { return dummy_pattern() }
			}
			return Pattern(kind: .or_pattern(patterns), start: start_tok.span.lower, end: self.span_end(), meta_start: 0 - 1, meta_end: 0 - 1)
		}
		Pattern(kind: kind, start: start_tok.span.lower, end: self.span_end(), meta_start: 0 - 1, meta_end: 0 - 1)
	}

	// A pattern opening with a name: a dotted path may end in a struct
	// pattern or a variant; a bare single name binds.
	// A dotted head may name a nested type, and every segment may take
	// adjacent generic args (`Res<Int>.A<Bool>.pair`, `Outer<Int>.Inner
	// { … }`): collect the whole path, then decide struct vs variant by
	// what follows.
	mut func named_pattern(start_tok: Token) -> PatternKind {
		let head = self.lexeme(token: start_tok)
		self.advance()
		let segments = [head]
		let seg_starts = [start_tok.lexeme.lower]
		let seg_ends = [start_tok.lexeme.upper]
		let no_args: [GenericArg] = []
		let segment_generics: [[GenericArg]] = [no_args]
		loop true {
			if self.peek_adjacent_less() {
				self.consume(kind: .less)
				let args = self.generic_args_list()
				if self.is_failed() { return .wildcard }
				let _ = segment_generics.pop()
				segment_generics.push(args)
			}
			if self.did_match(kind: .dot) {
				let seg_tok = self.identifier_token()
				segments.push(self.lexeme(token: seg_tok))
				seg_starts.push(seg_tok.lexeme.lower)
				seg_ends.push(seg_tok.lexeme.upper)
				if self.is_failed() { return .wildcard }
				let empty: [GenericArg] = []
				segment_generics.push(empty)
			} else {
				break
			}
		}
		if self.peek_is(kind: .left_brace) {
			self.consume(kind: .left_brace)
			return self.struct_pattern_body(name: join_path(segments: segments), generics: segment_generics)
		}
		if segments.count > 1 {
			let variant_name = ""
			if let .some(last) = segments.pop() {
				variant_name = last
			}
			let variant_start = -1
			let variant_end = -1
			if let .some(vs) = seg_starts.pop() { variant_start = vs }
			if let .some(ve) = seg_ends.pop() { variant_end = ve }
			// The final segment is the variant, which takes no generic
			// args of its own.
			if let .some(variant_generics) = segment_generics.pop() {
				if variant_generics.count > 0 {
					self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected no generic arguments on a variant pattern, got " + describe_kind(kind: self.current().kind))
					return .wildcard
				}
			}
			let path = join_path(segments: segments)
			let (fields, labels) = self.pattern_fields()
			if self.is_failed() { return .wildcard }
			return .variant(.some(path), segment_generics, variant_name, variant_start, variant_end, fields, labels)
		}
		let has_generics = false
		if segment_generics.count > 0 {
			if segment_generics[0].count > 0 { has_generics = true }
		}
		if has_generics {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a member or struct pattern after generic arguments, got " + describe_kind(kind: self.current().kind))
			return .wildcard
		}
		let name = ""
		if let .some(only) = segments.pop() {
			name = only
		}
		.bind(name)
	}

	// Variant payload fields: `(pattern, label: pattern, …)`.
	mut func pattern_fields() -> ([Pattern], [String?]) {
		let fields: [Pattern] = []
		let labels: [String?] = []
		if self.did_match(kind: .left_paren) {
			loop self.did_match(kind: .right_paren) == false {
				if self.is_failed() { break }
				if self.peek_is(kind: .identifier) && self.next_kind() == .colon {
					let label = self.identifier()
					self.consume(kind: .colon)
					fields.push(self.pattern())
					labels.push(.some(label))
				} else {
					fields.push(self.pattern())
					labels.push(.none)
				}
				if self.is_failed() { break }
				self.did_match(kind: .comma)
			}
		}
		(fields, labels)
	}

	// The opening brace is already consumed.
	mut func struct_pattern_body(name: String, consume generics: [[GenericArg]]) -> PatternKind {
		self.skip_newlines()
		let fields: [Pattern] = []
		let field_names: [String] = []
		let rest = false
		loop self.did_match(kind: .right_brace) == false {
			if self.is_failed() { break }
			if self.peek_is(kind: .dot_dot) {
				self.consume(kind: .dot_dot)
				if self.peek_is(kind: .right_brace) == false {
					self.fail_expected(kind: .right_brace)
					break
				}
				rest = true
				self.consume(kind: .right_brace)
				break
			}
			let name_tok = self.current()
			let field_name = self.identifier()
			if self.is_failed() { break }
			if self.peek_is(kind: .colon) {
				self.consume(kind: .colon)
				fields.push(self.pattern())
			} else {
				// Shorthand `x` binds the field to a same-named local.
				fields.push(Pattern(kind: .bind(self.lexeme(token: name_tok)), start: name_tok.span.lower, end: self.span_end(), meta_start: 0 - 1, meta_end: 0 - 1))
			}
			if self.is_failed() { break }
			field_names.push(field_name)
			self.did_match(kind: .comma)
			self.skip_newlines()
		}
		.struct_pattern(name, generics, fields, field_names, rest)
	}

	// The opening brace is already consumed.
	mut func record_pattern_body() -> PatternKind {
		self.skip_newlines()
		let fields: [RecordFieldPattern] = []
		loop self.did_match(kind: .right_brace) == false {
			if self.is_failed() { break }
			let cur = self.current()
			if cur.kind == .dot_dot {
				self.did_match(kind: .dot_dot)
				if self.peek_is(kind: .right_brace) == false {
					self.fail_expected(kind: .right_brace)
					break
				}
				fields.push(RecordFieldPattern(kind: .rest_field, start: cur.span.lower, end: self.span_end()))
				self.did_match(kind: .right_brace)
				break
			}
			if cur.kind == .identifier {
				let field_name_tok = self.identifier_token()
				let field_name = self.lexeme(token: field_name_tok)
				if self.is_failed() { break }
				if self.peek_is(kind: .colon) {
					self.did_match(kind: .colon)
					let value = self.pattern()
					if self.is_failed() { break }
					fields.push(RecordFieldPattern(kind: .equals_field(field_name, field_name_tok.lexeme.lower, field_name_tok.lexeme.upper, value), start: cur.span.lower, end: self.span_end()))
				} else {
					fields.push(RecordFieldPattern(kind: .bind_field(field_name), start: cur.span.lower, end: self.span_end()))
				}
			} else {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a record field, got " + describe_kind(kind: cur.kind))
				break
			}
			self.did_match(kind: .comma)
		}
		.record(fields)
	}

	func peek_adjacent_less() -> Bool {
		if self.pos == 0 { return false }
		let cur = self.current()
		cur.kind == .less && self.token_at(index: self.pos - 1).span.upper == cur.span.lower
	}

	// MARK: Declarations

	mut func let_decl() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_let)
		let lhs = self.pattern()
		let annotation: TypeAnnotation? = .none
		if self.did_match(kind: .colon) {
			annotation = .some(self.type_annotation())
		}
		let rhs: Expr? = .none
		if self.did_match(kind: .equals) {
			rhs = .some(self.require_expr(e: self.expr()))
		}
		if self.did_match(kind: .keyword_else) {
			let else_body = self.block(context: .if_body, consumes_left_brace: true)
			return desugar_let_else(pattern: lhs, annotation: annotation, rhs: rhs, else_body: .some(else_body), start: start_tok.span.lower, end: self.span_end())
		}
		// An or-pattern let takes the same desugaring road (a single-arm
		// match, no else): alternatives bind the same names, and a miss
		// is the match machinery's miss.
		if pattern_contains_or(pattern: lhs) {
			let no_else: Block? = .none
			return desugar_let_else(pattern: lhs, annotation: annotation, rhs: rhs, else_body: no_else, start: start_tok.span.lower, end: self.span_end())
		}
		Decl(kind: .let_decl(lhs, annotation, rhs), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	// MARK: Type annotations

	mut func type_annotation() -> TypeAnnotation {
		let base = self.type_annotation_base()
		if self.is_failed() { return base }
		self.optional_sugar(base: base)
	}

	// Postfix `?` sugar: each wraps the base in `Optional<...>`.
	mut func optional_sugar(consume base: TypeAnnotation) -> TypeAnnotation {
		loop self.did_match(kind: .question_mark) {
			let start = base.start
			let end = self.span_end()
			base = TypeAnnotation(kind: .nominal("Optional", start, end, [.type_arg(base)]), start: start, end: end)
		}
		base
	}

	mut func type_annotation_base() -> TypeAnnotation {
		let start_tok = self.current()
		if start_tok.kind == .attribute {
			return self.macro_call_type()
		}
		if self.did_match(kind: .amp) {
			let mutable = self.did_match(kind: .keyword_mut)
			let inner = self.type_annotation()
			return TypeAnnotation(kind: .borrow(mutable, [inner]), start: start_tok.span.lower, end: self.span_end())
		}
		if self.did_match(kind: .star) {
			let inner = self.type_annotation()
			return TypeAnnotation(kind: .unique([inner]), start: start_tok.span.lower, end: self.span_end())
		}
		if self.did_match(kind: .left_paren) {
			let no_modes: [TypeParamMode] = []
			let no_types: [TypeAnnotation] = []
			return self.finish_paren_type(start: start_tok.span.lower, modes: no_modes, types: no_types, closed: false, borrow_by_default: true)
		}
		if self.did_match(kind: .keyword_any) {
			return self.any_type_annotation(start: start_tok.span.lower)
		}
		if self.peek_is(kind: .less) {
			// A quantified function type `<T, U: Bound>(params) -> Ret
			// where ...` (rank-N field types): the declared generics and
			// optional where clause scope over the function type.
			let generics = self.generics_list()
			if self.is_failed() { return dummy_type() }
			if generics.count == 0 {
				self.fail(code: "parser.empty-quantified-type", message: "A quantified type needs at least one generic parameter inside `<>`")
				return dummy_type()
			}
			self.consume(kind: .left_paren)
			if self.is_failed() { return dummy_type() }
			let no_modes: [TypeParamMode] = []
			let no_types: [TypeAnnotation] = []
			let inner = self.finish_paren_type(start: start_tok.span.lower, modes: no_modes, types: no_types, closed: false, borrow_by_default: false)
			if self.is_failed() { return dummy_type() }
			if let .func_type(_, _, _) = inner.kind { } else {
				self.fail(code: "parser.quantified-non-function-type", message: "A quantified type `<...>` must wrap a function type like `(x: T) -> T`")
				return dummy_type()
			}
			let wc = self.where_clause()
			if self.is_failed() { return dummy_type() }
			let inners: [TypeAnnotation] = []
			inners.push(inner)
			return TypeAnnotation(kind: .quantified_type(generics, wc, inners), start: start_tok.span.lower, end: self.span_end())
		}
		if self.did_match(kind: .left_bracket) {
			let element = self.type_annotation()
			if self.is_failed() { return dummy_type() }
			let name = "Array"
			let generics: [GenericArg] = [.type_arg(element)]
			if self.did_match(kind: .semicolon) {
				// `[T; N]`: an exact-size inline array.
				name = "InlineArray"
				generics.push(self.generic_argument())
				if self.is_failed() { return dummy_type() }
			}
			self.consume(kind: .right_bracket)
			let base = TypeAnnotation(kind: .nominal(name, -1, -1, generics), start: start_tok.span.lower, end: self.span_end())
			return self.nominal_type_path(base: base)
		}
		if self.did_match(kind: .left_brace) {
			let fields: [RecordFieldTypeAnnotation] = []
			loop self.did_match(kind: .right_brace) == false {
				if self.is_failed() { break }
				let field_tok = self.current()
				let label_tok = self.identifier_token()
				let label = self.lexeme(token: label_tok)
				if self.is_failed() { break }
				self.consume(kind: .colon)
				let value = self.type_annotation()
				if self.is_failed() { break }
				fields.push(RecordFieldTypeAnnotation(label: label, label_start: label_tok.lexeme.lower, label_end: label_tok.lexeme.upper, value: value, start: field_tok.span.lower, end: self.span_end()))
				self.did_match(kind: .comma)
			}
			return TypeAnnotation(kind: .record_type(fields), start: start_tok.span.lower, end: self.span_end())
		}
		let name_tok = self.identifier_token()
		let name = self.lexeme(token: name_tok)
		if self.is_failed() { return dummy_type() }
		loop self.did_match(kind: .double_colon) {
			name = name + "::" + self.identifier()
			if self.is_failed() { return dummy_type() }
		}
		let generics: [GenericArg] = []
		if self.angle_generic_args_allowed() && self.did_match(kind: .less) {
			generics = self.generic_args_list()
			if self.is_failed() { return dummy_type() }
		}
		let base = TypeAnnotation(kind: .nominal(name, name_tok.lexeme.lower, name_tok.lexeme.upper, generics), start: start_tok.span.lower, end: self.span_end())
		self.nominal_type_path(base: base)
	}

	// Whether `<` at the cursor opens a generic-argument list; see
	// `angle_adjacency`.
	func angle_generic_args_allowed() -> Bool {
		if self.angle_adjacency == false { return true }
		if self.pos == 0 { return true }
		let cur = self.current()
		if cur.kind == .less {
			return self.token_at(index: self.pos - 1).span.upper == cur.span.lower
		}
		true
	}

	mut func generic_args_list() -> [GenericArg] {
		let args: [GenericArg] = []
		loop self.did_match_generic_close() == false {
			if self.is_failed() { return args }
			args.push(self.generic_argument())
			if self.is_failed() { return args }
			self.did_match(kind: .comma)
		}
		args
	}

	// Dotted member chains off a nominal (`Array<Int>.Iterator`). The
	// path node's span starts at the member — the reference pushes its
	// source location after the dot.
	mut func nominal_type_path(consume base: TypeAnnotation) -> TypeAnnotation {
		if self.did_match(kind: .dot) == false { return base }
		loop true {
			let span_tok = self.current()
			let member_tok = self.identifier_token()
			let member = self.lexeme(token: member_tok)
			if self.is_failed() { return base }
			let member_generics: [GenericArg] = []
			if self.angle_generic_args_allowed() && self.did_match(kind: .less) {
				member_generics = self.generic_args_list()
				if self.is_failed() { return base }
			}
			base = TypeAnnotation(kind: .nominal_path([base], member, member_tok.span.lower, member_tok.span.upper, member_generics), start: span_tok.span.lower, end: self.span_end())
			if self.did_match(kind: .dot) {
				// Next path segment.
			} else {
				return base
			}
		}
		base
	}

	// The tail of a parenthesized type — a func type or tuple — with the
	// opening `(` already consumed and `initial` elements already parsed.
	// `closed` marks the `)` as consumed too.
	mut func finish_paren_type(start: Int, consume modes: [TypeParamMode], consume types: [TypeAnnotation], closed: Bool, borrow_by_default: Bool) -> TypeAnnotation {
		let saw_mode = false
		if closed == false {
			loop self.did_match(kind: .right_paren) == false {
				if self.is_failed() { return dummy_type() }
				let (mode, annotation) = self.func_type_param()
				if self.is_failed() { return dummy_type() }
				if mode == .unadorned { } else { saw_mode = true }
				modes.push(mode)
				types.push(annotation)
				self.did_match(kind: .comma)
			}
		}
		let has_effects = self.peek_is(kind: .single_quote) || self.peek_is(kind: .effect_name)
		let effects = self.effect_set()
		if self.is_failed() { return dummy_type() }
		if self.did_match(kind: .arrow) {
			let ret = self.type_annotation()
			if self.is_failed() { return dummy_type() }
			let params: [TypeAnnotation] = []
			let i = 0
			for annotation in consume types {
				if borrow_by_default {
					params.push(self.apply_type_param_mode(mode_index: i, modes: modes, annotation: annotation))
				} else {
					params.push(annotation)
				}
				i = i + 1
			}
			return TypeAnnotation(kind: .func_type(params, effects, [ret]), start: start, end: self.span_end())
		}
		if has_effects || saw_mode {
			self.fail_expected(kind: .arrow)
			return dummy_type()
		}
		TypeAnnotation(kind: .tuple(types), start: start, end: self.span_end())
	}

	// Resolve a parameter's mode onto its annotation (ADR 0018,
	// borrow-by-default): unadorned becomes a shared borrow, `mut` an
	// exclusive borrow, `consume` stays bare; a mode on an annotation
	// that already spells a borrow is a conflict.
	mut func apply_type_param_mode(mode_index: Int, modes: &[TypeParamMode], consume annotation: TypeAnnotation) -> TypeAnnotation {
		let mode = modes[mode_index]
		let moded = mode == .mut_mode || mode == .consume_mode || mode == .consume_mut_mode
		if moded && is_borrow_annotation(annotation: annotation) {
			self.fail(code: "parser.param-mode-borrow-conflict", message: "Parameter mode `" + mode_keyword(mode: mode) + "` conflicts with its type: the annotation is already a borrow. The mode decides borrowing — drop the `&` from the annotation, or drop the mode")
			return annotation
		}
		if mode == .consume_mode || mode == .consume_mut_mode { return annotation }
		if is_borrow_annotation(annotation: annotation) { return annotation }
		let mutable = mode == .mut_mode
		let s = annotation.start
		let e = annotation.end
		TypeAnnotation(kind: .borrow(mutable, [annotation]), start: s, end: e)
	}

	// A function-type parameter's optional ownership-mode prefix.
	mut func func_type_param() -> (TypeParamMode, TypeAnnotation) {
		self.skip_semicolons_and_newlines()
		if self.peek_is(kind: .keyword_mut) {
			self.consume(kind: .keyword_mut)
			return (.mut_mode, self.type_annotation())
		}
		let cur = self.current()
		if cur.kind == .identifier && self.lexeme(token: cur) == "consume" && self.next_starts_type_annotation() {
			self.advance()
			if self.did_match(kind: .keyword_mut) {
				return (.consume_mut_mode, self.type_annotation())
			}
			return (.consume_mode, self.type_annotation())
		}
		(.unadorned, self.type_annotation())
	}

	func next_starts_type_annotation() -> Bool {
		let k = self.next_kind()
		if k == .identifier || k == .keyword_mut || k == .amp || k == .star { return true }
		if k == .left_paren || k == .left_brace || k == .left_bracket || k == .keyword_any { return true }
		false
	}

	// A declared effect row: `'[a, b]`, `'[..]`, a single `'name`, or
	// the open default when nothing is spelled.
	mut func effect_set() -> EffectSet {
		let names: [String] = []
		let name_starts: [Int] = []
		let name_ends: [Int] = []
		let open = false
		if self.peek_is(kind: .single_quote) {
			self.advance()
			self.consume(kind: .left_bracket)
			loop true {
				if self.did_match(kind: .right_bracket) { break }
				if self.did_match(kind: .eof) { break }
				if self.is_failed() { break }
				self.skip_semicolons_and_newlines()
				let cur = self.current()
				if cur.kind == .identifier || cur.kind == .keyword_use {
					let name_tok = self.identifier_token()
					names.push(self.lexeme(token: name_tok))
					name_starts.push(name_tok.lexeme.lower)
					name_ends.push(name_tok.lexeme.upper)
					let _ = self.did_match(kind: .comma)
				} else if self.did_match(kind: .dot_dot) {
					open = true
				} else {
					self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected an effect name, got " + describe_kind(kind: cur.kind))
					break
				}
			}
			return EffectSet(names: names, name_starts: name_starts, name_ends: name_ends, open: open)
		}
		if self.peek_is(kind: .effect_name) {
			let cur = self.current()
			self.advance()
			names.push(self.lexeme(token: cur))
			name_starts.push(cur.lexeme.lower)
			name_ends.push(cur.lexeme.upper)
			return EffectSet(names: names, name_starts: name_starts, name_ends: name_ends, open: false)
		}
		EffectSet(names: names, name_starts: name_starts, name_ends: name_ends, open: true)
	}

	// `any P<Assoc = T>`: the `any` keyword is already consumed.
	mut func any_type_annotation(start: Int) -> TypeAnnotation {
		let head_tok = self.current()
		let head_name_tok = self.identifier_token()
		let head_name = self.lexeme(token: head_name_tok)
		if self.is_failed() { return dummy_type() }
		let no_generics: [GenericArg] = []
		let head = TypeAnnotation(kind: .nominal(head_name, head_name_tok.lexeme.lower, head_name_tok.lexeme.upper, no_generics), start: head_tok.span.lower, end: self.span_end())
		loop self.did_match(kind: .dot) {
			let member_tok = self.current()
			let member_name_tok = self.identifier_token()
			let member = self.lexeme(token: member_name_tok)
			if self.is_failed() { return dummy_type() }
			let no_member_generics: [GenericArg] = []
			head = TypeAnnotation(kind: .nominal_path([head], member, member_name_tok.lexeme.lower, member_name_tok.lexeme.upper, no_member_generics), start: member_tok.span.lower, end: self.span_end())
		}
		let bindings: [AnyAssocBinding] = []
		if self.did_match(kind: .less) {
			loop self.did_match_generic_close() == false {
				if self.is_failed() { break }
				let binding_tok = self.current()
				let binding_name_tok = self.identifier_token()
				let binding_name = self.lexeme(token: binding_name_tok)
				if self.is_failed() { break }
				self.consume(kind: .equals)
				let value = self.type_annotation()
				if self.is_failed() { break }
				bindings.push(AnyAssocBinding(name: binding_name, name_start: binding_name_tok.lexeme.lower, name_end: binding_name_tok.lexeme.upper, value: value, start: binding_tok.span.lower, end: self.span_end()))
				self.did_match(kind: .comma)
			}
		}
		TypeAnnotation(kind: .any_type([head], bindings), start: start, end: self.span_end())
	}

	// One generic argument or static-predicate operand (ADR 0035). A
	// literal or arithmetic form is a static expression; anything else
	// parses as a type annotation — and if arithmetic FOLLOWS it, the
	// annotation becomes the name-like left operand of a static
	// expression (`N + 1`).
	mut func generic_argument() -> GenericArg {
		if self.starts_static_literal() || self.peek_is(kind: .dot) {
			return .static_arg(self.static_expr())
		}
		if self.peek_is(kind: .left_paren) {
			return self.parenthesized_generic_argument()
		}
		let annotation = self.type_annotation()
		if self.is_failed() { return .type_arg(annotation) }
		if self.peek_is(kind: .plus) || self.peek_is(kind: .minus) || self.peek_is(kind: .star) {
			let lhs = self.static_path_node(annotation: annotation)
			return .static_arg(self.static_expr_from(lhs: lhs))
		}
		.type_arg(annotation)
	}

	// The static index language (ADR 0035 §3): `+`/`-` over terms, terms
	// are `*` over primaries.
	mut func static_expr() -> StaticExpr {
		let lhs = self.static_expr_term()
		if self.is_failed() { return dummy_static_expr() }
		self.static_expr_from(lhs: lhs)
	}

	// Continue `*`, then `+`/`-` chains after an already-parsed left
	// operand (`N * 2 + 1` arrives here with `N` alone parsed).
	mut func static_expr_from(consume lhs: StaticExpr) -> StaticExpr {
		loop self.did_match(kind: .star) {
			let rhs = self.static_expr_primary()
			if self.is_failed() { return dummy_static_expr() }
			lhs = static_op_node(op: .mul, lhs: lhs, rhs: rhs, end: self.span_end())
		}
		loop true {
			let is_add = self.did_match(kind: .plus)
			let is_sub = false
			if is_add == false {
				is_sub = self.did_match(kind: .minus)
			}
			if is_add == false && is_sub == false { break }
			let rhs = self.static_expr_term()
			if self.is_failed() { return dummy_static_expr() }
			let op: StaticOpKind = .add
			if is_sub { op = .sub }
			lhs = static_op_node(op: op, lhs: lhs, rhs: rhs, end: self.span_end())
		}
		lhs
	}

	mut func static_expr_term() -> StaticExpr {
		let lhs = self.static_expr_primary()
		if self.is_failed() { return dummy_static_expr() }
		loop self.did_match(kind: .star) {
			let rhs = self.static_expr_primary()
			if self.is_failed() { return dummy_static_expr() }
			lhs = static_op_node(op: .mul, lhs: lhs, rhs: rhs, end: self.span_end())
		}
		lhs
	}

	mut func static_expr_primary() -> StaticExpr {
		let cur = self.current()
		if cur.kind == .int_number {
			self.advance()
			return StaticExpr(kind: .int_literal(self.lexeme(token: cur)), start: cur.span.lower, end: self.span_end())
		}
		if cur.kind == .keyword_true || cur.kind == .keyword_false {
			self.advance()
			return StaticExpr(kind: .bool_literal(cur.kind == .keyword_true), start: cur.span.lower, end: self.span_end())
		}
		if cur.kind == .dot {
			self.advance()
			let name_tok = self.identifier_token()
			let name = self.lexeme(token: name_tok)
			if self.is_failed() { return dummy_static_expr() }
			return StaticExpr(kind: .unqualified_case(name, name_tok.lexeme.lower, name_tok.lexeme.upper), start: cur.span.lower, end: self.span_end())
		}
		// In committed static context `(` is grouping, not a tuple type.
		if cur.kind == .left_paren {
			self.advance()
			let inner = self.static_expr()
			if self.is_failed() { return dummy_static_expr() }
			self.consume(kind: .right_paren)
			if self.is_failed() { return dummy_static_expr() }
			return StaticExpr(kind: .static_group([inner]), start: cur.span.lower, end: self.span_end())
		}
		let annotation = self.type_annotation()
		if self.is_failed() { return dummy_static_expr() }
		self.static_path_node(annotation: annotation)
	}

	// Wrap an already-parsed annotation as a static Path operand.
	mut func static_path_node(consume annotation: TypeAnnotation) -> StaticExpr {
		let start = annotation.start
		StaticExpr(kind: .static_path(annotation), start: start, end: self.span_end())
	}

	func starts_static_literal() -> Bool {
		let k = self.current().kind
		k == .int_number || k == .keyword_true || k == .keyword_false
	}

	// `(` in generic-argument position: a static group (`(2 + 2)`,
	// `(N + 1) * 2`), a parenthesized type, a tuple type, or a function
	// type.
	mut func parenthesized_generic_argument() -> GenericArg {
		let start_tok = self.current()
		self.consume(kind: .left_paren)
		let mode_led = self.current().kind == .identifier && self.lexeme(token: self.current()) == "consume" && self.next_starts_type_annotation()
		if self.peek_is(kind: .right_paren) || self.peek_is(kind: .keyword_mut) || mode_led {
			let no_modes: [TypeParamMode] = []
			let no_types: [TypeAnnotation] = []
			let annotation = self.finish_paren_type(start: start_tok.span.lower, modes: no_modes, types: no_types, closed: false, borrow_by_default: true)
			return .type_arg(self.optional_sugar(base: annotation))
		}
		let inner = self.generic_argument()
		if self.is_failed() { return .type_arg(dummy_type()) }
		let annotation = dummy_type()
		match inner {
			.static_arg(expr) -> {
				self.consume(kind: .right_paren)
				if self.is_failed() { return .type_arg(dummy_type()) }
				let group = StaticExpr(kind: .static_group([expr]), start: start_tok.span.lower, end: self.span_end())
				return .static_arg(self.static_expr_from(lhs: group))
			},
			.type_arg(value) -> { annotation = value }
		}
		if self.did_match(kind: .comma) {
			let modes: [TypeParamMode] = [.unadorned]
			let types: [TypeAnnotation] = [annotation]
			let full = self.finish_paren_type(start: start_tok.span.lower, modes: modes, types: types, closed: false, borrow_by_default: true)
			return .type_arg(self.optional_sugar(base: full))
		}
		self.consume(kind: .right_paren)
		if self.peek_is(kind: .plus) || self.peek_is(kind: .minus) || self.peek_is(kind: .star) {
			// `(N) * 2`: the parenthesized name was a static operand
			// after all.
			let path = self.static_path_node(annotation: annotation)
			let group = StaticExpr(kind: .static_group([path]), start: start_tok.span.lower, end: self.span_end())
			return .static_arg(self.static_expr_from(lhs: group))
		}
		// `(A) -> B` (and effect rows) are single-parameter function
		// types; a bare `(A)` is the 1-tuple spelling.
		let modes: [TypeParamMode] = [.unadorned]
		let types: [TypeAnnotation] = [annotation]
		let full = self.finish_paren_type(start: start_tok.span.lower, modes: modes, types: types, closed: true, borrow_by_default: true)
		return .type_arg(self.optional_sugar(base: full))
	}

	mut func import_decl() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_use)
		let path_start = self.current().span.lower
		let (path, local) = self.module_path()
		// Reference quirk: the path span ends at the START of the token
		// after the path.
		let path_end = self.current().span.lower
		let symbols: ImportedSymbols = .all
		if self.peek_is(kind: .double_colon) && self.next_kind() == .star {
			self.consume(kind: .double_colon)
			self.consume(kind: .star)
			symbols = .glob
		}
		if self.peek_is(kind: .double_colon) && self.next_kind() == .left_brace {
			self.consume(kind: .double_colon)
			self.consume(kind: .left_brace)
			let names: [ImportedSymbol] = []
			loop self.peek_is(kind: .right_brace) == false {
				if self.is_failed() { break }
				let name_tok = self.identifier_token()
				let name = self.lexeme(token: name_tok)
				let alias: String? = .none
				if self.did_match(kind: .keyword_as) {
					alias = .some(self.identifier())
				}
				names.push(ImportedSymbol(name: name, name_start: name_tok.lexeme.lower, name_end: name_tok.lexeme.upper, alias: alias))
				if self.did_match(kind: .comma) == false { break }
			}
			self.consume(kind: .right_brace)
			symbols = .named(names)
		}
		Decl(kind: .import_decl(Import(symbols: symbols, path: path, path_start: path_start, path_end: path_end, local: local)), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	// The dotted module path and whether its head names a local root
	// (`package`, `self`, `super`).
	mut func module_path() -> (String, Bool) {
		let head = self.identifier()
		let path = head
		loop self.peek_is(kind: .double_colon) && self.next_kind() != .left_brace && self.next_kind() != .star {
			self.consume(kind: .double_colon)
			path = path + "::" + self.identifier()
		}
		let local = head == "package" || head == "self" || head == "super"
		(path, local)
	}

	// MARK: Declaration parsers

	// The shared func grammar (the reference `func`): in protocol bodies
	// a bodyless func is a requirement signature. The Func node's span
	// is its body's; the whole declaration's extents ride as meta.
	mut func func_parts(context: BlockContext, consume_func_keyword: Bool) -> DeclKind {
		let start_tok = self.current()
		if consume_func_keyword {
			self.consume(kind: .keyword_func)
			if self.is_failed() { return dummy_decl_kind() }
		}
		// An anonymous func gets the reference's synthetic
		// position-keyed name (the resolver recognizes `#fn_`).
		self.skip_semicolons_and_newlines()
		let cur = self.current()
		let name_start = cur.span.lower
		let name_end = cur.span.upper
		let name = ""
		if cur.kind == .identifier || cur.kind == .keyword_use {
			name_start = cur.lexeme.lower
			name_end = cur.lexeme.upper
			name = self.identifier()
		} else {
			let buf: [Byte] = []
			append(buf: buf, text: "#fn_")
			append_int(buf: buf, value: cur.span.lower)
			append(buf: buf, text: "_")
			append_int(buf: buf, value: cur.span.upper)
			name = String.from_bytes(bytes: buf)
		}
		let generics = self.generics_list()
		if self.is_failed() { return dummy_decl_kind() }
		self.consume(kind: .left_paren)
		if self.is_failed() { return dummy_decl_kind() }
		let params = self.parameters()
		if self.is_failed() { return dummy_decl_kind() }
		self.consume(kind: .right_paren)
		if self.is_failed() { return dummy_decl_kind() }
		let effects = self.effect_set()
		if self.is_failed() { return dummy_decl_kind() }
		let ret: TypeAnnotation? = .none
		if self.did_match(kind: .arrow) {
			ret = .some(self.type_annotation())
			if self.is_failed() { return dummy_decl_kind() }
		}
		let wc = self.where_clause()
		if self.is_failed() { return dummy_decl_kind() }
		if context == .protocol_body && self.peek_is(kind: .left_brace) == false {
			return .func_signature(FuncSignature(name: name, params: params, effects: effects, generics: generics, where_clause: wc, ret: ret, start: start_tok.span.lower, end: self.span_end()))
		}
		let body_start = self.current().span.lower
		self.consume(kind: .left_brace)
		if self.is_failed() { return dummy_decl_kind() }
		self.skip_newlines()
		let captures: [CaptureSpec] = []
		if self.peek_is(kind: .left_bracket) {
			// Probe because an ordinary function body may begin with an array
			// expression. Only a bracketed name list followed by `in` is a
			// capture list.
			let checkpoint = self.pos
			let log_mark = self.id_log.count
			let candidate = self.capture_specs()
			if self.is_failed() {
				self.pos = checkpoint
				self.failed = .none
				self.mark_probe(from: log_mark)
			} else if self.did_match(kind: .keyword_in) {
				captures = candidate
			} else {
				self.pos = checkpoint
				self.mark_probe(from: log_mark)
			}
		}
		let parsed_body = self.block(context: .func_body, consumes_left_brace: false)
		if self.is_failed() { return dummy_decl_kind() }
		let body = Block(params: parsed_body.params, body: parsed_body.body, start: body_start, end: parsed_body.end, copied: parsed_body.copied)
		let b_start = body.start
		let b_end = body.end
		return .func_decl(Func(name: name, name_start: name_start, name_end: name_end, effects: effects, generics: generics, captures: captures, where_clause: wc, params: params, body: body, ret: ret, start: b_start, end: b_end, meta_start: start_tok.span.lower, meta_end: self.span_end()))
	}

	mut func func_decl_parse(context: BlockContext) -> Decl {
		let start_tok = self.current()
		let kind = self.func_parts(context: context, consume_func_keyword: true)
		if self.is_failed() { return dummy_decl() }
		Decl(kind: kind, is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	mut func func_expr_prefix() -> Expr {
		let start_tok = self.current()
		let kind = self.func_parts(context: .plain, consume_func_keyword: true)
		if self.is_failed() { return dummy_expr() }
		match kind {
			.func_decl(f) -> Expr(kind: .func_expr(f), start: start_tok.span.lower, end: self.span_end()),
			_ -> {
				self.fail(code: "parser.incomplete-function-signature", message: "func must have a body")
				dummy_expr()
			}
		}
	}

	mut func method_decl(context: BlockContext, is_static: Bool, receiver: ReceiverMode) -> Decl {
		let start_tok = self.current()
		let kind = self.func_parts(context: context, consume_func_keyword: true)
		if self.is_failed() { return dummy_decl() }
		let d_end = self.span_end()
		match kind {
			.func_decl(f) -> {
				self.reject_explicit_self(params: f.params, is_static: is_static)
				if self.is_failed() { return dummy_decl() }
				Decl(kind: .method(f, is_static, receiver), is_public: false, start: start_tok.span.lower, end: d_end)
			},
			.func_signature(sig) -> {
				self.reject_explicit_self(params: sig.params, is_static: is_static)
				if self.is_failed() { return dummy_decl() }
				Decl(kind: .method_requirement(sig, receiver), is_public: false, start: start_tok.span.lower, end: d_end)
			},
			_ -> dummy_decl()
		}
	}

	mut func method_decl_with_mode(context: BlockContext, is_static: Bool, receiver: ReceiverMode) -> Decl {
		if context_is_nominal(context: context) == false {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected method declaration, got " + describe_kind(kind: self.current().kind))
			return dummy_decl()
		}
		if is_static {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected instance method receiver modifier, got " + describe_kind(kind: self.current().kind))
			return dummy_decl()
		}
		self.method_decl(context: context, is_static: is_static, receiver: receiver)
	}

	// Methods never declare `self`; the receiver mode keyword does.
	mut func reject_explicit_self(params: &[Parameter], is_static: Bool) -> Void {
		if is_static { return () }
		if params.count == 0 { return () }
		if params[0].name == "self" {
			let start = params[0].label_start
			if start < 0 { start = params[0].name_start }
			self.fail_at(code: "parser.explicit-self-parameter", message: "Methods do not declare `self`; use `func`, `mut func`, or `consuming func`", start: start, end: params[0].end)
		}
	}

	mut func init_decl_parse() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_init)
		self.consume(kind: .left_paren)
		if self.is_failed() { return dummy_decl() }
		let params = self.parameters()
		if self.is_failed() { return dummy_decl() }
		self.consume(kind: .right_paren)
		if self.is_failed() { return dummy_decl() }
		let body = self.block(context: .func_body, consumes_left_brace: true)
		if self.is_failed() { return dummy_decl() }
		Decl(kind: .init_decl(params, body), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	// A protocol initializer requirement: `init(params)` with no body.
	mut func init_requirement_parse() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_init)
		self.consume(kind: .left_paren)
		if self.is_failed() { return dummy_decl() }
		let params = self.parameters()
		if self.is_failed() { return dummy_decl() }
		self.consume(kind: .right_paren)
		if self.is_failed() { return dummy_decl() }
		if self.peek_is(kind: .left_brace) {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected an init requirement without a body, got `{`")
			return dummy_decl()
		}
		let no_generics: [GenericDecl] = []
		let no_wc: WhereClause? = .none
		let no_ret: TypeAnnotation? = .none
		let no_names: [String] = []
		let no_spans: [Int] = []
		let sig = FuncSignature(name: "init", params: params, effects: EffectSet(names: no_names, name_starts: no_spans, name_ends: no_spans, open: true), generics: no_generics, where_clause: no_wc, ret: no_ret, start: start_tok.span.lower, end: self.span_end())
		Decl(kind: .init_requirement(sig), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	mut func property_decl(is_static: Bool) -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_let)
		let name_tok = self.identifier_token()
		let name = self.lexeme(token: name_tok)
		if self.is_failed() { return dummy_decl() }
		let annotation: TypeAnnotation? = .none
		if self.did_match(kind: .colon) {
			annotation = .some(self.type_annotation())
			if self.is_failed() { return dummy_decl() }
		}
		let default_value: Expr? = .none
		if self.did_match(kind: .equals) {
			default_value = .some(self.require_expr(e: self.expr()))
			if self.is_failed() { return dummy_decl() }
		}
		Decl(kind: .property(name, name_tok.lexeme.lower, name_tok.lexeme.upper, is_static, annotation, default_value), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	mut func variant_decl(expect_case: Bool) -> Decl {
		let start_tok = self.current()
		if expect_case {
			self.consume(kind: .keyword_case)
		}
		let name_tok = self.identifier_token()
		let name = self.lexeme(token: name_tok)
		if self.is_failed() { return dummy_decl() }
		let generics = self.generics_list()
		if self.is_failed() { return dummy_decl() }
		let payloads: [TypeAnnotation] = []
		let labels: [String?] = []
		if self.did_match(kind: .left_paren) {
			loop self.did_match(kind: .right_paren) == false {
				if self.is_failed() { return dummy_decl() }
				if self.peek_is(kind: .identifier) && self.next_kind() == .colon {
					let label = self.identifier()
					self.consume(kind: .colon)
					payloads.push(self.type_annotation())
					labels.push(.some(label))
				} else {
					payloads.push(self.type_annotation())
					labels.push(.none)
				}
				if self.is_failed() { return dummy_decl() }
				let _ = self.did_match(kind: .comma)
			}
		}
		let result: TypeAnnotation? = .none
		if self.did_match(kind: .arrow) {
			result = .some(self.type_annotation())
			if self.is_failed() { return dummy_decl() }
		}
		Decl(kind: .enum_variant(name, name_tok.lexeme.lower, name_tok.lexeme.upper, generics, payloads, labels, result), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	mut func nominal_decl(entry: TokenKind, context: BlockContext) -> Decl {
		let start_tok = self.current()
		self.consume(kind: entry)
		let name_tok = self.identifier_token()
		let name = self.lexeme(token: name_tok)
		if self.is_failed() { return dummy_decl() }
		let generics = self.generics_list()
		if self.is_failed() { return dummy_decl() }
		// Tick-suffix declaration attributes: `struct Node 'heap { … }`,
		// `struct Token 'linear { … }`.
		let is_linear = false
		let is_heap = false
		loop self.peek_is(kind: .effect_name) {
			let attr_tok = self.current()
			self.advance()
			let attribute = self.lexeme(token: attr_tok)
			if attribute == "linear" {
				is_linear = true
			} else if attribute == "heap" {
				is_heap = true
			} else {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a declaration attribute ('heap or 'linear), got " + describe_kind(kind: .effect_name))
				return dummy_decl()
			}
		}
		if is_linear && is_heap {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected at most one of 'heap and 'linear (aliased references cannot be consumed exactly once), got " + describe_kind(kind: self.current().kind))
			return dummy_decl()
		}
		let conformances: [TypeAnnotation] = []
		if self.did_match(kind: .colon) {
			if context == .protocol_body {
				conformances = self.conformances_list()
				if self.is_failed() { return dummy_decl() }
			} else {
				let what = if context == .struct_body { "struct" } else { "enum" }
				self.fail(code: "parser.conformance-list-not-allowed", message: "Cannot declare conformances on " + what + "; use an `extend` block instead")
				return dummy_decl()
			}
		}
		let wc = self.where_clause()
		if self.is_failed() { return dummy_decl() }
		let body = self.body_parse(context: context)
		if self.is_failed() { return dummy_decl() }
		let d_end = self.span_end()
		if context == .enum_body {
			return Decl(kind: .enum_decl(name, name_tok.lexeme.lower, name_tok.lexeme.upper, generics, wc, body, is_linear, is_heap), is_public: false, start: start_tok.span.lower, end: d_end)
		}
		if context == .struct_body {
			return Decl(kind: .struct_decl(name, name_tok.lexeme.lower, name_tok.lexeme.upper, generics, wc, body, is_linear, is_heap), is_public: false, start: start_tok.span.lower, end: d_end)
		}
		Decl(kind: .protocol_decl(name, name_tok.lexeme.lower, name_tok.lexeme.upper, generics, wc, body, conformances), is_public: false, start: start_tok.span.lower, end: d_end)
	}

	mut func extend_parse() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_extend)
		let binders = self.generics_list()
		if self.is_failed() { return dummy_decl() }
		let head = self.type_application()
		if self.is_failed() { return dummy_decl() }
		let conformances: [TypeAnnotation] = []
		if self.did_match(kind: .colon) {
			conformances = self.conformances_list()
			if self.is_failed() { return dummy_decl() }
		}
		let wc = self.where_clause()
		if self.is_failed() { return dummy_decl() }
		let body = self.body_parse(context: .extend_body)
		if self.is_failed() { return dummy_decl() }
		Decl(kind: .extend_decl(binders, head, conformances, wc, body), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	// A nominal application (`Name<Args>`): the extension head grammar —
	// sugar and non-nominal forms fail at the offending token.
	mut func type_application() -> TypeApplication {
		let start_tok = self.current()
		let name_tok = self.identifier_token()
		let name = self.lexeme(token: name_tok)
		if self.is_failed() {
			let no_args: [GenericArg] = []
			return TypeApplication(name: "", name_start: -1, name_end: -1, args: no_args, start: 0, end: 0)
		}
		loop self.did_match(kind: .double_colon) {
			name = name + "::" + self.identifier()
			if self.is_failed() {
				let no_args: [GenericArg] = []
				return TypeApplication(name: "", name_start: -1, name_end: -1, args: no_args, start: 0, end: 0)
			}
		}
		let args: [GenericArg] = []
		if self.did_match(kind: .less) {
			args = self.generic_args_list()
		}
		TypeApplication(name: name, name_start: name_tok.lexeme.lower, name_end: name_tok.lexeme.upper, args: args, start: start_tok.span.lower, end: self.span_end())
	}

	mut func typealias_parse() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_typealias)
		let name_tok = self.identifier_token()
		let name = self.lexeme(token: name_tok)
		if self.is_failed() { return dummy_decl() }
		self.consume(kind: .equals)
		if self.is_failed() { return dummy_decl() }
		let rhs = self.type_annotation()
		if self.is_failed() { return dummy_decl() }
		Decl(kind: .typealias_decl(name, name_tok.lexeme.lower, name_tok.lexeme.upper, rhs), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	mut func effect_decl_parse() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_effect)
		let name_tok = self.current()
		if name_tok.kind == .effect_name { } else {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected effect name (must start with '), got " + describe_kind(kind: name_tok.kind))
			return dummy_decl()
		}
		self.advance()
		let name = self.lexeme(token: name_tok)
		let generics = self.generics_list()
		if self.is_failed() { return dummy_decl() }
		self.consume(kind: .left_paren)
		if self.is_failed() { return dummy_decl() }
		let params = self.parameters()
		if self.is_failed() { return dummy_decl() }
		self.consume(kind: .right_paren)
		self.consume(kind: .arrow)
		if self.is_failed() { return dummy_decl() }
		let ret = self.type_annotation()
		if self.is_failed() { return dummy_decl() }
		let wc = self.where_clause()
		if self.is_failed() { return dummy_decl() }
		Decl(kind: .effect_decl(name, name_tok.lexeme.lower, name_tok.lexeme.upper, generics, wc, params, ret), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	mut func associated_parse() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_associated)
		let generic = self.generic_param()
		if self.is_failed() { return dummy_decl() }
		let wc = self.where_clause()
		if self.is_failed() { return dummy_decl() }
		Decl(kind: .associated_decl(generic, wc), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	// A module-local declarative macro rule (ADR 0026).
	mut func macro_decl_parse() -> Decl {
		let start_tok = self.current()
		self.consume(kind: .keyword_macro)
		let name_tok = self.identifier_token()
		let name = self.lexeme(token: name_tok)
		if self.is_failed() { return dummy_decl() }
		self.consume(kind: .left_paren)
		if self.is_failed() { return dummy_decl() }
		let params: [MacroParam] = []
		loop self.did_match(kind: .right_paren) == false {
			if self.is_failed() { return dummy_decl() }
			let param_tok = self.current()
			if param_tok.kind == .bound_var { } else {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected macro parameter such as `$value`, got " + describe_kind(kind: param_tok.kind))
				return dummy_decl()
			}
			let param_name = self.lexeme(token: param_tok)
			if macro_param_is_identifier_shaped(name: param_name) == false {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected identifier-shaped macro parameter, got " + describe_kind(kind: param_tok.kind))
				return dummy_decl()
			}
			self.advance()
			// Macro parameter spans include the `$` sigil.
			params.push(MacroParam(name: param_name, start: param_tok.span.lower, end: param_tok.span.upper))
			if self.did_match(kind: .right_paren) { break }
			self.consume(kind: .comma)
			if self.is_failed() { return dummy_decl() }
		}
		let open = self.current()
		if open.kind == .left_brace { } else {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected `{`, got " + describe_kind(kind: open.kind))
			return dummy_decl()
		}
		self.advance()
		// Balanced capture of the template body, mirroring macro_call(): the
		// body stays an unparsed token template until an invocation site's
		// category parses it.
		let expected: [TokenKind] = [.right_brace]
		let inner: [Token] = []
		let close = open
		loop expected.count > 0 {
			let token = self.current()
			if token.kind == .eof {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a closing macro delimiter, got end of input")
				return dummy_decl()
			}
			let nested_close: TokenKind?
			match token.kind {
				.left_paren -> nested_close = .some(.right_paren),
				.left_bracket -> nested_close = .some(.right_bracket),
				.left_brace -> nested_close = .some(.right_brace),
				_ -> nested_close = .none
			}
			if let .some(kind) = nested_close {
				expected.push(kind)
				inner.push(token)
				self.advance()
				continue
			}
			if token.kind == .right_paren || token.kind == .right_bracket || token.kind == .right_brace {
				let wanted = expected.pop()
				if let .some(kind) = wanted {
					if token.kind != kind {
						self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected " + describe_kind(kind: kind) + ", got " + describe_kind(kind: token.kind))
						return dummy_decl()
					}
				}
				close = token
				self.advance()
				if expected.count == 0 { break }
				inner.push(token)
				continue
			}
			inner.push(token)
			self.advance()
		}
		let canonical: [MacroToken] = [macro_token(token: open)]
		for token in inner { canonical.push(macro_token(token: token)) }
		canonical.push(macro_token(token: close))
		Decl(kind: .macro_decl(name, name_tok.lexeme.lower, name_tok.lexeme.upper, params, open.lexeme.upper, close.lexeme.lower, canonical), is_public: false, start: start_tok.span.lower, end: self.span_end())
	}

	// A nominal declaration's member list (the reference `body`): decls
	// only — a statement here is a conversion error.
	mut func body_parse(context: BlockContext) -> Body {
		self.skip_newlines()
		let start_tok = self.current()
		self.consume(kind: .left_brace)
		self.skip_semicolons_and_newlines()
		let decls: [Decl] = []
		loop self.did_match(kind: .right_brace) == false {
			if self.is_failed() { break }
			if context == .enum_body && self.peek_is(kind: .keyword_case) {
				decls.push(self.variant_decl(expect_case: true))
				if self.is_failed() { break }
				loop self.did_match(kind: .comma) {
					decls.push(self.variant_decl(expect_case: false))
					if self.is_failed() { break }
				}
				continue
			}
			if context == .protocol_body && self.peek_is(kind: .keyword_associated) {
				decls.push(self.associated_parse())
				continue
			}
			decls.push(self.require_decl(item: self.decl(context: context, is_static: false)))
			if self.is_failed() { break }
			self.skip_semicolons_and_newlines()
		}
		Body(decls: decls, start: start_tok.span.lower, end: self.span_end())
	}

	mut func require_decl(consume item: Item) -> Decl {
		match item {
			.decl_item(d) -> d,
			_ -> {
				self.fail(code: "parser.conversion", message: "could not convert node to Decl")
				dummy_decl()
			}
		}
	}

	// MARK: Generics and signatures

	// A `<`-opened generic PARAMETER list (`<T: Proto, U = Int>`).
	mut func generics_list() -> [GenericDecl] {
		let generics: [GenericDecl] = []
		if self.did_match(kind: .less) {
			loop true {
				if self.did_match_generic_close() { break }
				if self.did_match(kind: .eof) { break }
				generics.push(self.generic_param())
				if self.is_failed() { break }
				let _ = self.did_match(kind: .comma)
			}
		}
		generics
	}

	mut func generic_param() -> GenericDecl {
		let start_tok = self.current()
		// ADR 0035: `static N: Int` declares a static value parameter —
		// the colon introduces its declared value type, not a
		// conformance list. Static defaults (`= expr`) stay unported.
		if self.did_match(kind: .keyword_static) {
			let name_tok = self.identifier_token()
			let name = self.lexeme(token: name_tok)
			if self.is_failed() { return dummy_generic_decl() }
			if starts_uppercase(name: name) == false {
				self.fail(code: "parser.lowercase-static-parameter", message: "Static generic parameter `" + name + "` must begin with an uppercase letter")
				return dummy_generic_decl()
			}
			self.consume(kind: .colon)
			if self.is_failed() { return dummy_generic_decl() }
			let static_ty = self.type_annotation()
			if self.is_failed() { return dummy_generic_decl() }
			let default_value: GenericArg? = .none
			if self.did_match(kind: .equals) {
				default_value = .some(.static_arg(self.static_expr()))
				if self.is_failed() { return dummy_generic_decl() }
			}
			let no_generics: [GenericDecl] = []
			let no_conformances: [TypeAnnotation] = []
			return GenericDecl(name: name, name_start: name_tok.lexeme.lower, name_end: name_tok.lexeme.upper, generics: no_generics, conformances: no_conformances, default_value: default_value, static_ty: .some(static_ty), start: start_tok.span.lower, end: self.span_end())
		}
		let name_tok = self.identifier_token()
		let name = self.lexeme(token: name_tok)
		if self.is_failed() { return dummy_generic_decl() }
		let generics = self.generics_list()
		if self.is_failed() { return dummy_generic_decl() }
		let conformances: [TypeAnnotation] = []
		if self.did_match(kind: .colon) {
			conformances = self.conformances_list()
			if self.is_failed() { return dummy_generic_decl() }
		}
		let default_value: GenericArg? = .none
		if self.did_match(kind: .equals) {
			default_value = .some(.type_arg(self.type_annotation()))
			if self.is_failed() { return dummy_generic_decl() }
		}
		let no_static_ty: TypeAnnotation? = .none
		GenericDecl(name: name, name_start: name_tok.lexeme.lower, name_end: name_tok.lexeme.upper, generics: generics, conformances: conformances, default_value: default_value, static_ty: no_static_ty, start: start_tok.span.lower, end: self.span_end())
	}

	// A conformance list (`T: Foo & Bar`, `extend Box: Foo & Bar`):
	// `&`-separated, matching where-predicate style. A comma never
	// appears inside one, so in a generic parameter list it always
	// separates parameters.
	mut func conformances_list() -> [TypeAnnotation] {
		let list: [TypeAnnotation] = []
		loop true {
			list.push(self.type_annotation())
			if self.is_failed() { return list }
			if self.did_match(kind: .amp) == false { break }
		}
		list
	}

	mut func where_clause() -> WhereClause? {
		self.skip_newlines()
		let cur = self.current()
		if cur.kind == .identifier && self.lexeme(token: cur) == "where" { } else { return .none }
		self.advance()
		let predicates: [WherePredicate] = []
		loop true {
			predicates.push(self.where_predicate())
			if self.is_failed() { break }
			if self.did_match(kind: .amp_amp) == false { break }
		}
		.some(WhereClause(predicates: predicates, start: cur.span.lower, end: self.span_end()))
	}

	// In where-predicate operands `<` doubles as the static comparison
	// operator (ADR 0035), so a generic-argument list there must be
	// adjacent to its head (`Foo<Int>`, not `Foo < Int`).
	mut func where_predicate() -> WherePredicate {
		let saved = self.angle_adjacency
		self.angle_adjacency = true
		let result = self.where_predicate_restricted()
		self.angle_adjacency = saved
		result
	}

	mut func where_predicate_restricted() -> WherePredicate {
		let start_tok = self.current()
		let lhs = self.generic_argument()
		if self.is_failed() { return dummy_predicate() }
		if self.did_match(kind: .equals_equals) {
			let rhs = self.generic_argument()
			if self.is_failed() { return dummy_predicate() }
			return WherePredicate(kind: .type_eq(lhs, rhs), start: start_tok.span.lower, end: self.span_end())
		}
		if self.did_match(kind: .less) {
			let rhs = self.generic_argument()
			if self.is_failed() { return dummy_predicate() }
			return WherePredicate(kind: .static_cmp(true, lhs, rhs), start: start_tok.span.lower, end: self.span_end())
		}
		if self.did_match(kind: .less_equals) {
			let rhs = self.generic_argument()
			if self.is_failed() { return dummy_predicate() }
			return WherePredicate(kind: .static_cmp(false, lhs, rhs), start: start_tok.span.lower, end: self.span_end())
		}
		self.consume(kind: .colon)
		if self.is_failed() { return dummy_predicate() }
		let ty = dummy_type()
		match lhs {
			.type_arg(t) -> { ty = t },
			.static_arg(_) -> {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a type before `:` in a where predicate, got " + describe_kind(kind: self.current().kind))
				return dummy_predicate()
			}
		}
		let protocols: [TypeAnnotation] = [self.type_annotation()]
		if self.is_failed() { return dummy_predicate() }
		loop self.did_match(kind: .amp) {
			protocols.push(self.type_annotation())
			if self.is_failed() { return dummy_predicate() }
		}
		WherePredicate(kind: .conforms(ty, protocols), start: start_tok.span.lower, end: self.span_end())
	}

	// A declared parameter list (funcs, inits, effects). ADR 0041 labels:
	// a bare `name` is positional, `name:` uses the binder as its external
	// label, `_ name` is explicitly positional, and `foo fizz` separates
	// the external label from the local binder.
	mut func parameters() -> [Parameter] {
		let params: [Parameter] = []
		loop true {
			let (mode, mode_start, mode_end) = self.param_mode()
			let label: ParamLabel? = .none
			let label_start = -1
			let label_end = -1
			let name = ""
			let name_start = 0
			let name_end = 0
			let bare_name = false
			if self.peek_is(kind: .underscore) && self.next_kind() == .identifier {
				let underscore_tok = self.current()
				label_start = underscore_tok.lexeme.lower
				label_end = underscore_tok.lexeme.upper
				self.advance()
				self.skip_semicolons_and_newlines()
				let name_tok = self.current()
				name = self.identifier()
				name_start = name_tok.lexeme.lower
				name_end = name_tok.lexeme.upper
				label = .some(.omitted)
			} else {
				self.skip_semicolons_and_newlines()
				let first_tok = self.current()
				if first_tok.kind == .identifier || first_tok.kind == .keyword_use { } else {
					if let .some(_) = mode {
						// A mode keyword must be followed by a parameter name.
						self.fail(code: "parser.expected-identifier", message: "Expected an identifier, got " + describe_kind(kind: first_tok.kind))
						return params
					}
					break
				}
				let first = self.identifier()
				if self.peek_is(kind: .identifier) {
					// Mode keywords never read as external labels; a second
					// mode spelling here is a repeated/misordered mode.
					if first == "consume" || first == "borrow" {
						self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected parameter name, got an identifier")
						return params
					}
					let name_tok = self.current()
					name = self.identifier()
					name_start = name_tok.lexeme.lower
					name_end = name_tok.lexeme.upper
					label = .some(.named(first))
					label_start = first_tok.lexeme.lower
					label_end = first_tok.lexeme.upper
				} else {
					name = first
					name_start = first_tok.lexeme.lower
					name_end = first_tok.lexeme.upper
					bare_name = true
				}
			}
			let param_start = self.current().span.lower
			let annotation: TypeAnnotation? = .none
			if self.did_match(kind: .colon) {
				// On a one-name parameter the colon opts into using that name
				// as the external label. It may stand alone (`x:`) or also
				// introduce a type annotation (`x: Int`).
				if bare_name {
					label = .some(.named(name.clone()))
					label_start = name_start
					label_end = name_end
				}
				self.skip_newlines()
				let closes_untyped_label = bare_name && (self.peek_is(kind: .comma) || self.peek_is(kind: .right_paren))
				if closes_untyped_label == false {
					annotation = .some(self.type_annotation())
					if self.is_failed() { return params }
				}
			}
			params.push(Parameter(label: label, label_start: label_start, label_end: label_end, name: name, name_start: name_start, name_end: name_end, mode: mode, mode_start: mode_start, mode_end: mode_end, annotation: annotation, start: param_start, end: self.span_end()))
			if self.did_match(kind: .comma) { } else { break }
		}
		params
	}

	// A capture list at the start of a func body (`func() { [x, &y, copy z] in ... }`).
	mut func capture_specs() -> [CaptureSpec] {
		let captures: [CaptureSpec] = []
		if self.did_match(kind: .left_bracket) == false { return captures }
		loop true {
			if self.did_match(kind: .right_bracket) { break }
			if self.did_match(kind: .eof) { break }
			let mode: CaptureMode = .copy_capture
			if self.did_match(kind: .amp) {
				if self.did_match(kind: .keyword_mut) {
					mode = .borrow_mut
				} else {
					mode = .borrow_shared
				}
			} else if self.did_match(kind: .keyword_consuming) {
				mode = .move_capture
			} else {
				let cur = self.current()
				if cur.kind == .identifier && self.lexeme(token: cur) == "copy" {
					self.advance()
				}
			}
			self.skip_semicolons_and_newlines()
			let name_tok = self.current()
			let name = self.identifier()
			if self.is_failed() { break }
			captures.push(CaptureSpec(mode: mode, name: name, start: name_tok.lexeme.lower, end: name_tok.lexeme.upper))
			if self.did_match(kind: .right_bracket) { return captures }
			self.consume(kind: .comma)
			if self.is_failed() { break }
		}
		captures
	}

	// MARK: Compiler forms

	mut func compiler_prefix() -> Expr {
		let hash_tok = self.current()
		self.consume(kind: .hash)
		let name_tok = self.current()
		if name_tok.kind != .identifier {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a compiler form name, got " + describe_kind(kind: name_tok.kind))
			return dummy_expr()
		}
		self.advance()
		let name = self.lexeme(token: name_tok)
		if name == "_ir" {
			return self.inline_ir(start: hash_tok.span.lower)
		}
		if name == "unsafe" {
			let block = self.block(context: .plain, consumes_left_brace: true)
			if self.is_failed() { return dummy_expr() }
			return Expr(kind: .unsafe_expr(block), start: hash_tok.span.lower, end: self.span_end())
		}
		self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected #unsafe or #_ir, got #" + name)
		dummy_expr()
	}

	// `#_ir { %d = instr … }`: only the `cmp` operator error path is
	// exercised by the corpus; instruction success stays unported.
	// `#_ir(binds…) { %d = instr … }` (the reference `inline_ir`). The
	// node's span ends before the closing brace: the reference saves the
	// instruction's meta, then consumes the `}`.
	mut func inline_ir(start: Int) -> Expr {
		let binds: [Expr] = []
		if self.did_match(kind: .left_paren) {
			loop true {
				if self.did_match(kind: .right_paren) { break }
				if self.did_match(kind: .eof) { break }
				if self.is_failed() { return dummy_expr() }
				binds.push(self.require_expr(e: self.expr()))
				if self.is_failed() { return dummy_expr() }
				let _ = self.did_match(kind: .comma)
			}
		}
		self.consume(kind: .left_brace)
		if self.is_failed() { return dummy_expr() }
		let cur = self.current()
		let dest: String? = .none
		if cur.kind == .ir_register {
			dest = .some(self.lexeme(token: cur))
			self.advance()
			self.consume(kind: .equals)
			if self.is_failed() { return dummy_expr() }
		}
		let instr_tok = self.identifier_token()
		let instr = self.lexeme(token: instr_tok)
		if self.is_failed() { return dummy_expr() }
		let has_dest = false
		if let .some(_) = dest { has_dest = true }
		// (has type operand, value-operand count) per instruction; the
		// dest and dest-less tables are disjoint, like the reference's
		// two match blocks.
		let has_ty = false
		let value_count = -1
		if has_dest {
			if instr == "cmp" { has_ty = true; value_count = 0 }
			if instr == "add" || instr == "sub" || instr == "mul" || instr == "div" || instr == "and" || instr == "or" || instr == "xor" || instr == "shl" || instr == "shr" { has_ty = true; value_count = 2 }
			if instr == "not" || instr == "alloc" || instr == "load" || instr == "take" { has_ty = true; value_count = 1 }
			if instr == "gep" || instr == "inline_get" { has_ty = true; value_count = 2 }
			if instr == "io" { value_count = 4 }
			if instr == "trunc" || instr == "is_unique" || instr == "itof" || instr == "btoi" || instr == "itob" { value_count = 1 }
		} else {
			if instr == "store" || instr == "swap" { has_ty = true; value_count = 2 }
			if instr == "retain" { has_ty = true; value_count = 1 }
			if instr == "copy" { has_ty = true; value_count = 3 }
			if instr == "free" { value_count = 1 }
		}
		if value_count < 0 {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected supported #_ir instr, got " + instr)
			return dummy_expr()
		}
		let ty: TypeAnnotation? = .none
		if has_ty {
			ty = .some(self.type_annotation())
			if self.is_failed() { return dummy_expr() }
		}
		let op: TokenKind? = .none
		let values: [IRValue] = []
		if instr == "cmp" {
			values.push(self.ir_value())
			if self.is_failed() { return dummy_expr() }
			self.skip_semicolons_and_newlines()
			let op_tok = self.current()
			if op_tok.kind == .less || op_tok.kind == .bang_equals || op_tok.kind == .equals_equals || op_tok.kind == .less_equals || op_tok.kind == .greater || op_tok.kind == .greater_equals {
				self.advance()
				op = .some(op_tok.kind)
			} else {
				self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected one of `<`, `!=`, `==`, `<=`, `>`, `>=`, got " + describe_kind(kind: op_tok.kind))
				return dummy_expr()
			}
			values.push(self.ir_value())
			if self.is_failed() { return dummy_expr() }
		} else {
			let i = 0
			loop i < value_count {
				values.push(self.ir_value())
				if self.is_failed() { return dummy_expr() }
				i = i + 1
			}
		}
		let end = self.span_end()
		self.consume(kind: .right_brace)
		if self.is_failed() { return dummy_expr() }
		let instruction = IRInstruction(name: instr, name_start: instr_tok.lexeme.lower, name_end: instr_tok.lexeme.upper, dest: dest, ty: ty, values: values, op: op)
		Expr(kind: .inline_ir(binds, instruction), start: start, end: end)
	}

	mut func ir_value() -> IRValue {
		let cur = self.current()
		let k = cur.kind
		if k == .ir_register {
			if let .some(index) = parse_decimal(text: self.lexeme(token: cur)) {
				self.advance()
				return .reg(index)
			}
		}
		if k == .int_number {
			if let .some(value) = parse_decimal(text: self.lexeme(token: cur)) {
				self.advance()
				return .int_value(value)
			}
		}
		if k == .float_number {
			let text = self.lexeme(token: cur)
			self.advance()
			return .float_value(text)
		}
		if k == .keyword_true {
			self.advance()
			return .bool_value(true)
		}
		if k == .keyword_false {
			self.advance()
			return .bool_value(false)
		}
		if k == .bound_var {
			if let .some(index) = parse_decimal(text: self.lexeme(token: cur)) {
				self.advance()
				return .bind(index)
			}
		}
		if k == .identifier && self.lexeme(token: cur) == "void" {
			self.advance()
			return .void_value
		}
		self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected IR, got " + describe_kind(kind: k))
		return .void_value
	}

	// MARK: Roots

	mut func next_root() -> Item {
		if self.current().kind == .attribute {
			return .decl_item(self.macro_call_decl())
		}
		if is_decl_keyword(kind: self.current().kind) {
			return self.decl(context: .plain, is_static: false)
		}
		.stmt_item(self.stmt())
	}

	// Declaration dispatch: block bodies route through here directly
	// (unlike roots, which gate on `is_decl_keyword` first), so
	// non-keyword tokens fall through to statements.
	mut func decl(context: BlockContext, is_static: Bool) -> Item {
		self.skip_semicolons_and_newlines()
		let cur = self.current()
		let k = cur.kind
		if k == .attribute {
			return .decl_item(self.macro_call_decl())
		}
		if k == .keyword_pub {
			return self.pub_decl(context: context, is_static: is_static)
		}
		if k == .keyword_public {
			self.fail_at(code: "parser.legacy-public-modifier", message: "`public` was renamed to `pub`; replace `public` with `pub`", start: cur.span.lower, end: cur.span.upper)
			return .decl_item(dummy_decl())
		}
		if k == .keyword_linear {
			// The prefix form moved to a tick-suffix attribute.
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected `struct Name 'linear { ... }` (the `linear struct` prefix moved to a declaration attribute), got " + describe_kind(kind: k))
			return .decl_item(dummy_decl())
		}
		if k == .keyword_static {
			self.advance()
			return self.decl(context: context, is_static: true)
		}
		if k == .keyword_mut {
			self.advance()
			return .decl_item(self.method_decl_with_mode(context: context, is_static: is_static, receiver: .ref_receiver))
		}
		if k == .keyword_consuming {
			self.advance()
			return .decl_item(self.method_decl_with_mode(context: context, is_static: is_static, receiver: .consuming_receiver))
		}
		if k == .keyword_use {
			return .decl_item(self.import_decl())
		}
		if k == .keyword_macro {
			if context == .plain {
				return .decl_item(self.macro_decl_parse())
			}
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected a top-level macro declaration, got " + describe_kind(kind: k))
			return .decl_item(dummy_decl())
		}
		if k == .keyword_effect {
			return .decl_item(self.effect_decl_parse())
		}
		if k == .keyword_typealias {
			return .decl_item(self.typealias_parse())
		}
		if k == .keyword_protocol {
			return .decl_item(self.nominal_decl(entry: .keyword_protocol, context: .protocol_body))
		}
		if k == .keyword_enum {
			return .decl_item(self.nominal_decl(entry: .keyword_enum, context: .enum_body))
		}
		if k == .keyword_extend {
			return .decl_item(self.extend_parse())
		}
		if k == .keyword_struct {
			return .decl_item(self.nominal_decl(entry: .keyword_struct, context: .struct_body))
		}
		if k == .keyword_init {
			if context == .extend_body || context == .struct_body {
				return .decl_item(self.init_decl_parse())
			}
			if context == .protocol_body {
				return .decl_item(self.init_requirement_parse())
			}
			self.fail(code: "parser.init-not-allowed", message: "Cannot use `init` in this context")
			return .decl_item(dummy_decl())
		}
		if k == .keyword_case {
			return .decl_item(self.variant_decl(expect_case: true))
		}
		if k == .keyword_let {
			if context == .extend_body || context == .struct_body {
				return .decl_item(self.property_decl(is_static: is_static))
			}
			if context == .enum_body {
				self.fail(code: "parser.let-not-allowed", message: "Cannot use `let` in enum body")
				return .decl_item(dummy_decl())
			}
			return .decl_item(self.let_decl())
		}
		if k == .keyword_func {
			if context_is_nominal(context: context) {
				return .decl_item(self.method_decl(context: context, is_static: is_static, receiver: .none_receiver))
			}
			return .decl_item(self.func_decl_parse(context: context))
		}
		.stmt_item(self.stmt())
	}

	// ADR 0042's declaration matrix: which parsed declarations admit a
	// `pub` modifier in which body context.
	mut func pub_decl(context: BlockContext, is_static: Bool) -> Item {
		self.consume(kind: .keyword_pub)
		if self.peek_is(kind: .keyword_pub) || self.peek_is(kind: .keyword_public) {
			self.fail(code: "parser.repeated-visibility-modifier", message: "Repeated visibility modifier; write `pub` once")
			return .decl_item(dummy_decl())
		}
		let item = self.decl(context: context, is_static: is_static)
		if self.is_failed() { return item }
		match item {
			.decl_item(d) -> {
				self.check_pub_admitted(kind: d.kind, context: context)
				if self.is_failed() { return .decl_item(dummy_decl()) }
				let d_start = d.start
				let d_end = d.end
				return .decl_item(Decl(kind: d.kind, is_public: true, start: d_start, end: d_end))
			},
			_ -> {
				self.fail(code: "parser.visibility-not-allowed", message: "`pub` is not allowed on a statement")
				return .decl_item(dummy_decl())
			}
		}
	}

	mut func reject_pub(what: String) -> Void {
		self.fail(code: "parser.visibility-not-allowed", message: "`pub` is not allowed on " + what)
	}

	mut func check_pub_admitted(kind: &DeclKind, context: BlockContext) -> Void {
		match kind {
			.import_decl(_) -> self.reject_pub(what: "an import"),
			.extend_decl(_, _, _, _, _) -> self.reject_pub(what: "an extension"),
			.enum_variant(_, _, _, _, _, _, _) -> self.reject_pub(what: "an enum case"),
			.macro_decl(_, _, _, _, _, _, _) -> self.fail(code: "parser.macro-export-unsupported", message: "Macros cannot be exported; remove `pub`"),
			.associated_decl(_, _) -> self.reject_pub(what: "a protocol requirement"),
			.method_requirement(_, _) -> self.reject_pub(what: "a protocol requirement"),
			.init_requirement(_) -> self.reject_pub(what: "a protocol requirement"),
			_ -> {
				if context == .protocol_body {
					self.reject_pub(what: "a protocol member")
					return ()
				}
				match kind {
					.struct_decl(_, _, _, _, _, _, _, _) -> self.check_pub_context_nominal(context: context),
					.enum_decl(_, _, _, _, _, _, _, _) -> self.check_pub_context_nominal(context: context),
					.protocol_decl(_, _, _, _, _, _, _) -> self.check_pub_context_nominal(context: context),
					.typealias_decl(_, _, _, _) -> self.check_pub_context_nominal(context: context),
					.effect_decl(_, _, _, _, _, _, _) -> self.check_pub_context_nominal(context: context),
					.func_decl(_) -> self.check_pub_context_top(context: context),
					.func_signature(_) -> self.check_pub_context_top(context: context),
					.let_decl(_, _, _) -> self.check_pub_context_top(context: context),
					.property(_, _, _, _, _, _) -> self.check_pub_context_member(context: context),
					.method(_, _, _) -> self.check_pub_context_member(context: context),
					.init_decl(_, _) -> self.check_pub_context_member(context: context),
					_ -> {}
				}
			}
		}
	}

	// Nominal/alias/effect declarations: public at the top level or
	// nested in a nominal body.
	mut func check_pub_context_nominal(context: BlockContext) -> Void {
		if context == .plain || context == .struct_body || context == .enum_body || context == .extend_body { return () }
		self.reject_pub(what: "a local declaration")
	}

	// Funcs and lets: public at the top level only.
	mut func check_pub_context_top(context: BlockContext) -> Void {
		if context == .plain { return () }
		self.reject_pub(what: "a local declaration")
	}

	// Members: public inside a nominal body.
	mut func check_pub_context_member(context: BlockContext) -> Void {
		if context == .struct_body || context == .enum_body || context == .extend_body { return () }
		self.reject_pub(what: "a local declaration")
	}

	// `#handle 'effect { body }`: the statement span includes the `#`;
	// the recorded effect-name span uses the token's lexeme.
	mut func effect_handler() -> Stmt {
		let start_tok = self.current()
		self.advance()
		self.advance()
		let name_tok = self.current()
		if name_tok.kind == .effect_name {
			self.advance()
		} else {
			self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected effect name (must start with '), got " + describe_kind(kind: name_tok.kind))
			return dummy_stmt()
		}
		let body = self.block(context: .plain, consumes_left_brace: true)
		if self.is_failed() { return dummy_stmt() }
		Stmt(kind: .handle_stmt(self.lexeme(token: name_tok), name_tok.lexeme.lower, name_tok.lexeme.upper, body), start: start_tok.span.lower, end: self.span_end())
	}

	mut func stmt() -> Stmt {
		self.skip_semicolons_and_newlines()
		let cur = self.current()
		let k = cur.kind
		if k == .keyword_if { return self.if_stmt() }
		if k == .keyword_loop { return self.loop_stmt() }
		if k == .keyword_for { return self.for_stmt() }
		if k == .keyword_return { return self.return_stmt() }
		if k == .keyword_continue { return self.continue_stmt() }
		if k == .keyword_break {
			let start_tok = self.current()
			self.consume(kind: .keyword_break)
			return Stmt(kind: .break_stmt, start: start_tok.span.lower, end: self.span_end())
		}
		if k == .hash && self.next_kind() == .identifier && self.lexeme(token: self.token_at(index: self.pos + 1)) == "handle" {
			return self.effect_handler()
		}
		if k == .effect_name && self.lexeme(token: cur) == "continue" {
			return self.resume_stmt()
		}
		// An expression statement shares its expression's span — unless
		// the expression grammar parsed an assignment, which IS the
		// statement.
		let e = self.expr()
		if self.has_pending_assign() {
			if let .some(s) = self.assign_slot.pop() {
				return s
			}
		}
		let start = e.start
		let end = e.end
		Stmt(kind: .expr_stmt(e), start: start, end: end)
	}

	// The file/block-items category loop (the reference `parse_category`):
	// the stale `current` read before the skip drives both the progress
	// guard and the EOF check, faithfully to the reference quirk. Imports
	// are file-level only; the block-items category rejects them after
	// they parse.
	mut func parse_items(allow_imports: Bool) -> Void {
		self.skip_semicolons_and_newlines()
		let last_start = 0 - 1
		loop true {
			if self.is_failed() { return () }
			let stale = self.current()
			self.skip_semicolons_and_newlines()
			if stale.span.lower == last_start {
				self.fail(code: "parser.infinite-loop", message: "Parser failed to make forward progress at " + describe_kind(kind: stale.kind))
				return ()
			}
			last_start = stale.span.lower
			if stale.kind == .eof { return () }
			let item = self.next_root()
			if self.is_failed() { return () }
			if allow_imports == false && item_is_import(item: item) {
				self.fail(code: "parser.import-in-block-items", message: "imports are not allowed in block items")
				return ()
			}
			self.items.push(item)
			self.skip_semicolons_and_newlines()
		}
	}

	// The expression category (the reference `parse_expr`): one
	// expression owning the whole input. An assignment is a legal root
	// here — the reference pushes whatever node the expression grammar
	// produced.
	mut func parse_expr_root() -> Void {
		self.skip_semicolons_and_newlines()
		let root = self.expr()
		if self.is_failed() { return () }
		if self.has_pending_assign() {
			if let .some(s) = self.assign_slot.pop() {
				self.items.push(.stmt_item(s))
				self.require_end_of_input()
				return ()
			}
		}
		self.items.push(.expr_item(root))
		self.require_end_of_input()
	}

	// The pattern category (the reference `parse_pattern`).
	mut func parse_pattern_root() -> Void {
		self.skip_semicolons_and_newlines()
		let root = self.pattern()
		if self.is_failed() { return () }
		self.items.push(.pattern_item(root))
		self.require_end_of_input()
	}

	// The type category (the reference `parse_type`).
	mut func parse_type_root() -> Void {
		self.skip_semicolons_and_newlines()
		let root = self.type_annotation()
		if self.is_failed() { return () }
		self.items.push(.type_item(root))
		self.require_end_of_input()
	}

	// The declaration category used by procedural macros: exactly one
	// declaration owning the complete token range.
	mut func parse_decl_root() -> Void {
		self.skip_semicolons_and_newlines()
		let root = self.next_root()
		if self.is_failed() { return () }
		match root {
			.decl_item(decl) -> self.items.push(.decl_item(decl)),
			_ -> {
				self.fail(code: "parser.expected-declaration", message: "Expected a declaration")
				return ()
			}
		}
		self.require_end_of_input()
	}

	// A single-category parse owns the whole input: anything after the
	// category (beyond trailing newlines) is an error.
	mut func require_end_of_input() -> Void {
		self.skip_semicolons_and_newlines()
		if self.current().kind == .eof { return () }
		self.fail(code: "parser.unexpected-token", message: "Unexpected token: expected end of input, got " + describe_kind(kind: self.current().kind))
	}

	consuming func finish(consume comments: [Comment]) -> ParseOutcome {
		let failure = self.failed
		if let .some(message) = self.lex_error_message {
			// The reference reports the lex failure instead of the
			// downstream missing-token symptom whenever the parse pulled
			// tokens up to the truncation point (its 2-token lookahead),
			// and always when the parse otherwise succeeded.
			let masked = true
			if let .some(_) = failure {
				masked = self.pos + 1 >= self.token_count
			}
			if masked {
				let no_expected: TokenKind? = .none
				failure = .some(Fail(code: "parser.lexer", message: message, start: -1, end: -1, expected: no_expected))
			}
		}
		let (lines, cols) = token_positions(source: self.source, tokens: self.tokens)
		let ctx = MetaCtx(tokens: self.tokens, lines: lines, cols: cols, log: self.id_log, probe: self.id_log_probe)
		let metas: [NodeMeta] = []
		let claimed: [Bool] = []
		let i = 0
		loop i < ctx.log.count {
			claimed.push(false)
			i = i + 1
		}
		meta_items(ctx: ctx, metas: metas, claimed: claimed, live: true, items: self.items)
		ParseOutcome(items: self.items, failure: failure, diags: self.diags, comments: comments, metas: metas)
	}
}

func make_parser(source: String, tokens: [Token], input_span: Range<Int>, lex_error: String?) -> Parser {
	let owned_tokens: [Token] = []
	for token in tokens {
		owned_tokens.push(Token(kind: token.kind, span: token.span.lower..<token.span.upper, lexeme: token.lexeme.lower..<token.lexeme.upper))
	}
	let owned_error: String? = .none
	if let .some(message) = lex_error { owned_error = .some(message.clone()) }
	let token_count = owned_tokens.count
	let no_fail: Fail? = .none
	let no_diags: [Fail] = []
	let no_items: [Item] = []
	let contexts: [ParseContext] = [.top_level]
	let assign_slot: [Stmt] = []
	let no_log: [Token] = []
	let no_probe: [Bool] = []
	Parser(tokens: owned_tokens, token_count: token_count, source: source.clone(), input_span: input_span.lower..<input_span.upper, pos: 0, split_greater: false, failed: no_fail, diags: no_diags, items: no_items, contexts: contexts, assign_slot: assign_slot, angle_adjacency: false, lex_error_message: owned_error, id_log: no_log, id_log_probe: no_probe)
}

// A scan failure pre-renders its message; the token list is truncated
// at the failure point and the parse proceeds over what scanned.
func scan_parser(source: String, consume result: ScanResult) -> Parser {
	let lex_error: String? = .none
	if let .some(message) = result.error {
		lex_error = .some(lexer_error_message(source: source, pos: result.error_pos, message: message))
	}
	let source_len = source.utf8().count()
	make_parser(source: source, tokens: result.tokens, input_span: 0..<source_len, lex_error: lex_error)
}

// Build a parser over canonical tokens without lexing or rebuilding text.
// `input.span` supplies the owned extent, including EOF placement for an
// empty group body.
func token_parser(source: String, input: TokenRange) -> Parser {
	make_parser(source: source, tokens: input.tokens, input_span: input.span, lex_error: Optional.none)
}

// Parse a whole input as a file (ADR 0043 file category): block items
// plus file-level imports.
pub func parse_file_source(source: String) -> ParseOutcome {
	let result = scan(source: source)
	let comments = result.comments
	let parser = scan_parser(source: source, result: result)
	parser.parse_items(allow_imports: true)
	parser.finish(comments: comments)
}

// Parse a whole input as block items (ADR 0043 category entry).
pub func parse_block_items_source(source: String) -> ParseOutcome {
	let result = scan(source: source)
	let comments = result.comments
	let parser = scan_parser(source: source, result: result)
	parser.parse_items(allow_imports: false)
	parser.finish(comments: comments)
}

// Parse a whole input as nominal-body members (ADR 0026): the grammar
// struct and extension bodies use, so a macro expansion spliced into a
// declaration body yields member declarations — methods, not plain
// functions.
pub func parse_members_source(source: String) -> ParseOutcome {
	let result = scan(source: source)
	let comments = result.comments
	let parser = scan_parser(source: source, result: result)
	parser.skip_semicolons_and_newlines()
	loop parser.current().kind != .eof {
		if parser.is_failed() { break }
		let item = parser.decl(context: .struct_body, is_static: false)
		if parser.is_failed() { break }
		parser.items.push(item)
		parser.skip_semicolons_and_newlines()
	}
	parser.finish(comments: comments)
}

// Parse a whole input as one expression (ADR 0043 category entry).
pub func parse_expr_source(source: String) -> ParseOutcome {
	let result = scan(source: source)
	let comments = result.comments
	let parser = scan_parser(source: source, result: result)
	parser.parse_expr_root()
	parser.finish(comments: comments)
}

// Parse a whole input as one pattern (ADR 0043 category entry).
pub func parse_pattern_source(source: String) -> ParseOutcome {
	let result = scan(source: source)
	let comments = result.comments
	let parser = scan_parser(source: source, result: result)
	parser.parse_pattern_root()
	parser.finish(comments: comments)
}

// Parse a whole input as one type annotation (ADR 0043 category entry).
pub func parse_type_source(source: String) -> ParseOutcome {
	let result = scan(source: source)
	let comments = result.comments
	let parser = scan_parser(source: source, result: result)
	parser.parse_type_root()
	parser.finish(comments: comments)
}

// Parse pre-tokenized source ranges. These are the macro-facing category
// entry points; tokens keep their use-site byte ranges and comments have
// already been removed by the canonical scanner.
pub func parse_file_tokens(source: String, input: TokenRange) -> ParseOutcome {
	let parser = token_parser(source: source, input: input)
	parser.parse_items(allow_imports: true)
	parser.finish(comments: [])
}

pub func parse_block_items_tokens(source: String, input: TokenRange) -> ParseOutcome {
	let parser = token_parser(source: source, input: input)
	parser.parse_items(allow_imports: false)
	parser.finish(comments: [])
}

pub func parse_expr_tokens(source: String, input: TokenRange) -> ParseOutcome {
	let parser = token_parser(source: source, input: input)
	parser.parse_expr_root()
	parser.finish(comments: [])
}

pub func parse_pattern_tokens(source: String, input: TokenRange) -> ParseOutcome {
	let parser = token_parser(source: source, input: input)
	parser.parse_pattern_root()
	parser.finish(comments: [])
}

pub func parse_type_tokens(source: String, input: TokenRange) -> ParseOutcome {
	let parser = token_parser(source: source, input: input)
	parser.parse_type_root()
	parser.finish(comments: [])
}

pub func parse_decl_tokens(source: String, input: TokenRange) -> ParseOutcome {
	let parser = token_parser(source: source, input: input)
	parser.parse_decl_root()
	parser.finish(comments: [])
}

// Convenience source entry for the declaration category. Production macro
// expansion uses `parse_decl_tokens` after balanced capture.
pub func parse_decl_source(source: String) -> ParseOutcome {
	let result = scan(source: source)
	let comments = result.comments
	let parser = scan_parser(source: source, result: result)
	parser.parse_decl_root()
	parser.finish(comments: comments)
}

// MARK: Node meta annotation (ADR 0043 option A)
//
// The reference records per-node meta through a location stack; here
// meta is DERIVED after the parse. Spans are byte-identical to the
// reference by construction, and the reference derives spans FROM
// meta (span.start is meta.start.start, span.end is meta.end.end), so
// a node's first and last tokens recover from its span and the token
// list. Line/col come from a position pass over the source (the
// reference stamps them at the lexer's make(): state at the token's
// END, 0-based line, character-counted column reset on newline).
// Emission order is the canonical pre-order the bridge adapter walks:
// parent first, then children in Ast payload order. Synthesized nodes
// (span start < 0) emit the no-meta marker.
//
// Identifiers: the parser logs identifier consumption at the
// reference's three ports (id_log); each node claims the unclaimed
// logged tokens inside its extent AFTER its children claimed theirs —
// equivalent to the reference's top-of-stack attribution. Statement
// wrappers and the inline-IR chain share one reference meta entry, so
// their slots copy the payload's list.

// The token/position context the walk reads.
struct MetaCtx {
	let tokens: [Token]
	let lines: [Int]
	let cols: [Int]
	// The parser's identifier log, in consumption (= position) order.
	let log: [Token]
	// Parallel probe flags: entries only a block may claim.
	let probe: [Bool]
}

func no_meta_token() -> MetaToken {
	MetaToken(kind: .eof, start: -1, end: -1, line: 0, col: 0)
}

func no_meta() -> NodeMeta {
	let no_ids: [MetaToken] = []
	NodeMeta(start: no_meta_token(), end: no_meta_token(), identifiers: no_ids)
}

// line/col at each token's END: the count of newlines before the end
// offset, and the count of CHARACTERS since the last newline (UTF-8
// continuation bytes do not count).
func token_positions(source: String, tokens: &[Token]) -> ([Int], [Int]) {
	let lines: [Int] = []
	let cols: [Int] = []
	let view = source.utf8()
	let line = 0
	let col = 0
	let offset = 0
	for tok in tokens {
		let end = tok.span.upper
		loop offset < end {
			let b = view.at(index: offset)._toInt()
			if b == 10 {
				line = line + 1
				col = 0
			} else {
				if b >= 128 && b < 192 { } else { col = col + 1 }
			}
			offset = offset + 1
		}
		lines.push(line)
		cols.push(col)
	}
	(lines, cols)
}

func token_index_starting(ctx: &MetaCtx, start: Int) -> Int {
	let lo = 0
	let hi = ctx.tokens.count - 1
	loop lo <= hi {
		let mid = (lo + hi) / 2
		let s = ctx.tokens[mid].span.lower
		if s == start { return mid }
		if s < start { lo = mid + 1 } else { hi = mid - 1 }
	}
	0 - 1
}

// The FIRST token ending at `end` (a zero-width EOF shares its end
// with the last real token; the reference records the real one).
func token_index_ending(ctx: &MetaCtx, end: Int) -> Int {
	let lo = 0
	let hi = ctx.tokens.count - 1
	let found = 0 - 1
	loop lo <= hi {
		let mid = (lo + hi) / 2
		let e = ctx.tokens[mid].span.upper
		if e >= end {
			if e == end { found = mid }
			hi = mid - 1
		} else {
			lo = mid + 1
		}
	}
	found
}

func meta_token_at(ctx: &MetaCtx, index: Int) -> MetaToken {
	let tok = ctx.tokens[index]
	MetaToken(kind: tok.kind, start: tok.span.lower, end: tok.span.upper, line: ctx.lines[index], col: ctx.cols[index])
}

// A node's meta from its span extents, returning the emitted slot
// index (-1 = marker, nothing to claim). A `>>` closing nested
// generics is split by the parser without splitting the token list: a
// node ending at the full `>>` end was closed by the synthesized
// second `>`, which the reference records as a Greater token over the
// second half (col bumped past the first).
func emit_meta(ctx: &MetaCtx, mut metas: [NodeMeta], live: Bool, start: Int, end: Int) -> Int {
	if live == false || start < 0 {
		metas.push(no_meta())
		return 0 - 1
	}
	let si = token_index_starting(ctx: ctx, start: start)
	let ei = token_index_ending(ctx: ctx, end: end)
	if si < 0 || ei < 0 {
		metas.push(no_meta())
		return 0 - 1
	}
	let start_tok = meta_token_at(ctx: ctx, index: si)
	let end_tok = meta_token_at(ctx: ctx, index: ei)
	if end_tok.kind == .greater_greater {
		end_tok = MetaToken(kind: .greater, start: end_tok.start + 1, end: end_tok.end, line: end_tok.line, col: end_tok.col + 1)
	}
	let no_ids: [MetaToken] = []
	metas.push(NodeMeta(start: start_tok, end: end_tok, identifiers: no_ids))
	metas.count - 1
}

// Claim the unclaimed logged identifiers inside [start, end] for the
// node at `slot`. Children run first, so what remains is exactly what
// the reference pushed to this node's own frame.
func claim_slot(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], slot: Int, start: Int, end: Int) -> Void {
	claim_slot_full(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: start, end: end, include_probe: false)
}

func claim_slot_full(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], slot: Int, start: Int, end: Int, include_probe: Bool) -> Void {
	// slot -1 = nothing to fill; slot -2 = discard (mark claimed only).
	if slot == 0 - 1 || start < 0 { return () }
	let lo = 0
	let hi = ctx.log.count - 1
	let first = ctx.log.count
	loop lo <= hi {
		let mid = (lo + hi) / 2
		if ctx.log[mid].span.lower >= start {
			first = mid
			hi = mid - 1
		} else {
			lo = mid + 1
		}
	}
	// A rollback probe re-consumes: the log then carries the same
	// token twice, and the reference attributes the earlier (probe)
	// entry to the enclosing frame. Take at most one entry per token,
	// preferring the LAST, by scanning backward; earlier duplicates
	// stay for the ancestors.
	let last = first
	loop last < ctx.log.count {
		if ctx.log[last].span.lower >= end { break }
		last = last + 1
	}
	let reversed: [MetaToken] = []
	let seen_starts: [Int] = []
	let i = last - 1
	loop i >= first {
		let tok = ctx.log[i]
		if claimed[i] == false && tok.span.upper <= end && (include_probe || ctx.probe[i] == false) {
			let dup = false
			for start_taken in seen_starts {
				if start_taken == tok.span.lower { dup = true }
			}
			if dup == false {
				claimed[i] = true
				seen_starts.push(tok.span.lower)
				let ti = token_index_starting(ctx: ctx, start: tok.span.lower)
				if ti >= 0 {
					reversed.push(meta_token_at(ctx: ctx, index: ti))
				}
			}
		}
		i = i - 1
	}
	if slot < 0 {
		return ()
	}
	if reversed.count > 0 {
		let taken: [MetaToken] = []
		let j = reversed.count - 1
		loop j >= 0 {
			let t = reversed[j]
			taken.push(MetaToken(kind: t.kind, start: t.start, end: t.end, line: t.line, col: t.col))
			j = j - 1
		}
		let entry = metas[slot]
		metas[slot] = NodeMeta(start: entry.start, end: entry.end, identifiers: taken)
	}
}

// Wrapper slots that share the reference's single meta entry copy the
// payload's identifier list.
func copy_identifiers(mut metas: [NodeMeta], to_slot: Int, from_slot: Int) -> Void {
	if to_slot < 0 || from_slot < 0 { return () }
	let source = metas[from_slot]
	let target = metas[to_slot]
	metas[to_slot] = NodeMeta(start: target.start, end: target.end, identifiers: source.identifiers)
}

func meta_items(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, items: &[Item]) -> Void {
	for item in items {
		match item {
			.decl_item(d) -> meta_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, decl: d),
			.stmt_item(s) -> meta_stmt(ctx: ctx, metas: metas, claimed: claimed, live: live, stmt: s),
			.expr_item(e) -> meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e),
			.pattern_item(p) -> meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: p),
			.type_item(t) -> meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
		}
	}
}

func meta_decl(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, decl: &Decl) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: decl.start, end: decl.end)
	// Function-shaped decls share the payload's reference meta entry.
	let copy_from = 0 - 1
	match decl.kind {
		.let_decl(pat, annotation, value) -> {
			meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: pat)
			if let .some(target) = annotation {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: target)
			}
			if let .some(rhs) = value {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: rhs)
			}
		},
		.import_decl(_) -> { },
		.func_decl(f) -> meta_func(ctx: ctx, metas: metas, claimed: claimed, live: live, f: f),
		.func_signature(sig) -> meta_func_signature(ctx: ctx, metas: metas, claimed: claimed, live: live, sig: sig),
		.struct_decl(_, _, _, generics, wc, body, _, _) -> {
			for generic in generics {
				meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
			}
			meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: wc)
			meta_body(ctx: ctx, metas: metas, claimed: claimed, live: live, body: body)
		},
		.enum_decl(_, _, _, generics, wc, body, _, _) -> {
			for generic in generics {
				meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
			}
			meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: wc)
			meta_body(ctx: ctx, metas: metas, claimed: claimed, live: live, body: body)
		},
		.protocol_decl(_, _, _, generics, wc, body, conformances) -> {
			for generic in generics {
				meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
			}
			meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: wc)
			meta_body(ctx: ctx, metas: metas, claimed: claimed, live: live, body: body)
			for conformance in conformances {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: conformance)
			}
		},
		.enum_variant(_, _, _, generics, payloads, _, result) -> {
			for generic in generics {
				meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
			}
			for payload in payloads {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: payload)
			}
			if let .some(target) = result {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: target)
			}
		},
		.extend_decl(binders, head, conformances, wc, body) -> {
			for binder in binders {
				meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: binder)
			}
			let head_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: head.start, end: head.end)
			for arg in head.args {
				meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: arg)
			}
			claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: head_slot, start: head.start, end: head.end)
			for conformance in conformances {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: conformance)
			}
			meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: wc)
			meta_body(ctx: ctx, metas: metas, claimed: claimed, live: live, body: body)
		},
		.init_decl(params, body) -> {
			for param in params {
				meta_parameter(ctx: ctx, metas: metas, claimed: claimed, live: live, param: param)
			}
			meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: body)
		},
		.property(_, _, _, _, annotation, default_value) -> {
			if let .some(target) = annotation {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: target)
			}
			if let .some(value) = default_value {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: value)
			}
		},
		.method(f, _, _) -> {
			copy_from = metas.count
			meta_func(ctx: ctx, metas: metas, claimed: claimed, live: live, f: f)
		},
		.method_requirement(sig, _) -> meta_func_signature(ctx: ctx, metas: metas, claimed: claimed, live: live, sig: sig),
		.init_requirement(sig) -> {
			copy_from = metas.count
			meta_func_signature(ctx: ctx, metas: metas, claimed: claimed, live: live, sig: sig)
		},
		.typealias_decl(_, _, _, rhs) -> meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: rhs),
		.effect_decl(_, _, _, generics, wc, params, ret) -> {
			for generic in generics {
				meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
			}
			meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: wc)
			for param in params {
				meta_parameter(ctx: ctx, metas: metas, claimed: claimed, live: live, param: param)
			}
			meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: ret)
		},
		.associated_decl(generic, wc) -> {
			meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
			meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: wc)
		},
		.macro_decl(_, _, _, _, _, _, _) -> (),
		.macro_call_decl(_, _, _, _, _, _, args) -> {
			for e in args {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		}
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: decl.start, end: decl.end)
	if copy_from >= 0 {
		copy_identifiers(metas: metas, to_slot: slot, from_slot: copy_from)
	}
}

// The Func node's meta covers the whole declaration (its span is the
// body's; the reference records the declaration extents).
func meta_func(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, f: &Func) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: f.meta_start, end: f.meta_end)
	for generic in f.generics {
		meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
	}
	meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: f.where_clause)
	for param in f.params {
		meta_parameter(ctx: ctx, metas: metas, claimed: claimed, live: live, param: param)
	}
	meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: f.body)
	if let .some(ret) = f.ret {
		meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: ret)
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: f.meta_start, end: f.meta_end)
}

func meta_func_signature(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, sig: &FuncSignature) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: sig.start, end: sig.end)
	for param in sig.params {
		meta_parameter(ctx: ctx, metas: metas, claimed: claimed, live: live, param: param)
	}
	for generic in sig.generics {
		meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
	}
	meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: sig.where_clause)
	if let .some(ret) = sig.ret {
		meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: ret)
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: sig.start, end: sig.end)
}

func meta_body(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, body: &Body) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: body.start, end: body.end)
	for decl in body.decls {
		meta_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, decl: decl)
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: body.start, end: body.end)
}

func meta_block(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, block: &Block) -> Void {
	// A desugaring copy carries source spans but freshened ids in the
	// reference: no node below it has meta.
	let live = live && block.copied == false
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: block.start, end: block.end)
	for param in block.params {
		meta_parameter(ctx: ctx, metas: metas, claimed: claimed, live: live, param: param)
	}
	meta_items(ctx: ctx, metas: metas, claimed: claimed, live: live, items: block.body)
	claim_slot_full(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: block.start, end: block.end, include_probe: true)
}

func meta_parameter(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, param: &Parameter) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: param.start, end: param.end)
	if let .some(target) = param.annotation {
		meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: target)
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: param.start, end: param.end)
}

func meta_optional_where(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, wc: &WhereClause?) -> Void {
	if let .some(clause) = wc {
		let clause_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: clause.start, end: clause.end)
		for predicate in clause.predicates {
			let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: predicate.start, end: predicate.end)
			match predicate.kind {
				.type_eq(a, b) -> {
					meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: a)
					meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: b)
				},
				.static_cmp(_, a, b) -> {
					meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: a)
					meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: b)
				},
				.conforms(ty, protocols) -> {
					meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: ty)
					for proto in protocols {
						meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: proto)
					}
				}
			}
			claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: predicate.start, end: predicate.end)
		}
		claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: clause_slot, start: clause.start, end: clause.end)
	}
}

func meta_generic_decl(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, generic: &GenericDecl) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: generic.start, end: generic.end)
	for nested in generic.generics {
		meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: nested)
	}
	for conformance in generic.conformances {
		meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: conformance)
	}
	if let .some(value) = generic.default_value {
		meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: value)
	}
	if let .some(ty) = generic.static_ty {
		meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: ty)
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: generic.start, end: generic.end)
}

func meta_generic_arg(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, arg: &GenericArg) -> Void {
	match arg {
		.type_arg(t) -> meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t),
		.static_arg(s) -> meta_static_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: s)
	}
}

func meta_static_expr(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, expr: &StaticExpr) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: expr.start, end: expr.end)
	match expr.kind {
		.static_path(t) -> meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t),
		.static_group(inner) -> {
			for e in inner {
				meta_static_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.static_op(_, operands) -> {
			for e in operands {
				meta_static_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		_ -> { }
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: expr.start, end: expr.end)
}

func meta_type(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, annotation: &TypeAnnotation) -> Void {
	// A borrow wrapper sharing its inner type's exact span is the
	// synthesized borrow-by-default wrapper (a written `&T` starts at
	// the amp): the reference builds it without meta.
	let synthesized_wrapper = false
	if let .borrow(_, inner) = annotation.kind {
		for t in inner {
			if t.start == annotation.start && t.end == annotation.end {
				synthesized_wrapper = true
			}
		}
	}
	let slot = 0 - 1
	if synthesized_wrapper {
		metas.push(no_meta())
	} else {
		slot = emit_meta(ctx: ctx, metas: metas, live: live, start: annotation.start, end: annotation.end)
	}
	match annotation.kind {
		.borrow(_, inner) -> {
			for t in inner {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
			}
		},
		.unique(inner) -> {
			for t in inner {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
			}
		},
		.quantified_type(generics, where_clause, inners) -> {
			for generic in generics {
				meta_generic_decl(ctx: ctx, metas: metas, claimed: claimed, live: live, generic: generic)
			}
			meta_optional_where(ctx: ctx, metas: metas, claimed: claimed, live: live, wc: where_clause)
			for t in inners {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
			}
		},
		.func_type(params, _, ret) -> {
			for t in params {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
			}
			for t in ret {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
			}
		},
		.nominal_path(base, _, _, _, member_generics) -> {
			for t in base {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
			}
			for arg in member_generics {
				meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: arg)
			}
		},
		.nominal(_, _, _, generics) -> {
			for arg in generics {
				meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: arg)
			}
		},
		.tuple(items) -> {
			for t in items {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
			}
		},
		.record_type(fields) -> {
			for field in fields {
				let field_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: field.start, end: field.end)
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: field.value)
				claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: field_slot, start: field.start, end: field.end)
			}
		},
		.any_type(head, bindings) -> {
			for t in head {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: t)
			}
			for binding in bindings {
				let binding_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: binding.start, end: binding.end)
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: binding.value)
				claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: binding_slot, start: binding.start, end: binding.end)
			}
		},
		.macro_call_type(_, _, _, _, _, _) -> ()
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: annotation.start, end: annotation.end)
}

func meta_stmt(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, stmt: &Stmt) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: stmt.start, end: stmt.end)
	// Expression statements share the payload's reference meta entry.
	let copy_from = 0 - 1
	match stmt.kind {
		.expr_stmt(e) -> {
			copy_from = metas.count
			meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
		},
		.if_stmt(cond, then_block, else_block) -> {
			meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: cond)
			meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: then_block)
			if let .some(alt) = else_block {
				meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: alt)
			}
		},
		.return_stmt(value) -> {
			if let .some(e) = value {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.break_stmt -> { },
		.assignment(parts) -> {
			for e in parts {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.loop_stmt(cond, body) -> {
			if let .some(e) = cond {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
			meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: body)
		},
		.for_stmt(iterable, pat, body, _) -> {
			meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: iterable)
			meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: pat)
			meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: body)
		},
		.continue_stmt -> { },
		.resume_stmt(value) -> {
			if let .some(e) = value {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.handle_stmt(_, _, _, body) -> meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: body)
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: stmt.start, end: stmt.end)
	if copy_from >= 0 {
		copy_identifiers(metas: metas, to_slot: slot, from_slot: copy_from)
	}
}

func meta_pattern(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, pattern: &Pattern) -> Void {
	// The for-loop block-arg replacement carries meta extents that
	// diverge from the span (the Parameter's after-name extents).
	let m_start = pattern.start
	let m_end = pattern.end
	if pattern.meta_start >= 0 {
		m_start = pattern.meta_start
		m_end = pattern.meta_end
	}
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: m_start, end: m_end)
	match pattern.kind {
		.tuple(items) -> {
			for p in items {
				meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: p)
			}
		},
		.or_pattern(items) -> {
			for p in items {
				meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: p)
			}
		},
		.variant(_, segment_generics, _, _, _, fields, _) -> {
			for segment in segment_generics {
				for arg in segment {
					meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: arg)
				}
			}
			for p in fields {
				meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: p)
			}
		},
		.struct_pattern(_, segment_generics, fields, _, _) -> {
			for segment in segment_generics {
				for arg in segment {
					meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: arg)
				}
			}
			for p in fields {
				meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: p)
			}
		},
		.record(fields) -> {
			for field in fields {
				let field_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: field.start, end: field.end)
				if let .equals_field(_, _, _, value) = field.kind {
					meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: value)
				}
				claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: field_slot, start: field.start, end: field.end)
			}
		},
		_ -> { }
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: m_start, end: m_end)
}

func meta_expr(ctx: &MetaCtx, mut metas: [NodeMeta], mut claimed: [Bool], live: Bool, expr: &Expr) -> Void {
	let slot = emit_meta(ctx: ctx, metas: metas, live: live, start: expr.start, end: expr.end)
	// The inline-IR chain shares one reference meta entry.
	let copy_from = 0 - 1
	match expr.kind {
		.unary(_, operands) -> {
			for e in operands {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.binary(_, operands) -> {
			for e in operands {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.call(callee, type_args, args, blocks) -> {
			for e in callee {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
			for arg in type_args {
				meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: arg)
			}
			for arg in args {
				let arg_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: arg.start, end: arg.end)
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: arg.value)
				claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: arg_slot, start: arg.start, end: arg.end)
			}
			for block in blocks {
				meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: block)
			}
		},
		.constructor(_, segments) -> {
			for segment in segments {
				for arg in segment {
					meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: arg)
				}
			}
			// The reference reinterprets `Path<Args>` in place: the
			// path's variable/member nodes are replaced, orphaning
			// their meta — the path identifiers belong to no node.
			claim_slot_full(ctx: ctx, metas: metas, claimed: claimed, slot: 0 - 2, start: expr.start, end: expr.end, include_probe: false)
		},
		.member(_, _, _, receiver) -> {
			for e in receiver {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.incomplete_member(receiver) -> {
			for e in receiver {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.tuple(items) -> {
			for e in items {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.block(block) -> meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: block),
		.literal_array(items) -> {
			for e in items {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.subscript_expr(operands) -> {
			for e in operands {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.func_expr(f) -> meta_func(ctx: ctx, metas: metas, claimed: claimed, live: live, f: f),
		.unsafe_expr(block) -> meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: block),
		.if_expr(cond, then_block, else_block) -> {
			for e in cond {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
			meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: then_block)
			meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: else_block)
		},
		.match_expr(scrutinee, arms) -> {
			for e in scrutinee {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
			for arm in arms {
				let arm_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: arm.start, end: arm.end)
				meta_pattern(ctx: ctx, metas: metas, claimed: claimed, live: live, pattern: arm.pattern)
				meta_block(ctx: ctx, metas: metas, claimed: claimed, live: live, block: arm.body)
				claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: arm_slot, start: arm.start, end: arm.end)
			}
		},
		.as_cast(operands, annotation) -> {
			for e in operands {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
			meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: annotation)
		},
		.propagate(operands) -> {
			for e in operands {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.force_unwrap(operands) -> {
			// The second operand is the hidden failure expression the
			// parser fabricates over the bang: real span, no meta.
			let index = 0
			for e in operands {
				if index == 0 {
					meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
				} else {
					meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: false, expr: e)
				}
				index = index + 1
			}
		},
		.call_effect(_, _, _, type_args, args) -> {
			for arg in type_args {
				meta_generic_arg(ctx: ctx, metas: metas, claimed: claimed, live: live, arg: arg)
			}
			for arg in args {
				let arg_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: arg.start, end: arg.end)
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: arg.value)
				claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: arg_slot, start: arg.start, end: arg.end)
			}
		},
		.record_literal(fields, spread) -> {
			for field in fields {
				let field_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: field.start, end: field.end)
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: field.value)
				claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: field_slot, start: field.start, end: field.end)
			}
			for e in spread {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		.inline_ir(binds, instruction) -> {
			for e in binds {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
			// The instruction node shares the enclosing expression's
			// extents (it carries no span of its own).
			let ir_slot = emit_meta(ctx: ctx, metas: metas, live: live, start: expr.start, end: expr.end)
			if let .some(ty) = instruction.ty {
				meta_type(ctx: ctx, metas: metas, claimed: claimed, live: live, annotation: ty)
			}
			claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: ir_slot, start: expr.start, end: expr.end)
			copy_from = ir_slot
		},
		.macro_call(_, _, _, _, _, _, args) -> {
			for e in args {
				meta_expr(ctx: ctx, metas: metas, claimed: claimed, live: live, expr: e)
			}
		},
		_ -> { }
	}
	claim_slot(ctx: ctx, metas: metas, claimed: claimed, slot: slot, start: expr.start, end: expr.end)
	if copy_from >= 0 {
		copy_identifiers(metas: metas, to_slot: slot, from_slot: copy_from)
	}
}

// MARK: The lexing surface (ADR 0043 Stage 5)
//
// Token-level editor queries (highlighting, delimiter matching,
// identifier validation) read the token stream itself. Comments
// re-enter here as line_comment tokens, merged by position; a scan
// failure appends the sentinel token (start -1) after the tokens
// produced up to the failure.
pub func lex_tokens(source: String) -> [MetaToken] {
	let result = scan(source: source)
	let merged: [Token] = []
	let ti = 0
	let ci = 0
	let tokens = result.tokens
	let comments = result.comments
	loop ti < tokens.count || ci < comments.count {
		let take_comment = false
		if ci < comments.count {
			if ti >= tokens.count {
				take_comment = true
			} else {
				if comments[ci].start < tokens[ti].span.lower { take_comment = true }
			}
		}
		if take_comment {
			merged.push(Token(kind: .line_comment, span: comments[ci].start..<comments[ci].end, lexeme: comments[ci].start..<comments[ci].end))
			ci = ci + 1
		} else {
			let tok = tokens[ti]
			merged.push(Token(kind: tok.kind, span: tok.span, lexeme: tok.lexeme))
			ti = ti + 1
		}
	}
	let (lines, cols) = token_positions(source: source, tokens: merged)
	let out: [MetaToken] = []
	let i = 0
	loop i < merged.count {
		let tok = merged[i]
		out.push(MetaToken(kind: tok.kind, start: tok.span.lower, end: tok.span.upper, line: lines[i], col: cols[i]))
		i = i + 1
	}
	if let .some(_) = result.error {
		out.push(MetaToken(kind: .eof, start: -1, end: -1, line: 0, col: 0))
	}
	out
}
