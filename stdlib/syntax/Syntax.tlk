pub func materialize_decl_syntax(syntax: &Syntax<Decl>) -> MaterializedResult<Decl> {
	let materialized = materialize(raw: syntax.raw, group_splices: true)
	let outcome = parse_decl_tokens(source: materialized.source, input: materialized.input)
	if let .some(failure) = parse_failure(outcome: outcome, fallback: materialized.input.span) {
		return MaterializedResult<Decl>(value: .none, failure: .some(failure))
