pub struct Path {
	pub let components: [String]

	init(components: [String]) {
		self.components = components
	}

	pub init(_ string: String) {
		// `split` omits empty components, so the absolute-path marker is
		// restored explicitly: a leading separator becomes the "/" root
		// component `to_string` and `appending` already understand.
		let all: [String] = []
		if string.starts_with(needle: "/") { all.push("/") }
		for part in string.split(character: '/').into_iter() {
			all.push(part.to_string())
		}
		self.components = all
	}
}

pub enum FileMode {
	case read
	case write
	case append
}

pub struct Rawfile {
	pub let fd: Int

	pub func open_read(path: String) -> Rawfile {
		let fd = open_path(path: path, flags: O_RDONLY, mode: 0)
		Rawfile(fd: fd)
	}

	pub func open_write(path: String) -> Rawfile {
		let mode = S_IRUSR + S_IWUSR
		let fd = open_path(path: path, flags: O_WRONLY + O_CREAT + O_TRUNC, mode: mode)
		Rawfile(fd: fd)
	}

	pub func open_append(path: String) -> Rawfile {
		let mode = S_IRUSR + S_IWUSR
		let fd = open_path(path: path, flags: O_WRONLY + O_CREAT + O_APPEND, mode: mode)
		Rawfile(fd: fd)
	}

	pub func read(buf: RawPtr, count: Int) -> Int {
		_io_read(fd: self.fd, buf: buf, count: count)
	}

	pub func write(buf: RawPtr, count: Int) -> Int {
		_io_write(fd: self.fd, buf: buf, count: count)
	}

	pub func close() -> Int {
		_io_close(fd: self.fd)
	}

	pub func is_valid() -> Bool { self.fd >= 0 }
}

pub struct File 'linear {
	pub enum Mode {
		case r
		case w
		case rw
	}

	let fd: Int
	let mode: Mode

	pub init(path: Path, mode: Mode) {
		self.fd = 0
		self.mode = mode
	}
}