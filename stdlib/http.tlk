use net::{ _io_socket, _io_bind, _io_listen, _io_accept, AF_INET, SOCK_STREAM }

pub struct Request {
	pub let raw: String
	pub let verb: String
	pub let path: String

	pub init(raw: String, verb: String, path: String) {
		self.raw = raw
		self.verb = verb
		self.path = path
		self
	}
}

pub struct Response {
	pub let status: Int
	pub let body: String

	pub init(status: Int, body: String) {
		self.status = status
		self.body = body
		self
	}
}

extend Response: Into<Response> {
	pub consuming func into() -> Response { self }
}

extend String: Into<Response> {
	pub consuming func into() -> Response {
		Response(status: 200, body: self)
	}
}

pub struct RouteHandler {
	pub let invoke: () -> String
}

// Routes live in a region-allocated ('heap) chain: registration conses,
// dispatch walks, with no fixed slot count.
pub struct RouteNode 'heap {
	pub let path: String
	pub let handler: RouteHandler
	pub let next: RouteNode?
}

func route_walk(current: RouteNode?, path: Substring) -> Response {
	match current {
		.some(node) -> {
			if path.equals_string(node.path) {
				Response(status: 200, body: node.handler.invoke())
			} else {
				route_walk(current: node.next, path: path)
			}
		},
		.none -> Response(status: 404, body: "Not Found")
	}
}

pub struct HttpServer 'heap {
	pub let routes: RouteNode?
	let route_count: Int

	pub init() {
		self.routes = Optional.none
		self.route_count = 0
		self
	}

	pub mut func get(consume path: String, consume handler: () -> String) -> () {
		let wrapped = RouteHandler(invoke: handler)
		let node = RouteNode(path: path, handler: wrapped, next: self.routes)
		self.routes = Optional.some(node)
		self.route_count = self.route_count + 1
		()
	}

	func extract_method(raw_request: String) -> Substring {
		let bytes: UTF8View = raw_request.utf8()
		match raw_request.find(needle: " ") {
			.some(first_space) -> bytes.slice(start: 0, byte_count: first_space),
			.none -> "".as_substring()
		}
	}

	func extract_path(raw_request: String) -> Substring {
		let bytes: UTF8View = raw_request.utf8()
		match raw_request.find(needle: " ") {
			.some(first_space) -> {
				let rest_start: Int = first_space + 1
				let rest_len: Int = raw_request.byte_count - rest_start
				if rest_len <= 0 { return "".as_substring() }

				let rest: Substring = bytes.slice(start: rest_start, byte_count: rest_len)
				let rest_bytes: UTF8View = rest.utf8()
				match rest.find(needle: " ") {
					.some(second_space) -> rest_bytes.slice(start: 0, byte_count: second_space),
					.none -> rest
				}
			},
			.none -> "".as_substring()
		}
	}

	pub func dispatch(path: Substring) -> Response {
		route_walk(current: self.routes, path: path)
	}

	pub func render(response: Response) -> String {
		let text: String = match response.status {
			200 -> "OK",
			404 -> "Not Found",
			_ -> "Error"
		}
		let status_line_a: String = "HTTP/1.1 ".add(response.status.show())
		let status_line_b: String = status_line_a.add(" ")
		let status_line_c: String = status_line_b.add(text)
		let status_line: String = status_line_c.add("\r\n")
		let content_type = "Content-Type: text/plain; charset=utf-8\r\n"
		let content_length_a: String = "Content-Length: ".add(
			response.body.byte_count.show()
		)
		let content_length: String = content_length_a.add("\r\n")
		let connection = "Connection: close\r\n"
		let wire_a: String = status_line.add(content_type)
		let wire_b: String = wire_a.add(content_length)
		let wire_c: String = wire_b.add(connection)
		let wire_d: String = wire_c.add("\r\n")
		wire_d.add(response.body)
	}

	pub func handle(raw_request: String) -> String {
		let method: Substring = self.extract_method(raw_request: raw_request)
		if method.equals_string("GET") == false { return self.render(
			response: Response(status: 404, body: "Not Found")
		) }

		let path: Substring = self.extract_path(raw_request: raw_request)
		self.render(response: self.dispatch(path: path))
	}

	pub func run(port: Int) -> () {
		#unsafe {
			let listener_fd = _io_socket(domain: AF_INET, socktype: SOCK_STREAM, proto: 0)
			_io_bind(fd: listener_fd, addr: 0, port: port)
			_io_listen(fd: listener_fd, backlog: 128)

			loop {
				let client_fd = _io_accept(fd: listener_fd)
				if client_fd < 0 {
					continue
				}

				let max_request_size = 8192
				let buf = _alloc<Byte>(count: max_request_size)
				let n = _io_read(fd: client_fd, buf: buf, count: max_request_size)

				if n <= 0 {
					_io_close(fd: client_fd)
					continue
				}

				let n = _io_clamp(count: n, capacity: max_request_size)
				let raw_request = String(base: buf, byte_count: n, capacity: max_request_size)
				let wire = self.handle(raw_request: raw_request)
				_io_write(fd: client_fd, buf: wire.storage.base, count: wire.byte_count)
				_io_close(fd: client_fd)
			}
		}
	}
}

pub struct HTTP {
	pub static func Server() -> HttpServer {
		HttpServer()
	}
}
