use http::{ HTTP }

func check() -> Int {
	let server = HTTP.Server()
	server.get(path: "/", handler: func() -> String { "home" })
	server.get(path: "/a", handler: func() -> String { "aaa" })
	server.get(path: "/b", handler: func() -> String { "bbb" })
	server.get(path: "/c", handler: func() -> String { "ccc" })
	server.get(path: "/d", handler: func() -> String { "ddd" })
	server.get(path: "/e", handler: func() -> String { "eee" })
	let wire = server.handle(raw_request: "GET /d HTTP/1.1")
	match wire.utf8().find_bytes("ddd") {
		.some(i) -> i,
		.none -> 0 - 1
	}
}
check()
