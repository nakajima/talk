tokens:
  Match @0..5 "match"
  Identifier @6..7 "n"
  LeftBrace @8..9 "{"
  Int @10..11 "0"
  Arrow @12..14 "->"
  StringLiteral @15..21 "\"zero\""
  Comma @21..22 ","
  Underscore @23..24 "_"
  Arrow @25..27 "->"
  StringLiteral @28..34 "\"many\""
  RightBrace @35..36 "}"
  Newline @36..37
tree:
  Expr::Match @0..36 "match n { 0 -> \"zero\", _ -> \"many\" }"
    Expr::Variable @6..7 "n"
    MatchArm @10..21 "0 -> \"zero\""
      Pattern::LiteralInt @10..11 "0"
      Block @15..21 "\"zero\""
        Stmt::Expr @15..21 "\"zero\""
          Expr::LiteralString @15..21 "\"zero\""
    MatchArm @23..34 "_ -> \"many\""
      Pattern::Wildcard @23..24 "_"
      Block @28..34 "\"many\""
        Stmt::Expr @28..34 "\"many\""
          Expr::LiteralString @28..34 "\"many\""
