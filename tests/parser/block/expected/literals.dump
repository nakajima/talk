tree:
  Decl::Let @0..25 "let text = \"hello\\nworld\""
    Pattern::Bind @4..8 "text"
    Expr::LiteralString @11..25 "\"hello\\nworld\""
  Decl::Let @26..38 "let ch = 'x'"
    Pattern::Bind @30..32 "ch"
    Expr::LiteralCharacter @35..38 "'x'"
  Decl::Let @39..52 "let pi = 3.14"
    Pattern::Bind @43..45 "pi"
    Expr::LiteralFloat @48..52 "3.14"
  Decl::Let @53..67 "let yes = true"
    Pattern::Bind @57..60 "yes"
    Expr::LiteralTrue @63..67 "true"
  Decl::Let @68..82 "let no = false"
    Pattern::Bind @72..74 "no"
    Expr::LiteralFalse @77..82 "false"
  Decl::Let @83..96 "let neg = -42"
    Pattern::Bind @87..90 "neg"
    Expr::Unary @93..96 "-42"
      Expr::LiteralInt @94..96 "42"
  Decl::Let @97..116 "let flipped = !true"
    Pattern::Bind @101..108 "flipped"
    Expr::Unary @111..116 "!true"
      Expr::LiteralTrue @112..116 "true"
  Decl::Let @117..126 "let _ = 9"
    Pattern::Wildcard @121..122 "_"
    Expr::LiteralInt @125..126 "9"
