func add(a: Int, b: Int) -> Int {
	a + b
}
func greet(name: String) {
	print(name)
}
func first<T>(items: [T]) -> T? { items[0] }
func pair<A, B: Show>(a: A, b: B) -> (A, B) where A: Show { (a, b) }
func labeled(with value: Int, _ bare: Int, consume owned: String) -> Int { value }
func effectful() 'io -> Int { 1 }
func counter[count](n: Int) -> Int { count + n }
