tokens:
  LeftParen @0..1 "("
  Int @1..2 "1"
  Pipe @3..4 "|"
  Int @5..6 "2"
  Comma @6..7 ","
  Underscore @8..9 "_"
  RightParen @9..10 ")"
  Newline @10..11
tree:
  Pattern::Tuple @0..10 "(1 | 2, _)"
    Pattern::Or @1..6 "1 | 2"
      Pattern::LiteralInt @1..2 "1"
      Pattern::LiteralInt @5..6 "2"
    Pattern::Wildcard @8..9 "_"
