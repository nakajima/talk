// Every executable runs as a cooperative root task. Spawned tasks
// interleave over 'yield on one worker without an explicit `run`
// wrapper, and the executable waits for the child to finish.

'spawn(
	task: func() -> () {
		print(10)
		'yield()
		print(12)
	}
)
print(1)
'yield()
print(2)
print(0)
