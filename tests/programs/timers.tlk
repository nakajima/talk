// ADR 0063/0067: sleep parks directly until its deadline. Elapsed
// monotonic time proves the sleep slept; a worker that sleeps before
// sending proves a parked receiver outwaits a slow producer. Margins
// are wide on purpose — the pin is about order, not precision.
use task::{ channel, sleep, run_blocking, Sender }

func produce_late(consume sender: Sender<Int>) -> Int {
	run_blocking(arg: sender, body: func(consume sender: Sender<Int>) -> Int {
		sleep(ms: 40)
		sender.send(value: 99)
		0
	})
}

let start = _chan_ctl(handle: 0, op: 13)
sleep(ms: 60)
let elapsed = _chan_ctl(handle: 0, op: 13) - start
let slept_full = if elapsed >= 60 { 1 } else { 0 }
print(slept_full)

let (sender, receiver) = channel<Int>()
let worker = _task_spawn(arg: sender, worker: func(consume sender: Sender<Int>) -> Int {
			produce_late(sender: sender)
		})
if let .some(value) = receiver.recv() { print(value) } else { print(0 - 1) }
print(_task_join<Int>(handle: worker))
