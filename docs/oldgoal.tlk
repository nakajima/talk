// Polymorphic identity func with no annotations
func identity(x) { x }
identity(123) // => Int
identity(1.23) // => Float

func tuplize(point) {
  (point.x, point.y)
}

tuplize({ x: 123, y: 567 }) // => (Int, Int)
tuplize({ x: 1.23, y: 5.67 }) // => (Float, Float)

// Funcs are values
let id = identity
id(123) // => Int
id(1.23) // => Float

// Record literals
let record = {
  a: 123,
  b: 1.23,
  c: func(x) { x },
  d: {
    x: 123,
    y: 456
  }
}

// Record concat
let a = { a: 123 }
let b = { b: 456 }
let c = a.concat(b) // => { a: 123, b: 456 }

// Basic struct
struct Person {
  // Properties
  let name: String
  let age: Int

  // Static method
  static func create() {
    Person(name: "Pat")
  }

  // Static property
  static let defaultAge = 0

  // Initializer (types can be inferred)
  init(name) {
    self.name = name // `name` param inferred to be String due to self.name being a String
    self.age = Person.defaultAge
  }

  // Methods (types can be inferred)
  func getName() {
    name
  }
}

let person = Person(name: "Pat")
person.getName() // => String

let person = Person.create() // => Person

// Generic struct
struct Wrapper<T> {
  let wrapped: T

  // `wrapped` param inferred to be T
  init(wrapped) {
    self.wrapped = wrapped
  }
}

Wrapper(wrapped: 123).wrapped // # => Int
Wrapper(wrapped: 1.23).wrapped // # => Float
Wrapper(wrapped: func(x) { x }).wrapped(123) // # => Int
Wrapper(wrapped: func(x) { x }).wrapped(1.23) // # => Float

// Enum
enum Fizz {
  case foo

  // Variants can have attached values
  case bar(Int)

  // Enums can have methods and static methods
  static func buzz() -> Fizz {
    .foo // Swift-style implicit member receiver
  }
}

func(fizz: Fizz) {
  print(fizz)
}(.buzz())

// Generic enums
enum Failable<Success, Failure> {
  case ok(Success), error(Failure)
}

func trySomething(failable: Failable) {
  // Pattern matching with if/let sugar
  if let .ok(result) = failable {
    result
  } else {
    panic!("nope")
  }
}

trySomething(.ok(123)) // => Returns Failable.Success, aka Int

// Enum match expr
let fizz = Fizz.foo
match fizz {
  .foo -> 123,
  .bar(x) -> x, // x inferred to be Int
} // Returns int

// Record match expr
let a = { x: 123, y: 456 }
match a {
  { a: 123, .. } -> 0,
  { a, b: 123 } -> a
}

// We can match structs too
let person = Person(name: "Pat")
match person {
  Person { name: "Pat", age } -> age,
  Person { name: "Not Pat", age} -> age
} // => Int

// Protocols (like traits or type classes) with associated values
protocol Addable<RHS: Addable> {
  associated Returns

  func add(other: RHS) -> Returns
}

// Types can conform to protocols with `extend` decls
extend Int: Addable<Int, Int> {
  // `rhs` param is inferred to be RHS which is inferred to be Int from the <Int, Int> annotation
  func add(rhs) {
    self + rhs
  }
}

123.add(456) // Inferred to be Returns which is inferred to be Int

// Required conformances and generics
func addTwo<T, LHS: Addable<RHS, T>, RHS: Addable<LHS, T>>(x: LHS, y: RHS) {
  x.add(y) + y.add(x)
}

protocol CommutativeAddable<RHS>: Addable<RHS> where RHS: Addable<Self>, RHS.Returns == Returns {
  // no extra methods; the where-clause enforces symmetry of the result type
}

enum Option<I> {
    case some(I), none
}

// Polymorphic matching
func map<U, T>(opt: Option<T>, f: (T) -> U) -> Option<U> {
    match opt {
        .some(value) -> Option.some(f(value))
        .none -> Option.none
    }
}

map(Option.some(123), func(foo) { foo })

// Control flow
loop {
  print("basic loop")
}

loop if i < 10 {
  print("i = ", i)
}

struct Wrapper<T> {
    let wrapped: T

    func getWrapped() {
        self.wrapped
    }
}

Wrapper(wrapped: 123).getWrapped()  // => Int
Wrapper(wrapped: 1.23).getWrapped() // => Float