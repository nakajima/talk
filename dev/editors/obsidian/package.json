{
  "name": "obsidian-talktalk",
  "version": "0.2.0",
  "private": true,
  "description": "Obsidian plugin: syntax highlighting for TalkTalk in tlk code blocks",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "esbuild test/tokenizer.test.ts --bundle --platform=node --format=cjs --external:obsidian --outfile=node_modules/.tmp/tokenizer.test.cjs --log-level=warning && node node_modules/.tmp/tokenizer.test.cjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@types/node": "^22.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0"
  }
}
