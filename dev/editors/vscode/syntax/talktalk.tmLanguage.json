{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TalkTalk",
  "patterns": [
    {
      "include": "#quoted-identifiers"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#effect-names"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#wrapper-markers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#bound-vars"
    },
    {
      "include": "#ir-registers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "quoted-identifiers": {
      "name": "variable.other.quoted.talktalk",
      "match": "#\"[^\"\\\\\\r\\n]+\"",
      "captures": {
        "0": {
          "patterns": [
            {
              "name": "punctuation.definition.identifier.talktalk",
              "match": "#\"|\""
            }
          ]
        }
      }
    },
    "comments": {
      "name": "comment.line.double-slash.talktalk",
      "match": "//.*$"
    },
    "effect-names": {
      "comment": "A tick-prefixed identifier run NOT closed by a second tick; a closed run is a character literal. Listed before #characters so foo('io, 'x') lexes like the reference lexer.",
      "name": "constant.other.effect.talktalk",
      "match": "'(?>[A-Za-z0-9_]+)(?!')"
    },
    "characters": {
      "name": "constant.character.talktalk",
      "match": "'(?:[^'\\\\\\r\\n]|\\\\(?:[ntr\"'\\\\]|u\\{[0-9A-Fa-f]{1,6}\\}))+'"
    },
    "strings": {
      "name": "string.quoted.double.talktalk",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.talktalk",
          "match": "\\\\(?:[ntr\"\\\\]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "comment": "A backslash at end of line is a line-continuation escape.",
          "name": "constant.character.escape.talktalk",
          "match": "\\\\$"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.talktalk",
      "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?"
    },
    "attributes": {
      "name": "storage.modifier.attribute.talktalk",
      "match": "@[A-Za-z0-9_]+"
    },
    "wrapper-markers": {
      "comment": "A #[name] declaration wrapper marker (ADR 0026); arguments highlight as ordinary tokens.",
      "match": "(#\\[)([A-Za-z0-9_]+)",
      "captures": {
        "1": {
          "name": "punctuation.definition.wrapper.talktalk"
        },
        "2": {
          "name": "storage.modifier.attribute.talktalk"
        }
      }
    },
    "bound-vars": {
      "name": "variable.other.bound.talktalk",
      "match": "\\$[A-Za-z0-9_]+"
    },
    "ir-registers": {
      "name": "variable.other.register.talktalk",
      "match": "%[0-9?]+"
    },
    "constants": {
      "name": "constant.language.talktalk",
      "match": "\\b(?:true|false)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.talktalk",
          "match": "\\b(?:if|else|loop|for|in|match|return|break|continue|unreachable)\\b"
        },
        {
          "name": "storage.type.talktalk",
          "match": "\\b(?:func|let|init|struct|enum|case|protocol|extend|associated|typealias|effect|import|use|macro|static)\\b"
        },
        {
          "name": "storage.modifier.talktalk",
          "match": "\\b(?:pub|public|linear|mut|consuming|handling|as|any)\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.talktalk",
      "match": "\\.\\.\\.|\\.\\.<|->|==|!=|<=|>=|\\+=|-=|\\*=|/=|~=|\\^=|&=|<<|>>|&&|\\|\\||::|\\.\\.|-|\\+|\\*|/|%|=|!|<|>|\\||&|\\^|~|\\?|:|\\.|@|\\$|#|'"
    }
  },
  "scopeName": "source.talktalk"
}
