{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Your Language",
  "patterns": [
    {
      "include": "#quoted-identifiers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "quoted-identifiers": {
      "name": "variable.other.quoted.talktalk",
      "match": "#\"[^\"\\\\\\r\\n]+\"",
      "captures": {
        "0": {
          "patterns": [
            {
              "name": "punctuation.definition.identifier.talktalk",
              "match": "#\"|\""
            }
          ]
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.talktalk",
          "match": "\\b(func|let|if|else|true|false|loop|enum|case|match|return|struct|extend|break|init|protocol|import)\\b"
        }
      ]
    },
    "characters": {
      "name": "constant.character.talktalk",
      "match": "'(?:[^'\\\\\\r\\n]|\\\\(?:[ntr\"'\\\\]|u\\{[0-9A-Fa-f]{1,6}\\}))'"
    },
    "strings": {
      "name": "string.quoted.double.talktalk",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.talktalk",
          "match": "\\\\."
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.talktalk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.talktalk",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.talktalk",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    }
  },
  "scopeName": "source.talktalk"
}
