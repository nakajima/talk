<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>talktalk - {TITLE}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link href="/reset.css" rel="stylesheet">
    <link href="/style.css" rel="stylesheet">
  </head>
  <body>
{GLOBAL_NAV}
    <main class="content-page manual-page">
{PAGE_HEADER}
      <div class="manual-layout">
        <aside class="manual-outline">
          <nav aria-label="Manual table of contents">
            <span class="manual-outline-title">Contents</span>
            <ol>
              {MANUAL_OUTLINE}
            </ol>
          </nav>
        </aside>
        <div class="manual-document">
          <nav class="manual-pagination manual-pagination-top" aria-label="Manual chapters">
            {PREVIOUS_LINK}
            <a class="manual-contents" href="/manual/">All chapters</a>
            {NEXT_LINK}
          </nav>
          <article class="page-content">
            {CONTENT_GOES_HERE}
          </article>
          <nav class="manual-pagination" aria-label="Manual chapters">
            {PREVIOUS_LINK}
            <a class="manual-contents" href="/manual/">All chapters</a>
            {NEXT_LINK}
          </nav>
        </div>
        <div class="manual-rail" aria-hidden="true"></div>
      </div>
      <script type="module" src="/page.js"></script>
    </main>
  </body>
</html>
