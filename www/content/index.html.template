<html>
  <meta charset="utf-8">
  <meta content="text/html" charset="UTF-8" http-equiv="Content-Type">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <head>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&display=swap" rel="stylesheet">
    <link href="/reset.css" rel="stylesheet">
    <link href="/style.css" rel="stylesheet">
  </head>
  <body>
    <main>
      <header>
        <h1><code>print(<span class="string">"hi, it’s talktalk"</span>)</code></h1>

        <div class="intro">
          <code class="intro-txt">
            We’ve got <span class="type" data-example="structs">structs</span>, <span class="string" data-example="strings">strings</span>, <span
class="number" data-example="ints">ints</span>, <span class="number" data-example="floats">floats</span>, <span class="type" data-example="enums">enums</span>,
						<span class="function" data-example="effects">effects</span>, <span class="keyword" data-example="bools">bools</span>, <span
              class="parameter" data-example="tuples">tuples</span>,
            <span class="type" data-example="arrays">arrays</span>, <span class="string" data-example="chars">chars</span>,
						<span class="type" data-example="records">records</span>, and
						<span class="function" data-example="functions">functions</span>.
          </code>
          <div class="intro-code">
            <pre></pre>
          </div>

        </div>
      </header>
      {CONTENT_GOES_HERE}
      <script>
        // the intro code panel swaps snippets on hover; pin its height
        // to the tallest snippet and center the code vertically so
        // shorter snippets don't leave trailing space
        (() => {
          const panel = document.querySelector(".intro-code");
          if (!panel) return;
          let maxLines = 1;
          for (const t of document.querySelectorAll("template[data-example]")) {
            const lines = t.innerHTML.trimEnd().split("\n").length;
            if (lines > maxLines) maxLines = lines;
          }
          panel.style.minHeight = `calc(${maxLines * 1.6}em + 3rem)`;
        })();
      </script>
      <script>
        (() => {
          const main = document.querySelector("main");
          const heads = [...main.querySelectorAll(":scope > h2")];
          if (!heads.length) return;

          const slug = (text, i) =>
            text.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") ||
            `section-${i}`;
          heads.forEach((h, i) => { h.id = slug(h.textContent, i); });
          const titles = heads.map((h) => h.textContent);

          // group each h2 with the content that follows it into a section,
          // so its sticky band only covers its own section. essay content
          // (from the first h4 on) stays unwrapped so the last band scrolls away.
          let current = null;
          for (const el of [...main.children]) {
            if (el.matches("header") || el.tagName === "SCRIPT") continue;
            if (el.matches("h2")) {
              current = document.createElement("section");
              main.insertBefore(current, el);
              current.appendChild(el);
            } else if (current) {
              if (el.matches("h1, h4")) { current = null; continue; }
              current.appendChild(el);
            }
          }

          // center a band's strip on its active section
          const centerNav = (nav, behavior) => {
            if (nav.scrollWidth <= nav.clientWidth) return;
            const cur = nav.querySelector('[aria-current="true"]');
            const left =
              cur.getBoundingClientRect().left - nav.getBoundingClientRect().left +
              nav.scrollLeft - (nav.clientWidth - cur.clientWidth) / 2;
            nav.scrollTo({ left, behavior });
          };

          // each band lists every section, highlighting its own
          for (const h of heads) {
            const nav = document.createElement("nav");
            nav.className = "band-nav";
            nav.setAttribute("aria-label", "Sections");
            heads.forEach((other, j) => {
              const a = document.createElement("a");
              a.href = `#${other.id}`;
              a.textContent = titles[j];
              if (other === h) a.setAttribute("aria-current", "true");
              nav.appendChild(a);
            });
            h.textContent = "";
            h.appendChild(nav);
            centerNav(nav, "instant");
            document.fonts?.ready.then(() => centerNav(nav, "instant"));
          }

          // default anchor scrolling targets the band's visual position,
          // which for a stuck sticky band is already at the top of the
          // viewport, so the browser doesn't scroll. scroll to the band's
          // natural position instead.
          main.addEventListener("click", (e) => {
            const a = e.target.closest(".band-nav a");
            if (!a) return;
            const target = document.getElementById(a.hash.slice(1));
            if (!target) return;
            e.preventDefault();
            let top = 0;
            for (let n = target; n; n = n.offsetParent) top += n.offsetTop;
            window.scrollTo({ top });
            history.pushState(null, "", a.hash);
          });

          // when a different band sticks to the top, scroll its strip
          // so the active section is in view
          let activeBand = null;
          const updateActive = () => {
            let current = null;
            for (const h of heads) {
              if (h.getBoundingClientRect().top <= 1) current = h;
              else break;
            }
            if (current === activeBand) return;
            activeBand = current;
            if (current) centerNav(current.querySelector(".band-nav"), "smooth");
          };

          let ticking = false;
          addEventListener("scroll", () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              ticking = false;
              updateActive();
            });
          }, { passive: true });
        })();
      </script>
      <script type="module" src="/page.js"></script>
    </main>
  </body>
</html>
