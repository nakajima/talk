// no-core
use package::Optional
use package::Iterable::{ Iterable, Iterator, IntoIterator, IndexIterable, IndexIterator, Skip, Map }
use package::Memory::{ Storage, _storage, _load, _store, _swap, _is_unique, _retain }
use package::String::{ String }
use package::StringBuilder::{ StringBuilder }
use package::Operators::{ Add, Subtract, Multiply, Comparable, Equatable, SubscriptRead, SubscriptWrite }
use package::Showable::{ Showable }
use package::Ownership::{ Borrowed, Clone, Deinit }
use package::Host::{ panic }

pub struct Array<Element> {
	pub let storage: Storage<Element>
	pub let count: Int
	pub let capacity: Int

	pub init(capacity: Int) {
		self.capacity = capacity
		self.count = 0
		self.storage = _storage<Element>(capacity: capacity)
	}

	pub init(storage: Storage<Element>, count: Int, capacity: Int) {
		self.storage = storage
		self.count = count
		self.capacity = capacity
	}

	// Every indexed accessor gates on this: a raw `gep` past the buffer
	// reads whatever memory follows it, so an out-of-range index has to
	// be caught here rather than left to the VM's memory guard.
	func _check_index(index: Int) -> Void {
		if index < 0 || index >= self.count { 'panic(
			message: "array index out of bounds"
		) }
	}

	pub func get(_ index: Int) -> &Element {
		self._check_index(index: index)
		let ptr: RawPtr = #_ir(self.storage.base, index) { %? = gep Element $0 $1 }
		_load<Element>(ptr: ptr)
	}

	pub mut func push(consume _ value: Element) -> () {
		let new_capacity = if self.capacity == 0 {
			1
		} else {
			self.capacity * 2
		}

		if self.count >= self.capacity {
			let fresh = self.allocate_with_capacity(capacity: new_capacity)
			self.capacity = new_capacity
			self.storage = fresh
		} else {
			self.uniqued_storage()
		}

		self._init_slot(index: self.count, value: value)
		self.count = self.count + 1
	}

	// Overwrite: the replaced element is loaded out and dropped at scope
	// exit (deep, per its own deinit) after the new value is written.
	pub mut func set(index: Int, consume value: Element) -> Void {
		self._check_index(index: index)
		self.uniqued_storage()
		let ptr: RawPtr = #_ir(self.storage.base, index) { %? = gep Element $0 $1 }
		let old: Element = _load<Element>(ptr: ptr)
		_store<Element>(ptr: ptr, value: value)
	}

	// Raw write into a slot that holds no element yet (push's fresh
	// slot): nothing to drop, and the caller has already uniqued the
	// buffer.
	mut func _init_slot(index: Int, consume value: Element) -> Void {
		let ptr: RawPtr = #_ir(self.storage.base, index) { %? = gep Element $0 $1 }
		_store<Element>(ptr: ptr, value: value)
	}

	pub mut func swap(i: Int, j: Int) -> Void {
		self._check_index(index: i)
		self._check_index(index: j)
		if i == j { return () }
		let storage = self.uniqued_storage()
		let a: RawPtr = #_ir(storage.base, i) { %? = gep Element $0 $1 }
		let b: RawPtr = #_ir(storage.base, j) { %? = gep Element $0 $1 }
		_swap<Element>(a: a, b: b)
	}

	pub consuming func map<T>(consume fn: (Element) -> T) -> Map<ArrayIntoIterator<Element>, T> {
		self.into_iter().map(fn: fn)
	}

	pub consuming func skip(count: Int) -> ArrayIntoIterator<Element> {
		self.into_iter().skip(count: count)
	}

	// Copy-on-write: a buffer shared with another Array (or with
	// static data) is copied before the first write, so writes never
	// alias — Arrays keep value semantics.
	mut func uniqued_storage() -> &mut Storage<Element> {
		if _is_unique(ptr: self.storage.base) {
			return self.storage
		} else {
			let fresh = self.allocate_with_capacity(capacity: self.capacity)
			self.storage = fresh
			return self.storage
		}
	}

	func allocate_with_capacity(capacity: Int) -> Storage<Element> {
		// If capacity is 0, it'll never double.
		if capacity == 0 { capacity = 1 }
		let fresh = _storage<Element>(capacity: capacity)
		// A shared (or static) source buffer survives this copy, so both
		// buffers end up owning the elements: retain each one as it is
		// written. A unique source is a grow-in-place MOVE — its elements
		// are donated and its shell is freed (shallowly) when the caller
		// replaces self.storage.
		let source_survives = _is_unique(ptr: self.storage.base) == false
		let i = 0
		loop i < self.count {
			let from: RawPtr = #_ir(self.storage.base, i) { %? = gep Element $0 $1 }
			let to: RawPtr = #_ir(fresh.base, i) { %? = gep Element $0 $1 }
			if source_survives { _retain<Element>(value: self.get(i)) }
			_store<Element>(ptr: to, value: _load<Element>(ptr: from))
			i = i + 1
		}
		fresh
	}

	pub func last() -> Optional<&Element> {
		if self.count == 0 { return Optional.none }
		Optional.some(self.get(self.count - 1))
	}

	// The popped slot becomes unreachable before the loaded element's
	// owner escapes, so CoW sharers keep their copy: unique the buffer
	// first, exactly like into_iter.
	pub mut func pop() -> Element? {
		if self.count == 0 { return Optional.none }
		self.uniqued_storage()
		let index = self.count - 1
		let ptr: RawPtr = #_ir(self.storage.base, index) { %? = gep Element $0 $1 }
		let element: Element = _load<Element>(ptr: ptr)
		self.count = index
		Optional.some(element)
	}

	pub func is_empty() -> Bool {
		self.count == 0
	}
}

extend<Element> Array<Element> where Element: Comparable<Element> {
	pub consuming func sort_by(fn: (Element, Element) -> Bool) -> Self {
		let i = 0

		loop i < self.count - 1 {
			let min = i // assume the current position as the minimum

			// Search for the smallest element in the unsorted portion
			let j = i + 1
			loop j < self.count {
				if fn(self.get(j), self.get(min)) { min = j }
				j = j + 1
			}

			// Swap only if a smaller element was found
			if min != i { self.swap(i: i, j: min) }

			i = i + 1
		}

		self
	}
}

extend<Element> Array<Element>: SubscriptRead<Int> {
	pub func subscript_read(at: Int) -> &Element {
		self.get(at)
	}
}

extend<Element> Array<Element>: SubscriptWrite<Int, Element> {
	pub mut func subscript_write(at: Int, consume value: Element) -> Void {
		self.set(index: at, value: value)
	}
}

extend<Element> Array<Element>: Clone {}

// Elements die with the buffer: only the LAST reference tears them
// down (CoW sharers hold identical elements, so the `_is_unique` gate
// makes teardown run exactly once). Loading each element re-owns it;
// its drop runs at scope exit, recursing structurally (nested arrays
// dispatch their own deinit).
extend<Element> Array<Element>: Deinit {
	consuming func deinit() -> Void {
		if _is_unique(ptr: self.storage.base) {
			let i = 0
			loop i < self.count {
				let ptr: RawPtr = #_ir(self.storage.base, i) { %? = gep Element $0 $1 }
				let element: Element = _load<Element>(ptr: ptr)
				i = i + 1
			}
		}
	}
}
extend<Element: Showable> Array<Element>: Showable {
	pub func show() -> String {
		let result = StringBuilder()
		result.append(string: "[")
		let i = 0
		loop i < self.count {
			result.append(string: self.get(i).show())
			if i < self.count - 1 { result.append(string: ", ") }
			i = i + 1
		}
		result.append(string: "]")
		result.finish()
	}
}

extend<Element: Equatable<Element>> Array<Element>: Equatable {
	func equals(_ rhs: Self) -> Bool {
		if self.count != rhs.count { return false }
		let i = 0
		loop i < self.count {
			if self.get(i) != rhs.get(i) { return false }
			i = i + 1
		}

		true
	}
}

extend<Element> Array<Element>: Iterable {
	pub func iter() -> IndexIterator<[Element]> {
		IndexIterator(inner: self, position: 0)
	}
}

extend<Element> Array<Element>: IndexIterable {
	pub func _index_iterable_count() -> Int {
		self.count
	}

	pub func _index_iterable_get(i index: Int) -> Optional<&Element> {
		.some(self.get(index))
	}
}

// MARK: Consuming iteration

pub struct ArrayIntoIterator<T> {
	pub let storage: Storage<T>
	pub let count: Int
	pub let position: Int
}

extend<Element> Array<Element>: IntoIterator<Element, ArrayIntoIterator<Element>> {
	pub consuming func into_iter() -> ArrayIntoIterator<Element> {
		self.uniqued_storage()
		let storage = self.storage
		let count = self.count
		self.storage = _storage<Element>(capacity: 0)
		self.count = 0
		self.capacity = 0
		ArrayIntoIterator(storage: storage, count: count, position: 0)
	}
}

extend<T> ArrayIntoIterator<T>: Iterator {
	pub mut func next() -> T? {
		if self.position > self.count - 1 { return Optional.none }
		let index = self.position
		self.position = self.position + 1
		let ptr: RawPtr = #_ir(self.storage.base, index) { %? = gep T $0 $1 }
		let element: T = _load<T>(ptr: ptr)
		return .some(element)
	}
}

extend<T> ArrayIntoIterator<T>: Deinit {
	consuming func deinit() -> Void {
		let i = self.position
		loop i < self.count {
			let ptr: RawPtr = #_ir(self.storage.base, i) { %? = gep T $0 $1 }
			let element: T = _load<T>(ptr: ptr)
			i = i + 1
		}
	}
}

// MARK: Mutable iteration

pub struct ArrayMutIterator<T> {
	pub let storage: &mut Storage<T>
	pub let count: Int
	pub let position: Int
}

extend<T> ArrayMutIterator<T>: Borrowed {}

extend<Element> Array<Element> {
	pub mut func iter_mut() -> ArrayMutIterator<Element> {
		let storage = self.uniqued_storage()
		ArrayMutIterator(storage: storage, count: self.count, position: 0)
	}
}

extend<T> ArrayMutIterator<T> {
	pub mut func next() -> T? {
		if self.position > self.count - 1 { return Optional.none }
		let index = self.position
		self.position = self.position + 1
		let ptr: RawPtr = #_ir(self.storage.base, index) { %? = gep T $0 $1 }
		let element: T = _load<T>(ptr: ptr)
		return .some(element)
	}

	pub mut func _store_current(consume value: T) -> Void {
		let ptr: RawPtr = #_ir(self.storage.base, self.position - 1) { %? = gep T $0 $1 }
		_store<T>(ptr: ptr, value: value)
	}
}

// Whether this array's buffer has exactly one owner. Implicit sharing
// duplicates values by retain at value boundaries, so a `Deinit` hook
// runs once per copy; a hook that must act exactly once per logical
// value (core containers' teardown, stdlib channel endpoints) gates on
// the owner count of a carried buffer, and this is that gate.
pub func _storage_is_unique<T>(xs: [T]) -> Bool {
	_is_unique(ptr: xs.storage.base)
}

// The exactly-once gate for `Deinit` hooks (ADR 0060). Implicit sharing
// duplicates values by retain, and a hook runs once per copy; a hook
// that must act exactly once per LOGICAL value carries a token and
// gates on `is_last()` — the copy that sees owner count 1 is the last
// one standing, wherever it drops. A fresh token is a fresh logical
// identity: clone-like operations construct a new one, compiler-made
// copies share it.
pub struct DropToken {
	let token: [Int]
}

extend DropToken {
	pub func is_last() -> Bool {
		_storage_is_unique(xs: self.token)
	}
}

pub func _drop_token() -> DropToken {
	let token: [Int] = []
	DropToken(token: token)
}
