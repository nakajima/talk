// no-core
use package::Optional::{ Optional }
use package::Operators::{ Add, Equatable }
use package::String::{ String }

pub struct DictNode<Value> 'heap {
	pub let key: String
	pub let value: Value
	pub let next: DictNode<Value>?
}

func dict_find<Value>(current: DictNode<Value>?, key: String) -> Optional<&Value> {
	match current {
		.some(node) -> {
			if node.key == key {
				Optional.some(node.value)
			} else {
				dict_find(current: node.next, key: key)
			}
		},
		.none -> Optional.none
	}
}

// A string-keyed dictionary over region-allocated ('heap) nodes: insertion
// conses in O(1); lookup walks linearly. A placeholder for a hash table
// until raw storage can hold heap elements.

pub struct Dict<Value> 'heap {
	pub let head: DictNode<Value>?
	pub let count: Int

	pub init() {
		self.head = Optional.none
		self.count = 0
		self
	}

	pub mut func insert(consume key: String, consume value: Value) -> Void {
		self.head = Optional.some(DictNode(key: key, value: value, next: self.head))
		self.count = self.count + 1
	}
}

extend<Value> Dict<Value> {
	pub func get(key: String) -> Optional<&Value> {
		dict_find(current: self.head, key: key)
	}
}
