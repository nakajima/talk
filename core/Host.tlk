// no-core
use package::IO::{ IORequest, io, STDERR_FD, write_string }
use package::Memory::{ alloc }
use package::Async::{ yield_now, park_recv, park_send, park_sleep, park_recv2, _chan_ctl }
use package::String::{ String }

pub effect 'panic(message: String) -> Never

// The host adapter, in source: one arm per request case, each a fixed
// entry in the runtime's io operation table. Exhaustiveness keeps this
// dispatcher and the request enum in lockstep — adding a case forces an
// arm here.
pub func _io_host(request: IORequest) -> Int {
	match request {
		.read(fd, buf, count) -> #_ir(fd, buf, count) { %? = io 0 $0 $1 $2 },
		.write(fd, buf, count) -> #_ir(fd, buf, count) { %? = io 1 $0 $1 $2 },
		.open(path, flags, mode) -> #_ir(path, flags, mode) { %? = io 2 $0 $1 $2 },
		.close(fd) -> #_ir(fd) { %? = io 3 $0 0 0 },
		.sleep(ms) -> #_ir(ms) { %? = io 4 $0 0 0 },
		.poll(fds, count, timeout) -> #_ir(fds, count, timeout) { %? = io 5 $0 $1 $2 },
		.ctl(fd, op, arg) -> #_ir(fd, op, arg) { %? = io 6 $0 $1 $2 },
		.socket(domain, socktype, proto) -> #_ir(domain, socktype, proto) { %? = io 7 $0 $1 $2 },
		.bind(fd, addr, port) -> #_ir(fd, addr, port) { %? = io 8 $0 $1 $2 },
		.listen(fd, backlog) -> #_ir(fd, backlog) { %? = io 9 $0 $1 0 },
		.connect(fd, addr, port) -> #_ir(fd, addr, port) { %? = io 10 $0 $1 $2 },
		.accept(fd) -> #_ir(fd) { %? = io 11 $0 0 0 },
		.cwd_len -> #_ir { %? = io 12 0 0 0 },
		.cwd_copy(buf) -> #_ir(buf) { %? = io 13 $0 0 0 },
		.getenv_len(name, name_len) -> #_ir(name, name_len) { %? = io 14 $0 $1 0 },
		.getenv_copy(name, name_len, buf) -> #_ir(name, name_len, buf) { %? = io 15 $0 $1 $2 },
		.argc -> #_ir { %? = io 16 0 0 0 },
		.arg_len(index) -> #_ir(index) { %? = io 17 $0 0 0 },
		.arg_copy(index, buf) -> #_ir(index, buf) { %? = io 18 $0 $1 0 },
		.dir_count(path) -> #_ir(path) { %? = io 19 $0 0 0 },
		.dir_entry_kind(path, index) -> #_ir(path, index) { %? = io 20 $0 $1 0 },
		.dir_entry_len(path, index) -> #_ir(path, index) { %? = io 21 $0 $1 0 },
		.dir_entry_copy(path, index, buf) -> #_ir(path, index, buf) { %? = io 22 $0 $1 $2 },
		.exit(code) -> #_ir(code) { %? = io 23 $0 0 0 },
		.realpath_len(path) -> #_ir(path) { %? = io 24 $0 0 0 },
		.realpath_copy(path, buf) -> #_ir(path, buf) { %? = io 25 $0 $1 0 },
		.seek(fd, offset, whence) -> #_ir(fd, offset, whence) { %? = io 26 $0 $1 $2 },
		.file_size(fd) -> #_ir(fd) { %? = io 27 $0 0 0 }
	}
}

// The executable's host fallbacks (ADR 0039): ordinary handlers below
// every user handler, installed around the whole program by the entry
// wrapper. Which effects are ambient at the top level is exactly the
// row this callback declares — the compiler reads it from this
// signature rather than naming any effect itself. Resumable fallbacks
// continue; panic is the abortive process-termination fallback.
// Deliberately NOT delegated to `_with_host_value` through an adapter
// closure: a closure captures its effect capabilities at CREATION, and
// any adapter made here would capture before these fallbacks exist.
// The handler set is duplicated below instead.
pub func _with_host(consume body: () '[io, alloc, yield_now, panic, park_recv, park_send, park_sleep, park_recv2] -> ()) -> () {
	#handle 'io { request in
		'continue _io_host(request: request)
	}
	#handle 'alloc { allocation in
		'continue
	}
	#handle 'yield_now {
		'continue
	}
	#handle 'panic { message in
		write_string(fd: STDERR_FD, s: message)
		write_string(fd: STDERR_FD, s: "\n")
		_io_host(request: .exit(1))
		loop {}
	}
	// The blocking park fallbacks (ADR 0067/0068): tail-resumptive
	// clauses — register the interest, block the worker, unregister,
	// continue at the perform site. No resumption is reified and no
	// frame moves, so a long-lived producer parks in constant stack.
	// The resumed operation re-checks its source itself, so a spurious
	// wake just parks again.
	#handle 'park_recv { handle in
		let registered = _chan_ctl(handle: handle, op: 4)
		let parked = _chan_ctl(handle: 0, op: 6)
		let released = _chan_ctl(handle: handle, op: 5)
		'continue
	}
	#handle 'park_send { handle in
		let registered = _chan_ctl(handle: handle, op: 11)
		let parked = _chan_ctl(handle: 0, op: 6)
		let released = _chan_ctl(handle: handle, op: 12)
		'continue
	}
	#handle 'park_sleep { deadline_ms in
		let registered = _chan_ctl(handle: deadline_ms, op: 14)
		let parked = _chan_ctl(handle: 0, op: 6)
		let released = _chan_ctl(handle: deadline_ms, op: 15)
		'continue
	}
	#handle 'park_recv2 { a, b in
		let first = _chan_ctl(handle: a, op: 4)
		let second = _chan_ctl(handle: b, op: 4)
		let parked = _chan_ctl(handle: 0, op: 6)
		let drop_second = _chan_ctl(handle: b, op: 5)
		let drop_first = _chan_ctl(handle: a, op: 5)
		'continue
	}
	body()
}
