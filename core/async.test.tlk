// One-shot resumptions (ADR 0064) and the channel/clock runtime surface
// (ADR 0067), tested at the core level.

effect 'step(value: Int) -> Int

enum Held {
	case parked(Resumption<Int, Held>)
	case done(Int)
}

func emit_upto(limit: Int) -> Int {
	let i = 1
	let acc = 0
	loop i <= limit {
		acc = acc + 'step(value: i)
		i = i + 1
	}
	acc
}

func drive_resuming() -> Int {
	#handle 'step { value, k in resume(k: k, value: value * 10) }
	emit_upto(limit: 3)
}

func drive_cancelling() -> Int {
	#handle 'step { value, k in
		let done = cancel(k: k)
		value + 500
	}
	emit_upto(limit: 3)
}

func drive_holding() -> Held {
	#handle 'step { value, k in Held.parked(k) }
	Held.done(emit_upto(limit: 1))
}

func settle(consume held: Held) -> Int {
	match held {
		.parked(k) -> settle(held: resume(k: k, value: 41)),
		.done(value) -> value
	}
}

test "resuming delivers values and the extent's answer returns" {
	assert(drive_resuming() == 60)
}

test "a clause that cancels aborts with its own value" {
	assert(drive_cancelling() == 501)
}

test "resumptions escape their clause and finish later" {
	assert(settle(held: drive_holding()) == 41)
}

test "channel ops enqueue, take, and observe closes" {
	let handle = _chan_ctl(handle: 0, op: 7)
	assert(_chan_ctl(handle: handle, op: 0) == 1)
	_chan_send(handle: handle, value: 9)
	assert(_chan_ctl(handle: handle, op: 0) == 0)
	assert(_chan_take<Int>(handle: handle) == 9)
	let sender_gone = _chan_ctl(handle: handle, op: 2)
	assert(_chan_ctl(handle: handle, op: 0) == 2)
	let receiver_gone = _chan_ctl(handle: handle, op: 3)
}

test "the monotonic clock advances" {
	let before = _chan_ctl(handle: 0, op: 13)
	let after = _chan_ctl(handle: 0, op: 13)
	assert(after >= before)
}

// === Unified wait ====================================================
//
// The unified 'wait effect (core Async): an array of WaitReason values
// survives the perform, decodes in one handler, and drives the runtime's
// register/park/unregister ops. The
// local handler shadows the ambient blocking fallback so the test can
// observe the registration counts.

func drive_unified_wait() -> Int {
	#handle 'wait { reasons in
		let i = 0
		loop i < reasons.count {
			match reasons.get(i) {
				.recv(handle) -> {
					let registered = _chan_ctl(handle: handle, op: 4)
					()
				},
				.send(handle) -> {
					let registered = _chan_ctl(handle: handle, op: 11)
					()
				},
				.deadline(instant) -> {
					let registered = _chan_ctl(handle: instant._nanoseconds(), op: 14)
					()
				}
			}
			i = i + 1
		}
		// Every reason routed to its registration op: waits + deadlines.
		assert(_chan_ctl(handle: 0, op: 8) == reasons.count)
		let parked = _chan_ctl(handle: 0, op: 6)
		let j = 0
		loop j < reasons.count {
			match reasons.get(j) {
				.recv(handle) -> {
					let released = _chan_ctl(handle: handle, op: 5)
					()
				},
				.send(handle) -> {
					let released = _chan_ctl(handle: handle, op: 12)
					()
				},
				.deadline(instant) -> {
					let released = _chan_ctl(handle: instant._nanoseconds(), op: 15)
					()
				}
			}
			j = j + 1
		}
		assert(_chan_ctl(handle: 0, op: 8) == 0)
		'continue
	}
	// A ready channel wakes a mixed wait before its far deadline.
	let handle = _chan_ctl(handle: 0, op: 7)
	_chan_send(handle: handle, value: 7)
	let far = Instant.now().adding(Duration.hours(1))
	'wait(reasons: [WaitReason.recv(handle), WaitReason.deadline(far)])
	let first = _chan_take<Int>(handle: handle)
	let sender_gone = _chan_ctl(handle: handle, op: 2)
	let receiver_gone = _chan_ctl(handle: handle, op: 3)
	// A bounded channel with room wakes a send wait immediately.
	let bounded = _chan_ctl(handle: 1, op: 7)
	'wait(reasons: [WaitReason.send(bounded)])
	let bounded_sender_gone = _chan_ctl(handle: bounded, op: 2)
	let bounded_receiver_gone = _chan_ctl(handle: bounded, op: 3)
	// An elapsed deadline wakes alone.
	'wait(reasons: [WaitReason.deadline(Instant.now())])
	first
}

test "one 'wait effect decodes mixed reasons" {
	assert(drive_unified_wait() == 7)
}
