// no-core
pub enum Poll<T, Y> {
	case ready(T)
	case pending(Y)
}

pub enum FuturePoll<T> {
	case ready(T)
	case pending
}

pub struct Waker {
	let task_id: Int

	pub init(task_id: Int) {
		self.task_id = task_id
		self
	}
}

pub struct Context {
	let waker: Waker

	pub init(waker: Waker) {
		self.waker = waker
		self
	}
}

pub protocol Future {
	associated Output
	func poll(cx: Context) -> FuturePoll<Output>
}

pub effect 'async() -> ()
