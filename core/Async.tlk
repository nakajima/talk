// no-core
use package::InlineArray::{ InlineArray }
use package::Time::{ Instant }

// Direct-style concurrency (ADR 0067) over one-shot resumptions
// (ADR 0064/0068). A blocking host waits the worker and continues;
// a cooperative scheduler binds the resumption and waits only the task.

// Give another ready task a chance to run. A blocking host continues
// immediately when no cooperative scheduler intercepts it.
pub effect 'yield() -> ()

// Wait until any channel has a value or closes. Static specialization
// keeps the handle list inline while one source handler covers every N.
pub effect 'recv<static N: Int>(channels: [Int; N]) -> ()

// Wait until a bounded channel has room or its receiver is gone.
pub effect 'send(handle: Int) -> ()

// Wait until the monotonic clock reaches an absolute deadline.
pub effect 'wait_until(deadline: Instant) -> ()

// === Task runtime (ADR 0058) ==========================================
//
// The runtime half of the structured parallel executor: spawn hands a
// worker closure to the runtime under a fresh executor-internal handle,
// and join transfers the worker's output back exactly once (joining an
// invalid or already-joined handle traps). Whether workers run on other
// OS threads or inline is runtime policy, never semantics. Handles never
// leave the structured stdlib scope that spawned them.

// The worker takes its state as an argument rather than a capture: the
// transfer is explicit at the boundary, and the closure itself stays
// environment-free.
pub func _task_spawn<A, T>(consume arg: A, consume worker: (consume A) -> T) -> Int {
	#_ir(arg, worker) { %? = task_spawn $0 $1 }
}

pub func _task_join<T>(handle: Int) -> T {
	#_ir(handle) { %? = task_join T $0 }
}

// The host's available parallelism (at least 1).
pub func _task_width() -> Int {
	#_ir { %? = task_width }
}

// === Channel runtime (ADR 0059) =======================================
//
// Cross-worker transfer queues behind runtime-minted handles: send
// enqueues a transferred value and wakes parked receivers, take pops a
// value the status op has proven present, and the control op carries
// the scalar lifecycle (create, status, sender/receiver retain and
// drop, external-wait registration, park). Handles never leave the
// stdlib channel types that wrap them.

pub func _chan_send<T>(handle: Int, consume value: T) -> Void {
	#_ir(handle, value) { chan_send $0 $1 }
}

pub func _chan_take<T>(handle: Int) -> T {
	#_ir(handle) { %? = chan_take T $0 }
}

// Ops: 0 status (0 value ready, 1 empty and open, 2 closed and
// drained), 1 retain sender, 2 drop sender, 3 drop receiver,
// 4 register an external wait, 5 unregister, 6 park, 7 create (the
// handle operand carries the capacity; 0 = unbounded), 8 count this
// worker's external waits, 9 whether the receiver is still live,
// 10 atomically reserve a send slot (1 on success), 11 register a
// send-wait, 12 unregister one, 13 monotonic now (ns), 14 register a
// deadline (the handle operand, absolute ns), 15 unregister one.
pub func _chan_ctl(handle: Int, op: Int) -> Int {
	#_ir(handle, op) { %? = chan_ctl $0 $1 }
}

// === One-shot resumptions (ADR 0064) ==================================
//
// A suspending effect's perform captures its extent — the installing
// frame through the perform site — into a stored resumption, and the
// handler clause binds it as a final `Resumption<R, A>` parameter:
// `R` is what resuming supplies to the perform site, `A` the handled
// extent's answer. The struct is linear: a resumption is resumed or
// cancelled exactly once, statically. The slot names a worker-local
// segment; the runtime's take of that slot is the dynamic backstop,
// and linearity (which never derives Send) keeps resumptions on the
// worker that minted them.

pub struct Resumption<R, A> 'linear {
	let slot: Int
}

// Deliver `value` to the suspended perform site and run the extent to
// its next suspension or completion; the return value is the extent's
// answer either way.
pub func resume<R, A>(consume k: Resumption<R, A>, value: R) -> A {
	#_ir(k, value) { %? = resume A $0 $1 }
}

// Discard a suspended extent, unwinding every captured frame through
// its cleanup entries — cancellation cannot leak.
pub func cancel<R, A>(consume k: Resumption<R, A>) -> () {
	#_ir(k) { cancel $0 }
}
