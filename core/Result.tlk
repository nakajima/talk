// no-core
use package::Operators::{ Equatable }

// A recoverable computation result. Libraries can return this when failure
// is part of their ordinary API rather than an effect or process failure.
pub enum Result<Success, Failure> {
	case ok(Success)
	case error(Failure)

	pub func is_ok() -> Bool {
		match self {
			.ok(_) -> true,
			.error(_) -> false
		}
	}

	pub func is_error() -> Bool {
		match self {
			.ok(_) -> false,
			.error(_) -> true
		}
	}

	pub consuming func map<T>(ok: (consume Success) -> T) -> Result<T, Failure> {
		match self {
			.ok(val) -> .ok(ok(val)),
			.error(e) -> .error(e)
		}
	}

	pub consuming func map<T>(err: (consume Failure) -> T) -> Result<Success, T> {
		match self {
			.ok(ok) -> .ok(ok),
			.error(e) -> .error(err(e))
		}
	}
}

extend<Success, Failure> Result<Success, Failure>: Equatable where Success: Equatable<Success> && Failure: Equatable<Failure> {
	pub func equals(_ rhs: Self) -> Bool {
		match self {
			.ok(left) -> {
				match rhs {
					.ok(right) -> left == right,
					.error(_) -> false
				}
			},
			.error(left) -> {
				match rhs {
					.ok(_) -> false,
					.error(right) -> left == right
				}
			}
		}
	}
}
