// no-core
// UTF-8 and Unicode segmentation support for String's Character layer.
//
// `_utf8_decode` returns one packed Int: scalar * 8 + size, where size is
// the number of bytes consumed (1-4). Packing avoids a per-scalar record
// allocation on the hot iteration path.
//
// Ill-formed input consumes a maximal subpart (Unicode 17.0 §3.9.6, the
// same policy as Rust's from_utf8_lossy and WHATWG): a truncated-but-valid
// prefix is one error unit, a lone continuation or invalid lead is one
// byte. Error units decode as U+FFFD for classification, but callers keep
// viewing the raw bytes — iteration over any byte string is lossless.
use package::Operators::{ Add, Comparable, Divide, Equatable, Multiply, Subtract }
use package::Memory::{ ByteStorage }
use package::String::{ String, Substring }
use package::Ownership::{ Borrowed }
use package::Optional::{ Optional }
use package::Iterable::{ Iterable, Iterator }
use package::Showable::{ Showable }
use package::UnicodeData::{ _CC_ALPHABETIC, _CC_ALPHANUMERIC, _CC_NUMERIC, _CC_OTHER, _CC_WHITESPACE, _GC_CONTROL, _GC_CR, _GC_EXTEND, _GC_EXTEND_INCB_EXTEND, _GC_EXTEND_INCB_LINKER, _GC_EXT_PICT, _GC_HANGUL_L, _GC_HANGUL_LV, _GC_HANGUL_LVT, _GC_HANGUL_T, _GC_HANGUL_V, _GC_INCB_CONSONANT, _GC_LF, _GC_OTHER, _GC_PREPEND, _GC_REGIONAL_INDICATOR, _GC_SPACINGMARK, _GC_ZWJ, _character_class_table, _gcb_table }
use package::TextUnicodeData::{ _canonical_decomposition_index, _canonical_decomposition_payload, _casefold_index, _casefold_payload, _combining_class_table, _compatibility_decomposition_index, _compatibility_decomposition_payload, _composition_table, _lowercase_index, _lowercase_payload, _text_property_table, _titlecase_index, _titlecase_payload, _uppercase_index, _uppercase_payload, _word_break_table }
use package::Ownership::{ Clone }

// talk has no bitwise operators; UTF-8's masks and shifts are powers of
// two, so / and * and - do the same work.
func _is_continuation(b: Int) -> Bool {
	if b < 128 { return false }
	b < 192
}

// Decodes one UTF-8 scalar and packs its value with the consumed byte count.
// Malformed input yields U+FFFD and consumes one maximal invalid subpart.
pub func _utf8_decode(storage: ByteStorage, offset: Int, end: Int) -> Int {
	let replacement: Int = 65533
	let b0: Int = storage.get(offset)._toInt()

	// 0xxxxxxx: ASCII.
	if b0 < 128 { return b0 * 8 + 1 }

	// Continuation bytes and the overlong leads C0/C1 cannot start a
	// character.
	if b0 < 194 { return replacement * 8 + 1 }

	// 110xxxxx 10xxxxxx: leads C2..DF.
	if b0 < 224 {
		if end <= offset + 1 { return replacement * 8 + 1 }
		let b1: Int = storage.get(offset + 1)._toInt()
		if _is_continuation(b: b1) == false { return replacement * 8 + 1 }
		let scalar: Int = (b0 - 192) * 64 + (b1 - 128)
		return scalar * 8 + 2
	}

	// 1110xxxx 10xxxxxx 10xxxxxx: leads E0..EF. E0 narrows the first
	// continuation to A0..BF (no overlongs); ED narrows it to 80..9F
	// (no surrogates).
	if b0 < 240 {
		if end <= offset + 1 { return replacement * 8 + 1 }
		let b1: Int = storage.get(offset + 1)._toInt()
		let lo: Int = if b0 == 224 {
			160
		} else {
			128
		}
		let hi: Int = if b0 == 237 {
			159
		} else {
			191
		}
		if b1 < lo { return replacement * 8 + 1 }
		if hi < b1 { return replacement * 8 + 1 }
		if end <= offset + 2 { return replacement * 8 + 2 }
		let b2: Int = storage.get(offset + 2)._toInt()
		if _is_continuation(b: b2) == false { return replacement * 8 + 2 }
		let scalar: Int = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)
		return scalar * 8 + 3
	}

	// 11110xxx + 3 continuations: leads F0..F4. F0 narrows the first
	// continuation to 90..BF (no overlongs); F4 narrows it to 80..8F
	// (nothing above U+10FFFF).
	if b0 < 245 {
		if end <= offset + 1 { return replacement * 8 + 1 }
		let b1: Int = storage.get(offset + 1)._toInt()
		let lo: Int = if b0 == 240 {
			144
		} else {
			128
		}
		let hi: Int = if b0 == 244 {
			143
		} else {
			191
		}
		if b1 < lo { return replacement * 8 + 1 }
		if hi < b1 { return replacement * 8 + 1 }
		if end <= offset + 2 { return replacement * 8 + 2 }
		let b2: Int = storage.get(offset + 2)._toInt()
		if _is_continuation(b: b2) == false { return replacement * 8 + 2 }
		if end <= offset + 3 { return replacement * 8 + 3 }
		let b3: Int = storage.get(offset + 3)._toInt()
		if _is_continuation(b: b3) == false { return replacement * 8 + 3 }
		let scalar: Int = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)
		return scalar * 8 + 4
	}

	// F5..FF: never valid leads.
	replacement * 8 + 1
}

// One table entry (four big-endian base-128 septets; see gen_unicode).
func _entry_value(storage: ByteStorage, index: Int) -> Int {
	let base: Int = index * 4
	let v0: Int = storage.get(base)._toInt()
	let v1: Int = storage.get(base + 1)._toInt()
	let v2: Int = storage.get(base + 2)._toInt()
	let v3: Int = storage.get(base + 3)._toInt()
	((v0 * 128 + v1) * 128 + v2) * 128 + v3
}

func _septet_value(storage: ByteStorage, start: Int, width: Int) -> Int {
	let value = 0
	let i = 0
	loop i < width {
		value = value * 128 + storage.get(start + i)._toInt()
		i = i + 1
	}
	value
}

func _boundary_property(table: String, scalar: Int, width: Int, radix: Int) -> Int {
	let entry_count = table.byte_count / width
	let lo = 0
	let hi = entry_count - 1
	loop lo < hi {
		let mid = (lo + hi + 1) / 2
		let encoded = _septet_value(
			storage: table.storage,
			start: mid * width,
			width: width
		)
		if scalar < encoded / radix {
			hi = mid - 1
		} else {
			lo = mid
		}
	}
	let encoded = _septet_value(
		storage: table.storage,
		start: lo * width,
		width: width
	)
	encoded - (encoded / radix) * radix
}

func _mapping(index: String, payload: String, scalar: Int) -> Substring? {
	let width = 7
	let count = index.byte_count / width
	let lo = 0
	let hi = count - 1
	loop lo <= hi {
		let mid = (lo + hi) / 2
		let base = mid * width
		let candidate = _septet_value(storage: index.storage, start: base, width: 3)
		if scalar < candidate {
			hi = mid - 1
		} else {
			if scalar > candidate {
				lo = mid + 1
			} else {
				let offset = _septet_value(storage: index.storage, start: base + 3, width: 3)
				let length = index.storage.get(base + 6)._toInt()
				return .some(
					Substring(storage: payload.storage, start: offset, byte_count: length)
				)
			}
		}
	}
	.none
}

// The scalar's grapheme-cluster-break category (a _GC_* constant), via
// binary search over the generated boundary list. O(log n) with ~12
// probes; ASCII short-circuits.
pub func _grapheme_category(scalar: Int) -> Int {
	if scalar == 13 { return _GC_CR }
	if scalar == 10 { return _GC_LF }
	if scalar < 32 { return _GC_CONTROL }
	if scalar < 127 { return _GC_OTHER }

	let table: String = _gcb_table()
	let entry_count: Int = table.byte_count / 4
	// The last entry whose start <= scalar.
	let lo: Int = 0
	let hi: Int = entry_count - 1
	loop lo < hi {
		let mid: Int = (lo + hi + 1) / 2
		let mid_start: Int = _entry_value(storage: table.storage, index: mid) / 32
		if scalar < mid_start {
			hi = mid - 1
		} else {
			lo = mid
		}
	}
	let v: Int = _entry_value(storage: table.storage, index: lo)
	v - (v / 32) * 32
}

// Returns whether the scalar has the Unicode extended pictographic property.
pub func scalar_is_extended_pictographic(scalar: Int) -> Bool {
	_grapheme_category(scalar: scalar) == _GC_EXT_PICT
}

func _packed_scalar(packed: Int) -> Int {
	packed / 8
}

func _packed_size(packed: Int) -> Int {
	packed - (packed / 8) * 8
}

// Look up a scalar in the generated character-property partition.
func _character_class(scalar: Int) -> Int {
	if scalar < 0 { return _CC_OTHER }
	if 1114111 < scalar { return _CC_OTHER }

	let table: String = _character_class_table()
	let entry_count: Int = table.byte_count / 4
	let lo: Int = 0
	let hi: Int = entry_count - 1
	loop lo < hi {
		let mid: Int = (lo + hi + 1) / 2
		let mid_start: Int = _entry_value(storage: table.storage, index: mid) / 32
		if scalar < mid_start {
			hi = mid - 1
		} else {
			lo = mid
		}
	}
	let v: Int = _entry_value(storage: table.storage, index: lo)
	v - (v / 32) * 32
}

// Tests the scalar against Unicode's `White_Space` property.
pub func scalar_is_whitespace(scalar: Int) -> Bool {
	_character_class(scalar: scalar) == _CC_WHITESPACE
}

// Tests the scalar against Unicode's `Alphabetic` property.
pub func scalar_is_alphabetic(scalar: Int) -> Bool {
	let cat: Int = _character_class(scalar: scalar)
	cat == _CC_ALPHABETIC || cat == _CC_ALPHANUMERIC
}

// Returns true for decimal, digit, or other numeric Unicode scalars.
pub func scalar_is_numeric(scalar: Int) -> Bool {
	let cat: Int = _character_class(scalar: scalar)
	cat == _CC_NUMERIC || cat == _CC_ALPHANUMERIC
}

// Returns true when the scalar is Unicode alphabetic or numeric.
pub func scalar_is_alphanumeric(scalar: Int) -> Bool {
	scalar_is_alphabetic(scalar: scalar) || scalar_is_numeric(scalar: scalar)
}

// Returns true when `scalar` is the code point for `0...9`.
pub func scalar_is_ascii_digit(scalar: Int) -> Bool {
	47 < scalar && scalar < 58
}

// Returns true for ASCII `0...9`, `a...f`, or `A...F`.
pub func scalar_is_ascii_hexdigit(scalar: Int) -> Bool {
	if scalar_is_ascii_digit(scalar: scalar) { return true }
	if 64 < scalar && scalar < 71 { return true }
	96 < scalar && scalar < 103
}

func _has_property(scalar: Int, bit: Int) -> Bool {
	let flags = _boundary_property(
		table: _text_property_table(),
		scalar: scalar,
		width: 5,
		radix: 4096
	)
	(flags / bit - (flags / (bit * 2)) * 2) == 1
}

// Tests the scalar against Unicode's `Lowercase` property.
pub func scalar_is_lowercase(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 1)
}
// Tests the scalar against Unicode's `Uppercase` property.
pub func scalar_is_uppercase(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 2)
}
// Returns true when the scalar has Unicode general category `Lt`.
pub func scalar_is_titlecase(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 4)
}
// Returns true when the scalar has Unicode general category `Nd`.
pub func scalar_is_decimal(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 8)
}
// Tests whether Unicode assigns the scalar decimal or digit numeric status.
pub func scalar_is_digit(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 16)
}
// Returns true for any Unicode punctuation general category.
pub func scalar_is_punctuation(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 32)
}
// Returns true for any Unicode symbol general category.
pub func scalar_is_symbol(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 64)
}
// Returns true when the scalar has Unicode general category `Cc`.
pub func scalar_is_control(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 128)
}
// Excludes control, format, surrogate, private-use, and unassigned categories.
pub func scalar_is_printable(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 256)
}
// Tests Unicode's derived `Cased` property used by case conversion.
pub func scalar_is_cased(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 512)
}
// Tests Unicode's `Case_Ignorable` property used when finding cased neighbors.
pub func scalar_is_case_ignorable(scalar: Int) -> Bool {
	_has_property(scalar: scalar, bit: 1024)
}

// Internal code for UAX #29 word-break category `Other`.
pub let _WB_OTHER: Int = 0
// Internal code for UAX #29 word-break category `CR`.
pub let _WB_CR: Int = 1
// Internal code for UAX #29 word-break category `LF`.
pub let _WB_LF: Int = 2
// Internal code for UAX #29 word-break category `Newline`.
pub let _WB_NEWLINE: Int = 3
// Internal code for UAX #29 word-break category `Extend`.
pub let _WB_EXTEND: Int = 4
// Internal code for UAX #29 word-break category `ZWJ`.
pub let _WB_ZWJ: Int = 5
// Internal code for UAX #29 word-break category `Regional_Indicator`.
pub let _WB_REGIONAL_INDICATOR: Int = 6
// Internal code for UAX #29 word-break category `Format`.
pub let _WB_FORMAT: Int = 7
// Internal code for UAX #29 word-break category `Katakana`.
pub let _WB_KATAKANA: Int = 8
// Internal code for UAX #29 word-break category `Hebrew_Letter`.
pub let _WB_HEBREW_LETTER: Int = 9
// Internal code for UAX #29 word-break category `ALetter`.
pub let _WB_ALETTER: Int = 10
// Internal code for UAX #29 word-break category `Single_Quote`.
pub let _WB_SINGLE_QUOTE: Int = 11
// Internal code for UAX #29 word-break category `Double_Quote`.
pub let _WB_DOUBLE_QUOTE: Int = 12
// Internal code for UAX #29 word-break category `MidNumLet`.
pub let _WB_MIDNUMLET: Int = 13
// Internal code for UAX #29 word-break category `MidLetter`.
pub let _WB_MIDLETTER: Int = 14
// Internal code for UAX #29 word-break category `MidNum`.
pub let _WB_MIDNUM: Int = 15
// Internal code for UAX #29 word-break category `Numeric`.
pub let _WB_NUMERIC: Int = 16
// Internal code for UAX #29 word-break category `ExtendNumLet`.
pub let _WB_EXTENDNUMLET: Int = 17
// Internal code for UAX #29 word-break category `WSegSpace`.
pub let _WB_WSEGSPACE: Int = 18
// Internal code for the extended-pictographic override used by UAX #29.
pub let _WB_EXTENDED_PICTOGRAPHIC: Int = 19

// Looks up the Unicode word-break category assigned to `scalar`.
pub func _word_break_category(scalar: Int) -> Int {
	_boundary_property(
		table: _word_break_table(),
		scalar: scalar,
		width: 4,
		radix: 32
	)
}

// Borrows the full Unicode case mapping for one scalar.
//
// `kind` selects lowercase (0), uppercase (1), titlecase (2), or case folding
// (3 and other values). Mappings may contain multiple scalars; `none` means the
// input maps to itself.
pub func _case_mapping(scalar: Int, kind: Int) -> Substring? {
	if kind == 0 { return _mapping(
		index: _lowercase_index(),
		payload: _lowercase_payload(),
		scalar: scalar
	) }
	if kind == 1 { return _mapping(
		index: _uppercase_index(),
		payload: _uppercase_payload(),
		scalar: scalar
	) }
	if kind == 2 { return _mapping(
		index: _titlecase_index(),
		payload: _titlecase_payload(),
		scalar: scalar
	) }
	_mapping(index: _casefold_index(), payload: _casefold_payload(), scalar: scalar)
}

// Looks up a normalization decomposition without allocating.
//
// `compatibility = false` selects canonical mappings for NFC/NFD;
// `true` also admits compatibility mappings for NFKC/NFKD. `none` means the
// scalar decomposes to itself.
pub func _decomposition(scalar: Int, compatibility: Bool) -> Substring? {
	if compatibility {
		_mapping(
			index: _compatibility_decomposition_index(),
			payload: _compatibility_decomposition_payload(),
			scalar: scalar
		)
	} else {
		_mapping(
			index: _canonical_decomposition_index(),
			payload: _canonical_decomposition_payload(),
			scalar: scalar
		)
	}
}

// Returns `scalar`'s canonical combining class.
pub func _combining_class(scalar: Int) -> Int {
	_boundary_property(
		table: _combining_class_table(),
		scalar: scalar,
		width: 5,
		radix: 256
	)
}

// Looks up canonical composition for a starter and following combining scalar.
//
// Hangul syllables are composed algorithmically; all other pairs use the
// generated Unicode composition table. `none` leaves the pair decomposed.
pub func _compose_pair(starter: Int, combining: Int) -> Int? {
	let table = _composition_table()
	let width = 9
	let lo = 0
	let hi = table.byte_count / width - 1
	loop lo <= hi {
		let mid = (lo + hi) / 2
		let base = mid * width
		let left = _septet_value(storage: table.storage, start: base, width: 3)
		let right = _septet_value(storage: table.storage, start: base + 3, width: 3)
		if starter < left || (starter == left && combining < right) {
			hi = mid - 1
		} else {
			if starter > left || (starter == left && combining > right) {
				lo = mid + 1
			} else {
				return .some(_septet_value(storage: table.storage, start: base + 6, width: 3))
			}
		}
	}
	.none
}

// Whether `cat` extends the current cluster under GB9 (Extend and ZWJ,
// including the InCB refinements of Extend).
func _extends_cluster(cat: Int) -> Bool {
	if cat == _GC_EXTEND { return true }
	if cat == _GC_EXTEND_INCB_LINKER { return true }
	if cat == _GC_EXTEND_INCB_EXTEND { return true }
	cat == _GC_ZWJ
}

// Whether a scalar of category `cat` joins the cluster whose previous
// scalar had category `prev`, given the cluster-local rule state (UAX #29
// GB4-GB999; GB3 is handled by the caller's CR fast path).
func _joins(prev: Int, cat: Int, emoji: Int, incb: Int, ri_run: Int) -> Bool {
	// GB4/GB5: controls always split.
	if cat == _GC_CONTROL { return false }
	if cat == _GC_CR { return false }
	if cat == _GC_LF { return false }
	// GB9/GB9a: extending marks, ZWJ, and spacing marks join.
	if _extends_cluster(cat: cat) { return true }
	if cat == _GC_SPACINGMARK { return true }
	// GB9b: anything joins after a prepend.
	if prev == _GC_PREPEND { return true }
	// GB6/GB7/GB8: Hangul jamo composition.
	if prev == _GC_HANGUL_L {
		if cat == _GC_HANGUL_L { return true }
		if cat == _GC_HANGUL_V { return true }
		if cat == _GC_HANGUL_LV { return true }
		if cat == _GC_HANGUL_LVT { return true }
	}
	let after_vowel: Bool = prev == _GC_HANGUL_LV || prev == _GC_HANGUL_V
	if after_vowel {
		if cat == _GC_HANGUL_V { return true }
		if cat == _GC_HANGUL_T { return true }
	}
	let after_trailer: Bool = prev == _GC_HANGUL_LVT || prev == _GC_HANGUL_T
	if after_trailer {
		if cat == _GC_HANGUL_T { return true }
	}
	// GB9c: a consonant joins when a linker (through InCB extends) sits
	// between it and the previous consonant.
	let conjunct: Bool = cat == _GC_INCB_CONSONANT && incb == 2
	if conjunct { return true }
	// GB11: emoji ZWJ sequences continue after ExtPict Extend* ZWJ.
	let emoji_zwj: Bool = cat == _GC_EXT_PICT && emoji == 2
	if emoji_zwj { return true }
	// GB12/GB13: a regional indicator pairs with an odd-length run.
	let ri_pair: Bool = cat == _GC_REGIONAL_INDICATOR && prev == _GC_REGIONAL_INDICATOR
	if ri_pair { return (ri_run - (ri_run / 2) * 2) == 1 }
	false
}

// The byte offset just past the extended grapheme cluster starting at
// `offset`, which must itself be a cluster boundary. Because scans start
// at true boundaries, all UAX #29 rule state (GB11's emoji sequence,
// GB9c's conjunct chain, GB12/13's regional-indicator parity) is local to
// this one scan — the iterator carries none.
pub func _next_boundary(storage: ByteStorage, offset: Int, end: Int) -> Int {
	let head: Int = _utf8_decode(storage: storage, offset: offset, end: end)
	let head_cat: Int = _grapheme_category(scalar: _packed_scalar(packed: head))
	let pos: Int = offset + _packed_size(packed: head)

	// GB3/GB4: CR joins only a following LF; controls stand alone.
	if head_cat == _GC_CR {
		if pos < end {
			let after_cr: Int = _utf8_decode(storage: storage, offset: pos, end: end)
			if _packed_scalar(packed: after_cr) == 10 { return pos + _packed_size(
				packed: after_cr
			) }
		}
		return pos
	}
	if head_cat == _GC_CONTROL { return pos }
	if head_cat == _GC_LF { return pos }

	let prev: Int = head_cat
	// GB11 state: 0 none, 1 ExtPict (+ extends), 2 ExtPict + extends + ZWJ.
	let emoji: Int = 0
	if head_cat == _GC_EXT_PICT { emoji = 1 }
	// GB9c state: 0 none, 1 consonant (+ InCB extends), 2 consonant + linker.
	let incb: Int = 0
	if head_cat == _GC_INCB_CONSONANT { incb = 1 }
	// GB12/13 state: length of the trailing regional-indicator run.
	let ri_run: Int = 0
	if head_cat == _GC_REGIONAL_INDICATOR { ri_run = 1 }

	loop pos < end {
		let next_packed: Int = _utf8_decode(storage: storage, offset: pos, end: end)
		let cat: Int = _grapheme_category(scalar: _packed_scalar(packed: next_packed))
		if _joins(prev: prev, cat: cat, emoji: emoji, incb: incb, ri_run: ri_run) == false { return pos }

		if cat == _GC_EXT_PICT {
			emoji = 1
		} else {
			let emoji_extends: Bool = emoji == 1 && _extends_cluster(cat: cat)
			if emoji_extends {
				if cat == _GC_ZWJ { emoji = 2 }
			} else {
				emoji = 0
			}
		}
		if cat == _GC_INCB_CONSONANT {
			incb = 1
		} else {
			let links: Bool = incb >= 1 && cat == _GC_EXTEND_INCB_LINKER
			let carries: Bool = incb >= 1 && (cat == _GC_EXTEND_INCB_EXTEND || cat == _GC_ZWJ)
			if links {
				incb = 2
			} else {
				if carries == false { incb = 0 }
			}
		}
		if cat == _GC_REGIONAL_INDICATOR {
			if prev == _GC_REGIONAL_INDICATOR {
				ri_run = ri_run + 1
			} else {
				ri_run = 1
			}
		} else {
			ri_run = 0
		}
		prev = cat
		pos = pos + _packed_size(packed: next_packed)
	}
	pos
}

// One extended grapheme cluster, represented as a borrowed UTF-8 byte range.
//
// The range is produced by UAX #29 boundary iteration and may contain several
// Unicode scalars. Classification uses the first scalar, while equality is
// exact byte equality and does not normalize canonically equivalent text.
pub struct Character {
	// The backing storage.
	pub let storage: ByteStorage
	// The inclusive starting byte offset in the source.
	pub let start: Int
	// The number of bytes in the encoded representation.
	pub let byte_count: Int

	// Returns this grapheme cluster's encoded byte length, not its scalar
	// count.
	pub func utf8_count() -> Int {
		self.byte_count
	}

	// Borrows the cluster's exact UTF-8 range without copying.
	pub func as_substring() -> Substring {
		Substring(storage: self.storage, start: self.start, byte_count: self.byte_count)
	}

	// Copies the cluster's UTF-8 bytes into a new owned string.
	pub func to_string() -> String {
		self.as_substring().to_string()
	}

	// Classification uses the cluster's first Unicode scalar. This keeps
	// combining marks attached for iteration while classifying `1` plus a
	// combining mark as numeric.
	pub func first_scalar() -> Int {
		_packed_scalar(
			packed: _utf8_decode(
				storage: self.storage,
				offset: self.start,
				end: self.start + self.byte_count
			)
		)
	}

	// Tests the first scalar against Unicode's `White_Space` property.
	pub func is_whitespace() -> Bool {
		scalar_is_whitespace(scalar: self.first_scalar())
	}

	// Tests the first scalar against Unicode's `Alphabetic` property.
	pub func is_alphabetic() -> Bool {
		scalar_is_alphabetic(scalar: self.first_scalar())
	}

	// Returns true for Unicode decimal, digit, or numeric-number scalars.
	pub func is_numeric() -> Bool {
		scalar_is_numeric(scalar: self.first_scalar())
	}

	// Returns true when the first scalar is Unicode alphabetic or numeric.
	pub func is_alphanumeric() -> Bool {
		scalar_is_alphanumeric(scalar: self.first_scalar())
	}

	// Returns true when the first scalar is in `0...9`.
	pub func is_ascii_digit() -> Bool {
		scalar_is_ascii_digit(scalar: self.first_scalar())
	}

	// Returns true for the ASCII hexadecimal digits `0...9`, `a...f`, or
	// `A...F`.
	pub func is_ascii_hexdigit() -> Bool {
		scalar_is_ascii_hexdigit(scalar: self.first_scalar())
	}

	// Returns true only for a one-byte ASCII grapheme cluster.
	pub func is_ascii() -> Bool {
		self.byte_count == 1 && self.first_scalar() < 128
	}

	// Returns true when the first scalar is an ASCII letter.
	pub func is_ascii_alphabetic() -> Bool {
		let scalar = self.first_scalar()
		(64 < scalar && scalar < 91) || (96 < scalar && scalar < 123)
	}

	// Returns true when the first scalar is an ASCII letter or decimal digit.
	pub func is_ascii_alphanumeric() -> Bool {
		self.is_ascii_alphabetic() || self.is_ascii_digit()
	}

	// Recognizes ASCII space and the tab, newline, vertical-tab, form-feed, and
	// return controls.
	pub func is_ascii_whitespace() -> Bool {
		let scalar = self.first_scalar()
		scalar == 9 || scalar == 10 || scalar == 11 || scalar == 12 || scalar == 13 || scalar == 32
	}

	// Tests the first scalar against Unicode's `Lowercase` property.
	pub func is_lowercase() -> Bool {
		scalar_is_lowercase(scalar: self.first_scalar())
	}

	// Tests the first scalar against Unicode's `Uppercase` property.
	pub func is_uppercase() -> Bool {
		scalar_is_uppercase(scalar: self.first_scalar())
	}

	// Returns true when the first scalar has Unicode general category `Lt`.
	pub func is_titlecase() -> Bool {
		scalar_is_titlecase(scalar: self.first_scalar())
	}

	// Returns true when the first scalar has Unicode general category `Nd`.
	pub func is_decimal() -> Bool {
		scalar_is_decimal(scalar: self.first_scalar())
	}

	// Returns true for Unicode decimal digits and compatibility digit
	// characters.
	pub func is_digit() -> Bool {
		scalar_is_digit(scalar: self.first_scalar())
	}

	// Returns true when the first scalar is in a Unicode punctuation category.
	pub func is_punctuation() -> Bool {
		scalar_is_punctuation(scalar: self.first_scalar())
	}

	// Returns true when the first scalar is in a Unicode symbol category.
	pub func is_symbol() -> Bool {
		scalar_is_symbol(scalar: self.first_scalar())
	}

	// Returns true when the first scalar has Unicode general category `Cc`.
	pub func is_control() -> Bool {
		scalar_is_control(scalar: self.first_scalar())
	}

	// Excludes Unicode control, format, surrogate, private-use, and unassigned
	// scalars.
	pub func is_printable() -> Bool {
		scalar_is_printable(scalar: self.first_scalar())
	}

	// Recognizes Talk identifier starts: an ASCII letter or underscore.
	pub func is_identifier_start() -> Bool {
		let scalar = self.first_scalar()
		self.is_ascii_alphabetic() || scalar == 95
	}

	// Recognizes Talk identifier continuations: a valid start or an
	// alphanumeric scalar.
	pub func is_identifier_continue() -> Bool {
		self.is_identifier_start() || self.is_alphanumeric()
	}

	// Returns the number of Unicode scalar values.
	pub func scalar_count() -> Int {
		let count = 0
		for _ in self.scalars() {
			count = count + 1
		}
		count
	}

	// Returns whether this grapheme cluster contains exactly one Unicode
	// scalar.
	pub func is_single_scalar() -> Bool {
		self.scalar_count() == 1
	}

	// Returns a view that iterates over Unicode scalar values.
	pub func scalars() -> ScalarIterator {
		ScalarIterator(
			storage: self.storage,
			offset: self.start,
			end: self.start + self.byte_count
		)
	}
}

extend Character: Borrowed {}
extend Character: Clone {}

// Byte equality of the cluster — same semantic as String equality, so
// canonically equivalent characters in different normal forms differ.
extend Character: Equatable {
	// Compares the grapheme clusters byte-for-byte without Unicode
	// normalization.
	pub func equals(_ rhs: Character) -> Bool {
		if self.byte_count != rhs.byte_count { return false }
		let idx = 0
		loop idx < self.byte_count {
			let lhs_byte: Byte = self.storage.get(self.start + idx)
			let rhs_byte: Byte = rhs.storage.get(rhs.start + idx)
			let same: Bool = #_ir(lhs_byte, rhs_byte) { %? = cmp Byte $0 == $1 }
			if same == false { return false }
			idx = idx + 1
		}
		true
	}
}

extend Character: Showable {
	// Copies the complete grapheme cluster into an owned display string.
	pub func show() -> String {
		self.to_string()
	}
}

extend Character: Add<String> {
	// Concatenates this grapheme cluster with `rhs`.
	pub func add(_ rhs: String) -> String {
		self.as_substring() + rhs
	}
}

// Walks extended grapheme clusters across a borrowed UTF-8 range.
//
// `offset` is always a cluster boundary no later than `end`. Malformed UTF-8
// follows the decoder's maximal-subpart replacement rule, so iteration always
// makes progress without allocating.
pub struct CharacterIterator {
	// The backing storage.
	pub let storage: ByteStorage
	// The byte offset in the underlying storage.
	pub let offset: Int
	// The exclusive ending byte offset in the source.
	pub let end: Int
}

extend CharacterIterator: Borrowed {}

extend CharacterIterator: Iterator<Character> {
	// Yields the borrowed cluster at `offset` and advances to the next UAX #29
	// boundary.
	pub mut func next() -> Character? {
		if self.end <= self.offset { return Optional.none }
		let next_offset: Int = _next_boundary(
			storage: self.storage,
			offset: self.offset,
			end: self.end
		)

		let ch = Character(
			storage: self.storage,
			start: self.offset,
			byte_count: next_offset - self.offset
		)
		self.offset = next_offset
		Optional.some(ch)
	}
}

// Walks Unicode scalar values across a borrowed UTF-8 range.
//
// Unlike `CharacterIterator`, this exposes code points rather than user-visible
// grapheme clusters. Malformed subsequences yield U+FFFD and consume one
// maximal subpart, so every call advances or reports exhaustion.
pub struct ScalarIterator {
	// The backing storage.
	pub let storage: ByteStorage
	// The byte offset in the underlying storage.
	pub let offset: Int
	// The exclusive ending byte offset in the source.
	pub let end: Int
}

extend ScalarIterator: Borrowed {}

extend ScalarIterator: Iterator<Int> {
	// Decodes one scalar, advances by its maximal-subpart byte count, or
	// reports exhaustion.
	pub mut func next() -> Int? {
		if self.end <= self.offset { return Optional.none }
		let packed: Int = _utf8_decode(
			storage: self.storage,
			offset: self.offset,
			end: self.end
		)
		self.offset = self.offset + _packed_size(packed: packed)
		Optional.some(_packed_scalar(packed: packed))
	}
}

extend String: Iterable {
	// Borrows the string and yields UAX #29 extended grapheme clusters.
	pub func iter() -> CharacterIterator {
		CharacterIterator(storage: self.storage, offset: 0, end: self.byte_count)
	}
}

extend Substring: Iterable {
	// Yields UAX #29 extended grapheme clusters within the substring's bounds.
	pub func iter() -> CharacterIterator {
		CharacterIterator(
			storage: self.storage,
			offset: self.start,
			end: self.start + self.byte_count
		)
	}
}

extend String {
	// Borrows the string as Unicode scalar values rather than grapheme
	// clusters.
	pub func scalars() -> ScalarIterator {
		ScalarIterator(storage: self.storage, offset: 0, end: self.byte_count)
	}
}

extend Substring {
	// Borrows this range as Unicode scalar values rather than grapheme
	// clusters.
	pub func scalars() -> ScalarIterator {
		ScalarIterator(
			storage: self.storage,
			offset: self.start,
			end: self.start + self.byte_count
		)
	}
}

extend Substring {
	// O(n): counts extended grapheme clusters by scanning boundaries.
	pub func count() -> Int {
		let n = 0
		let scan = self.start
		let stop: Int = self.start + self.byte_count
		loop scan < stop {
			scan = _next_boundary(storage: self.storage, offset: scan, end: stop)
			n = n + 1
		}
		n
	}
}

extend String {
	// O(n): counts extended grapheme clusters by scanning boundaries.
	pub func count() -> Int {
		self.as_substring().count()
	}
}
