// no-core
use package::IO::{ _io_read, _io_write, _io_close, _io_clamp, IORequest, io }
use package::Memory::{ _alloc }
use package::String::{ String }
use package::Operators::{ Comparable }

public let AF_INET: Int = 2
public let SOCK_STREAM: Int = 1
public let INADDR_ANY: Int = 0
public let LOCALHOST: Int = 2130706433

public func _io_socket(domain: Int, socktype: Int, proto: Int) 'io -> Int {
	'io(request: .socket(domain, socktype, proto))
}

public func _io_bind(fd: Int, addr: Int, port: Int) 'io -> Int {
	'io(request: .bind(fd, addr, port))
}

public func _io_listen(fd: Int, backlog: Int) 'io -> Int {
	'io(request: .listen(fd, backlog))
}

public func _io_connect(fd: Int, addr: Int, port: Int) 'io -> Int {
	'io(request: .connect(fd, addr, port))
}

public func _io_accept(fd: Int) 'io -> Int {
	'io(request: .accept(fd))
}

public struct TcpStream {
	let fd: Int

	public func connect(addr: Int, port: Int) -> TcpStream {
		let fd = _io_socket(domain: AF_INET, socktype: SOCK_STREAM, proto: 0)
		_io_connect(fd: fd, addr: addr, port: port)
		TcpStream(fd: fd)
	}

	public func read(buf: RawPtr, count: Int) -> Int {
		_io_read(fd: self.fd, buf: buf, count: count)
	}

	public func read_string(max: Int) -> String {
		let buf = _alloc<Byte>(count: max)
		let n = _io_clamp(
			count: _io_read(fd: self.fd, buf: buf, count: max),
			capacity: max
		)
		String(base: buf, byte_count: n, capacity: max)
	}

	public func write(buf: RawPtr, count: Int) -> Int {
		_io_write(fd: self.fd, buf: buf, count: count)
	}

	public func write_string(s: String) -> Int {
		_io_write(fd: self.fd, buf: s.storage.base, count: s.byte_count)
	}

	public func close() -> Int {
		_io_close(fd: self.fd)
	}

	public func is_valid() -> Bool { self.fd >= 0 }
}

public struct TcpListener {
	let fd: Int

	public func bind(port: Int) -> TcpListener {
		let fd = _io_socket(domain: AF_INET, socktype: SOCK_STREAM, proto: 0)
		_io_bind(fd: fd, addr: 0, port: port)
		_io_listen(fd: fd, backlog: 128)
		TcpListener(fd: fd)
	}

	public func accept() -> TcpStream {
		let client_fd = _io_accept(fd: self.fd)
		TcpStream(fd: client_fd)
	}

	public func close() -> Int {
		_io_close(fd: self.fd)
	}
}
