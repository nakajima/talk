// no-core
// Unique growable UTF-8 construction. Appending is amortized O(total bytes),
// and finish transfers the allocation into an immutable String without copying.
use package::String::{ String, Substring }
use package::Unicode::{ Character }
use package::Memory::{ ByteStorage, _byte_storage, _copy, _ptr_add }
use package::Operators::{ Add, Comparable, Divide, Equatable, Multiply, Subtract }

// Incrementally constructs one valid UTF-8 string in a unique growable buffer.
//
// `byte_count <= capacity`; the initialized prefix is valid UTF-8 after every
// public append. Growth doubles capacity, so repeated appends are amortized
// linear in the total bytes. `finish` transfers the allocation without copying.
pub struct StringBuilder {
	let storage: ByteStorage
	let byte_count: Int
	let capacity: Int

	// Creates an empty builder with no reserved capacity.
	pub init() {
		self.storage = _byte_storage(capacity: 0)
		self.byte_count = 0
		self.capacity = 0
	}

	// Creates an empty builder reserving at least `capacity` bytes.
	pub init(capacity: Int) {
		let initial_capacity: Int = if capacity < 0 {
			0
		} else {
			capacity
		}
		self.storage = _byte_storage(capacity: initial_capacity)
		self.byte_count = 0
		self.capacity = initial_capacity
	}

	// Ensures room for at least the requested number of bytes.
	pub mut func reserve_capacity(_ capacity: Int) -> Void {
		if capacity <= self.capacity { return () }
		let fresh: ByteStorage = _byte_storage(capacity: capacity)
		_copy(from: self.storage.base, to: fresh.base, length: self.byte_count)
		self.storage = fresh
		self.capacity = capacity
	}

	mut func ensure_capacity(_ required: Int) -> Void {
		if required <= self.capacity { return () }
		let grown: Int = if self.capacity == 0 {
			8
		} else {
			self.capacity * 2
		}
		let next: Int = if grown < required {
			required
		} else {
			grown
		}
		self.reserve_capacity(next)
	}

	mut func append_view(_ view: Substring) -> Void {
		if view.byte_count == 0 { return () }
		let required: Int = self.byte_count + view.byte_count
		self.ensure_capacity(required)
		let source: RawPtr = _ptr_add(ptr: view.storage.base, offset: view.start)
		let destination: RawPtr = _ptr_add(
			ptr: self.storage.base,
			offset: self.byte_count
		)
		_copy(from: source, to: destination, length: view.byte_count)
		self.byte_count = required
	}

	// Appends every UTF-8 byte in `value`.
	pub mut func append(string value: String) -> Void {
		self.append_view(value.as_substring())
	}

	// Appends the borrowed byte range in `value`.
	pub mut func append(substring value: Substring) -> Void {
		self.append_view(value)
	}

	// Appends the complete grapheme cluster represented by `value`.
	pub mut func append(character value: Character) -> Void {
		self.append_view(value.as_substring())
	}

	// Encodes one Unicode scalar and appends its UTF-8 bytes.
	//
	// Values outside the scalar range, including surrogate code points, are
	// replaced with U+FFFD. This keeps the builder's valid-UTF-8 invariant even
	// when low-level Unicode algorithms supply an invalid integer.
	pub mut func append_scalar(_ scalar: Int) -> Void {
		let valid: Int = if scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343) {
			65533
		} else {
			scalar
		}
		let bytes: Int = if valid < 128 {
			1
		} else {
			if valid < 2048 {
				2
			} else {
				if valid < 65536 {
					3
				} else {
					4
				}
			}
		}
		self.ensure_capacity(self.byte_count + bytes)
		if bytes == 1 {
			self.storage.set(index: self.byte_count, value: valid._toByte())
		} else {
			if bytes == 2 {
				self.storage.set(index: self.byte_count, value: (192 + valid / 64)._toByte())
				self.storage.set(
					index: self.byte_count + 1,
					value: (128 + valid - (valid / 64) * 64)._toByte()
				)
			} else {
				if bytes == 3 {
					self.storage.set(index: self.byte_count, value: (224 + valid / 4096)._toByte())
					self.storage.set(
						index: self.byte_count + 1,
						value: (128 + (valid / 64) - (valid / 4096) * 64)._toByte()
					)
					self.storage.set(
						index: self.byte_count + 2,
						value: (128 + valid - (valid / 64) * 64)._toByte()
					)
				} else {
					self.storage.set(
						index: self.byte_count,
						value: (240 + valid / 262144)._toByte()
					)
					self.storage.set(
						index: self.byte_count + 1,
						value: (128 + (valid / 4096) - (valid / 262144) * 64)._toByte()
					)
					self.storage.set(
						index: self.byte_count + 2,
						value: (128 + (valid / 64) - (valid / 4096) * 64)._toByte()
					)
					self.storage.set(
						index: self.byte_count + 3,
						value: (128 + valid - (valid / 64) * 64)._toByte()
					)
				}
			}
		}
		self.byte_count = self.byte_count + bytes
	}

	// Appends `string` followed by a newline byte.
	pub mut func append_line(_ string: String) -> Void {
		self.append_view(string.as_substring())
		self.append_view("\n".as_substring())
	}

	// Removes the accumulated contents while retaining allocated capacity.
	pub mut func clear() -> Void {
		self.byte_count = 0
	}

	// Returns the number of UTF-8 bytes.
	pub func utf8_count() -> Int {
		self.byte_count
	}

	// Transfers the initialized buffer into an immutable `String` without copying.
	//
	// The consumed builder is cleared before return so its destructor cannot
	// release the allocation now owned by the string.
	pub consuming func finish() -> String {
		let storage = self.storage
		let byte_count = self.byte_count
		let capacity = self.capacity
		self.storage = _byte_storage(capacity: 0)
		self.byte_count = 0
		self.capacity = 0
		String(base: storage, byte_count: byte_count, capacity: capacity)
	}
}
