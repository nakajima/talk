// no-core
// String is a UTF-8 byte buffer. Byte-level access lives behind the
// explicit `utf8()` view; `byte_count` is the buffer length in BYTES,
// not user-perceived characters. Equality is byte equality: canonically
// equivalent strings in different normal forms (NFC "é" vs NFD "é")
// compare unequal.
use package::Array::{ Array }
use package::Operators::{ Add, Comparable, Equatable, Subtract }
use package::Memory::{ ByteStorage, _alloc, _copy, _ptr_add, _store }
use package::Ownership::{ Borrowed, CheapClone }
use package::Optional::{ Optional }
use package::Iterable::{ IndexIterable }

pub struct String {
	pub let storage: ByteStorage
	pub let byte_count: Int
	pub let capacity: Int

	pub init(base: RawPtr, byte_count: Int, capacity: Int) {
		self.storage = ByteStorage(base: base)
		self.byte_count = byte_count
		self.capacity = capacity
		self
	}

	pub func to_string() -> String {
		let base: RawPtr = _alloc<Byte>(count: self.byte_count)
		_copy(from: self.storage.base, to: base, length: self.byte_count)
		String(base: base, byte_count: self.byte_count, capacity: self.byte_count)
	}

	// The bytes are copied into a fresh buffer, so byte-level string
	// building needs no raw allocation at the call site (ADR 0043
	// stage 0: the frontend source set may not use `@_ir`).
	pub static func from_bytes(bytes: &[Byte]) -> String {
		let count: Int = bytes.count
		let base: RawPtr = _alloc<Byte>(count: count)
		let i = 0
		loop i < count {
			let ptr: RawPtr = _ptr_add(ptr: base, offset: i)
			_store<Byte>(ptr: ptr, value: bytes.get(i))
			i = i + 1
		}
		String(base: base, byte_count: count, capacity: count)
	}
}

pub struct Substring {
	pub let storage: ByteStorage
	pub let start: Int
	pub let byte_count: Int

	pub init(storage: ByteStorage, start: Int, byte_count: Int) {
		self.storage = storage
		self.start = start
		self.byte_count = byte_count
		self
	}
}

extend Substring: Borrowed {}

extend String: CheapClone {}

// A borrowed view of a string's raw UTF-8 bytes. Offsets are byte
// offsets: `slice` can split a multi-byte character, so anything
// character-shaped should iterate instead.
pub struct UTF8View {
	pub let storage: ByteStorage
	pub let start: Int
	pub let byte_count: Int

	pub func count() -> Int { self.byte_count }

	pub func at(index: Int) -> Byte {
		self.storage.get(self.start + index)
	}

	pub func slice(start: Int, byte_count: Int) -> Substring {
		Substring(
			storage: self.storage,
			start: self.start + start,
			byte_count: byte_count
		)
	}
}

extend UTF8View: Borrowed {}

pub protocol StringMethods {
	func as_substring() -> Substring
	func utf8() -> UTF8View
	func find(needle: String) -> Int?
	func find_from(needle: String, start: Int) -> Int?
	func starts_with(needle: String) -> Bool
	func ends_with(needle: String) -> Bool
}

extend String: StringMethods {
	pub func as_substring() -> Substring {
		Substring(storage: self.storage, start: 0, byte_count: self.byte_count)
	}

	pub func utf8() -> UTF8View {
		UTF8View(storage: self.storage, start: 0, byte_count: self.byte_count)
	}

	pub func find(needle: String) -> Int? {
		self.as_substring().find(needle: needle)
	}

	pub func find_from(needle: String, start: Int) -> Int? {
		self.as_substring().find_from(needle: needle, start: start)
	}

	pub func starts_with(needle: String) -> Bool {
		self.as_substring().starts_with(needle: needle)
	}

	pub func ends_with(needle: String) -> Bool {
		self.as_substring().ends_with(needle: needle)
	}
}

extend Substring {
	pub func utf8() -> UTF8View {
		UTF8View(storage: self.storage, start: self.start, byte_count: self.byte_count)
	}

	pub func find(needle: String) -> Int? {
		self.find_from(needle: needle, start: 0)
	}

	// The found offset is a UTF-8 byte offset, valid as `utf8().slice`
	// input. Byte-wise search is exact for UTF-8: a needle can only
	// match at character boundaries of itself.
	pub func find_from(needle: String, start: Int) -> Int? {
		if start < 0 { return Optional.none }
		if self.byte_count < start { return Optional.none }
		if needle.byte_count == 0 { return Optional.some(start) }
		if self.byte_count < needle.byte_count { return Optional.none }

		let last: Int = self.byte_count - needle.byte_count
		let i: Int = start
		loop {
			if last < i {
				break
			}
			let window: Substring = self.utf8().slice(
				start: i,
				byte_count: needle.byte_count
			)
			if window.equals_string(needle) { return Optional.some(i) }
			i = i + 1
		}
		Optional.none
	}

	pub func to_string() -> String {
		let base: RawPtr = _alloc<Byte>(count: self.byte_count)
		let source: RawPtr = _ptr_add(ptr: self.storage.base, offset: self.start)
		_copy(from: source, to: base, length: self.byte_count)
		String(base: base, byte_count: self.byte_count, capacity: self.byte_count)
	}

	pub func equals_string(_ rhs: String) -> Bool {
		if self.byte_count != rhs.byte_count { return false }

		let i = 0
		loop i < self.byte_count {
			let lhs_byte: Byte = self.storage.get(self.start + i)
			let rhs_byte: Byte = rhs.storage.get(i)
			let same: Bool = @_ir(lhs_byte, rhs_byte) { %? = cmp Byte $0 == $1 }
			if same == false { return false }
			i = i + 1
		}
		true
	}

	pub func starts_with(needle: String) -> Bool {
		if needle.count() > self.count() { return false }
		let chars = self.iter()
		let needle_chars = needle.iter()

		for needle_char in needle_chars {
			if let .some(char) = chars.next() {
				if char != needle_char { return false }
			} else {
				return false
			}
		}

		true
	}

	pub func ends_with(needle: String) -> Bool {
		if needle.count() > self.count() { return false }
		let chars = self.iter().skip(count: self.count() - needle.count())
		let needle_chars = needle.iter()

		for char in chars {
			if let .some(needle_char) = needle_chars.next() {
				if needle_char != char { return false }
			} else {
				return false
			}
		}

		true
	}
}

extend Substring: Equatable<Substring> {
	pub func equals(_ rhs: Substring) -> Bool {
		if self.byte_count != rhs.byte_count { return false }

		let i = 0
		loop i < self.byte_count {
			if self.storage.get(self.start + i) != rhs.storage.get(rhs.start + i) { return false }
			i = i + 1
		}
		true
	}
}

extend Substring: Add<String> {
	pub func add(_ rhs: String) -> String {
		self.to_string() + rhs
	}
}

extend String: Add<String> {
	pub func add(_ rhs: String) -> String {
		let selfLen: Int = self.byte_count
		let rhsLen: Int = rhs.byte_count
		let newLen: Int = selfLen + rhsLen
		let newBase: RawPtr = _alloc<Byte>(count: newLen)
		_copy(from: self.storage.base, to: newBase, length: selfLen)

		let rhsDest: RawPtr = _ptr_add(ptr: newBase, offset: selfLen)
		_copy(from: rhs.storage.base, to: rhsDest, length: rhsLen)
		String(base: newBase, byte_count: newLen, capacity: newLen)
	}
}

extend String: Equatable<String> {
	pub func equals(_ rhs: String) -> Bool {
		if self.byte_count != rhs.byte_count { return false }

		let i = 0
		loop i < self.byte_count {
			let lhs_byte: Byte = self.storage.get(i)
			let rhs_byte: Byte = rhs.storage.get(i)
			let same: Bool = @_ir(lhs_byte, rhs_byte) { %? = cmp Byte $0 == $1 }
			if same == false { return false }
			i = i + 1
		}
		true
	}
}
