// WIP: Lots to do here. Oodles.
// A key value data structure.

// One entry in the dictionary linked list.
pub struct DictNode<Value> 'heap {
	// The dictionary key.
	pub let key: String
	// The value stored for `key`.
	pub let value: Value
	// The next node in the linked sequence, when present.
	pub let next: DictNode<Value>?
}

func dict_find<Value>(current: DictNode<Value>?, key: String) -> Optional<&Value> {
	match current {
		.some(node) -> {
			if node.key == key {
				Optional.some(node.value)
			} else {
				dict_find(current: node.next, key: key)
			}
		},
		.none -> Optional.none
	}
}

// A string-keyed dictionary over region-allocated ('heap) nodes. Insertion
// prepends in O(1), duplicate keys shadow older entries, and lookup is linear.
pub struct Dict<Value> 'heap {
	// The first node in the linked sequence, when present.
	pub let head: DictNode<Value>?
	// The number of key-value entries.
	pub let count: Int

	// Creates an empty dictionary.
	pub init() {
		self.head = Optional.none
		self.count = 0
		self
	}

	// Prepends an entry; an existing equal key remains stored but is shadowed.
	pub mut func insert(consume key: String, consume value: Value) -> Void {
		self.head = Optional.some(DictNode(key: key, value: value, next: self.head))
		self.count = self.count + 1
	}
}

extend<Value> Dict<Value> {
	// Returns the most recently inserted value for `key`, or `none` when absent.
	pub func get(key: String) -> Optional<&Value> {
		dict_find(current: self.head, key: key)
	}
}
