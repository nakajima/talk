// A lexical file-system path represented as components.
//
// A leading `/` component marks an absolute path. Construction does not touch
// the file system or resolve `.`, `..`, `~`, or symlinks; use `normalized`,
// `expanded`, or `canonicalized` for those progressively stronger operations.
pub struct Path {
	// Lexical path components; an initial `/` component marks an absolute path.
	pub let components: [String]

	init(components: [String]) {
		self.components = components
	}

	// Splits a path spelling into components while preserving a leading root marker.
	pub init(_ string: String) {
		// `split` omits empty components, so the absolute-path marker is
		// restored explicitly: a leading separator becomes the "/" root
		// component `to_string` and `appending` already understand.
		let all: [String] = []
		if string.starts_with(needle: "/") { all.push("/") }
		for part in string.split(character: '/').into_iter() {
			all.push(part.to_string())
		}
		self.components = all
	}
}

// An open host file descriptor with synchronous read, write, seek, and stat operations.
//
// Methods return operation-specific `Error` values carrying negative errno
// codes. The handle is not automatically invalidated after `close`, so callers
// must avoid subsequent operations and repeated closes.
pub struct File {
	// A failed host file operation. Each payload is the host's negated errno.
	pub enum Error {
		// Opening the requested path failed.
		case open(Int)
		// Reading from the file descriptor failed.
		case read(Int)
		// Writing to the file descriptor failed.
		case write(Int)
		// Repositioning the file offset failed.
		case seek(Int)
		// Querying file metadata failed.
		case stat(Int)
	}

	// The access requested when opening a file.
	pub enum Mode {
		// Open for reading only.
		case r
		// Open for writing, creating or truncating the file.
		case w
		// Open for both reading and writing, creating the file if needed.
		case rw
	}

	// An offset interpreted relative to a particular file position.
	pub enum SeekFrom {
		// `Int` bytes from the beginning of the file.
		case start(Int)
		// `Int` bytes from the current file offset.
		case current(Int)
		// `Int` bytes from the end of the file.
		case end(Int)
	}

	let fd: Int
	let mode: Mode

	// Open the file at `path`: `.r` reads, `.w` truncates or creates,
	// `.rw` reads and writes, creating the file when missing.
	pub static func open(path: Path, mode: Mode) -> Result<File, Error> {
		let flags = match mode {
			.r -> O_RDONLY,
			.w -> O_WRONLY + O_CREAT + O_TRUNC,
			.rw -> O_RDWR + O_CREAT
		}
		let permissions = S_IRUSR + S_IWUSR
		let fd = open_path(path: path.to_string(), flags: flags, mode: permissions)
		if fd < 0 { return .error(.open(fd)) }
		.ok(File(fd: fd, mode: mode))
	}

	// Reads from the current offset until the host reports end-of-file.
	//
	// The buffer starts at 4096 bytes or the current file size, whichever is
	// larger, and doubles as needed. On error, partial bytes are discarded and
	// returned storage is freed.
	pub func read() -> Result<String, Error> {
		#unsafe {
			let capacity = 4096
			let size = _io_file_size(fd: self.fd)
			if size > capacity { capacity = size }
			let buf = _alloc<Byte>(count: capacity)
			let total = 0
			loop {
				let n = _io_read(
					fd: self.fd,
					buf: _ptr_add(ptr: buf, offset: total),
					count: capacity - total
				)
				if n < 0 {
					_free(ptr: buf)
					return .error(.read(n))
				}
				if n == 0 { break }
				total = total + n
				if total == capacity {
					let grown = _alloc<Byte>(count: capacity * 2)
					_copy(from: buf, to: grown, length: total)
					_free(ptr: buf)
					buf = grown
					capacity = capacity * 2
				}
			}
			.ok(String(base: ByteStorage(base: buf), byte_count: total, capacity: capacity))
		}
	}

	// Performs one host read of at most `count` bytes from the current offset.
	//
	// `count` must be non-negative. A short read is successful and advances the
	// descriptor by only the bytes received. Unlike `read()`, this does not loop
	// to fill the requested count.
	pub func read(count: Int) -> Result<String, Error> {
		#unsafe {
			let buf = _alloc<Byte>(count: count)
			let n = _io_read(fd: self.fd, buf: buf, count: count)
			if n < 0 {
				_free(ptr: buf)
				return .error(.read(n))
			}
			let clamped = _io_clamp(count: n, capacity: count)
			return .ok(String(base: ByteStorage(base: buf), byte_count: clamped, capacity: count))
		}
	}

	// Write the whole string, looping over partial writes. The answer
	// is the byte count written.
	pub func write(_ string: String) -> Result<Int, Error> {
		#unsafe {
			let total = 0
			loop total < string.byte_count {
				let n = _io_write(
					fd: self.fd,
					buf: _ptr_add(ptr: string.storage.base, offset: total),
					count: string.byte_count - total
				)
				if n < 0 { return .error(.write(n)) }
				total = total + n
			}
			.ok(total)
		}
	}

	// Moves the descriptor offset relative to the selected origin.
	//
	// Success returns the new absolute byte offset. Host failure preserves the
	// negative errno in `Error.seek`.
	pub func seek(from: SeekFrom) -> Result<Int, Error> {
		match from {
			.start(offset) -> self.seek(offset: offset, whence: SEEK_SET),
			.current(offset) -> self.seek(offset: offset, whence: SEEK_CUR),
			.end(offset) -> self.seek(offset: offset, whence: SEEK_END)
		}
	}

	// Queries the current byte offset by seeking zero bytes from `.current`.
	pub func tell() -> Result<Int, Error> {
		self.seek(from: .current(0))
	}

	// Returns the descriptor's current file size from host metadata.
	//
	// This does not change the file offset. Metadata failure is returned as
	// `Error.stat` with the host's negative errno.
	pub func size() -> Result<Int, Error> {
		let size = _io_file_size(fd: self.fd)
		if size < 0 { return .error(.stat(size)) }
		.ok(size)
	}

	// Requests one host close and returns zero or a negative errno.
	//
	// The stored descriptor is not invalidated, so repeated closes or later I/O
	// remain the caller's responsibility.
	pub func close() -> Int {
		_io_close(fd: self.fd)
	}

	// Returns whether the stored descriptor is non-negative.
	//
	// This reflects construction only; it remains true after `close` because the
	// handle does not mutate its descriptor.
	pub func is_valid() -> Bool { self.fd >= 0 }

	func seek(offset: Int, whence: Int) -> Result<Int, Error> {
		let position = _io_seek(fd: self.fd, offset: offset, whence: whence)
		if position < 0 { return .error(.seek(position)) }
		.ok(position)
	}
}
