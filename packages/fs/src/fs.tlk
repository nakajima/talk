// Unsafe operations are scoped in Directory.entries.
let _directory_entry_directory = 1
let _directory_entry_symlink = 3

use os::{ OS }

extend Path {
	// Joins lexical components with `/` separators.
	//
	// An initial `/` component renders exactly one leading separator. Empty paths
	// render as an empty string; no normalization or host lookup occurs.
	pub func to_string() -> String {
		if self.components.count == 0 { return "" }

		let str = self.components.get(0).to_string()
		let i = 1
		loop i < self.components.count {
			let component = self.components.get(i).to_string()
			if str.to_string() == "/" {
				str = str + component
			} else {
				str = str + "/" + component
			}
			i = i + 1
		}
		str.to_string()
	}

	// Returns a new path with `component` appended as one lexical component.
	//
	// The component is not split, normalized, or checked for separators. Existing
	// path storage is copied so the receiver remains unchanged.
	pub func appending(consume component: String) -> Path {
		let count = self.components.count + 1
		let storage = _storage<String>(capacity: count)
		let i = 0
		loop i < self.components.count {
			storage.set(index: i, value: self.components.get(i).to_string())
			i = i + 1
		}
		storage.set(index: self.components.count, value: component)
		Path(components: Array<String>(storage: storage, count: count, capacity: count))
	}

	// Returns whether the first component is the `/` root marker.
	pub func is_absolute() -> Bool {
		self.components.count > 0 && self.components.get(0).to_string() == "/"
	}

	// Resolve "." and ".." lexically, without touching the file system:
	// "." drops out, ".." pops one component, ".." at the root of an
	// absolute path goes nowhere, and leading ".."s of a relative path
	// are kept.
	pub func normalized() -> Path {
		let out: [String] = []
		if self.is_absolute() { out.push("/") }
		let i = 0
		loop i < self.components.count {
			let component = self.components.get(i).to_string()
			if component == "/" || component == "." {
				// The root marker is already in `out`; "." is a no-op.
			} else {
				if component == ".." {
					if out.count == 0 {
						out.push("..")
					} else {
						let last = out.get(out.count - 1).to_string()
						if last == ".." {
							out.push("..")
						} else {
							if last != "/" { out.pop() }
						}
					}
				} else {
					out.push(component)
				}
			}
			i = i + 1
		}
		Path(components: out)
	}

	// Replace a leading "~" component with the value of $HOME. The answer
	// is none when the path has no leading tilde and none is needed, and
	// none when HOME is not set.
	pub func expanding_tilde() -> Path? {
		if self.components.count == 0 { return Optional.some(self) }
		if self.components.get(0).to_string() != "~" { return Optional.some(self) }
		match OS.getenv(name: "HOME") {
			.none -> Optional.none,
			.some(home) -> {
				let expanded = Path(home)
				let i = 1
				loop i < self.components.count {
					expanded = expanded.appending(component: self.components.get(i).to_string())
					i = i + 1
				}
				Optional.some(expanded)
			}
		}
	}

	// Prepend the current working directory to a relative path; absolute
	// paths are returned unchanged. The answer is none when the cwd cannot
	// be determined. No "."/".." resolution happens here: that is what
	// normalized and expanded are for.
	pub func absolute() -> Path? {
		if self.is_absolute() { return Optional.some(self) }
		match OS.cwd() {
			.none -> Optional.none,
			.some(cwd) -> {
				let result = Path(cwd)
				let i = 0
				loop i < self.components.count {
					result = result.appending(component: self.components.get(i).to_string())
					i = i + 1
				}
				Optional.some(result)
			}
		}
	}

	// Applies tilde expansion, absolutization, and lexical normalization in order.
	//
	// This does not access path components or resolve symlinks. `none` means HOME
	// or the current working directory required by the input was unavailable;
	// compare `canonicalized`, which requires an existing host path.
	pub func expanded() -> Path? {
		match self.expanding_tilde() {
			.none -> Optional.none,
			.some(tilde) -> {
				match tilde.absolute() {
					.none -> Optional.none,
					.some(full) -> Optional.some(full.normalized())
				}
			}
		}
	}

	// Canonicalize through the host (POSIX realpath): every component is
	// resolved, symlinks included, so the path must exist. The answer is
	// none when the host cannot resolve it.
	pub func canonicalized() -> Path? {
		#unsafe {
			let path_string = self.to_string()
			let path_buf = _alloc<Byte>(count: path_string.byte_count + 1)
			_copy(
				from: path_string.storage.base,
				to: path_buf,
				length: path_string.byte_count
			)

			let len = _io_realpath_len(path: path_buf)
			if len < 0 {
				_free(ptr: path_buf)
				return Optional.none
			}

			let buf = _alloc<Byte>(count: len)
			let copied = _io_realpath_copy(path: path_buf, buf: buf)
			_free(ptr: path_buf)
			if copied < 0 {
				_free(ptr: buf)
				return Optional.none
			}

			let copied = _io_clamp(count: copied, capacity: len)
			Optional.some(
				Path(String(base: ByteStorage(base: buf), byte_count: copied, capacity: copied))
			)
		}
	}
}

extend Path: Showable {
	// Displays the lexical path using the same joining rules as `to_string`.
	pub func show() -> String {
		self.to_string()
	}
}

// A lightweight directory path, not an open directory handle.
//
// Each call to `entries` asks the host to enumerate the path afresh. Enumeration
// failures are represented as an empty or partial array rather than `Result`;
// use this API for traversal where best-effort behavior is acceptable.
pub struct Directory {
	// The directory path passed to host enumeration operations.
	pub let path: Path

	// Enumerates immediate children and classifies directories, files, and symlinks.
	//
	// Names are appended to `path` without canonicalizing symlinks. Failure to
	// open the directory returns an empty array; an error during iteration returns
	// entries collected before the error.
	pub func entries() -> [DirectoryEntry] {
		#unsafe {
			let path_string = self.path.to_string()
			let path_buf = _alloc<Byte>(count: path_string.byte_count + 1)
			_copy(
				from: path_string.storage.base,
				to: path_buf,
				length: path_string.byte_count
			)

			let real_count = _io_dir_count(path: path_buf)
			if real_count < 0 {
				_free(ptr: path_buf)
				return []
			}

			let capacity = real_count
			let storage = _storage<DirectoryEntry>(capacity: capacity)

			let i = 0
			let out = 0

			loop i < real_count {
				let name_len = _io_dir_entry_len(path: path_buf, index: i)
				if name_len < 0 {
					break
				}

				let name_buf = _alloc<Byte>(count: name_len)
				let copied = _io_dir_entry_copy(path: path_buf, index: i, buf: name_buf)
				if copied < 0 {
					_free(ptr: name_buf)
					break
				}

				let name = String(
					base: ByteStorage(base: name_buf),
					byte_count: copied,
					capacity: copied
				)
				let entry_path = self.path.appending(component: name)
				let kind = _io_dir_entry_kind(path: path_buf, index: i)

				if kind == _directory_entry_directory {
					storage.set(
						index: out,
						value: DirectoryEntry.directory(Directory(path: entry_path))
					)
				} else {
					if kind == _directory_entry_symlink {
						storage.set(index: out, value: DirectoryEntry.symlink(entry_path))
					} else {
						storage.set(index: out, value: DirectoryEntry.file(FsFile(path: entry_path)))
					}
				}
				i = i + 1
				out = out + 1
			}

			_free(ptr: path_buf)
			Array<DirectoryEntry>(storage: storage, count: out, capacity: capacity)
		}
	}

	// Performs a depth-first pre-order traversal beneath this directory.
	//
	// `fn` sees a child directory before its descendants. Symbolic links are
	// reported but never followed, avoiding link cycles; enumeration errors use
	// the same best-effort behavior as `entries`.
	pub func walk(fn: (DirectoryEntry) -> ()) {
		for entry in self.entries() {
			match entry {
				.directory(directory) -> {
					fn(entry)
					directory.walk(fn: fn)
				},
				other -> fn(other)
			}
		}
	}
}

// A file entry discovered while traversing a directory.
pub struct FsFile {
	// The file path discovered during directory enumeration.
	pub let path: Path
}

// The kind and path of an entry returned by directory traversal.
pub enum DirectoryEntry {
	// A child directory that can itself be enumerated.
	case directory(Directory)
	// A regular file.
	case file(FsFile)
	// A symbolic link; the path names the link rather than its target.
	case symlink(Path)
}

extend Directory: Showable {
	// Formats the wrapper as `Directory(path:<lexical path>)` for diagnostics.
	pub func show() -> String {
		"Directory(path:" + self.path.to_string() + ")"
	}
}

