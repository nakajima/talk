// Runtime support for the stdlib HTML syntax macro.

// An HTML fragment trusted for direct insertion into a rendered document.
//
// The `html` macro constructs this after escaping interpolated values; its
// reference documents the complete template grammar and escaping rules. The
// public initializer is an explicit trust boundary: callers must not wrap
// unescaped user text. Ordinary values should conform to `RenderHtml` instead.
pub struct Markup {
	let value: String

	// Wraps HTML emitted by the syntax macro; `value` must already be safe markup.
	pub init(value: String) {
		self.value = value
	}

	// Transfers the trusted HTML string out of this wrapper without copying.
	pub consuming func into_string() -> String {
		self.value
	}
}

extend Markup: Showable {
	// Returns a copy of the trusted HTML bytes; no escaping is added.
	pub func show() -> String {
		self.value.to_string()
	}
}

// Text explicitly marked as already escaped or known-safe HTML.
//
// Rendering passes the bytes through unchanged. This is used to compose output
// from trusted renderers; wrapping arbitrary user input would bypass the HTML
// macro's escaping guarantee.
pub struct PreEscaped {
	let value: String

	// Marks `value` as already escaped so rendering will not escape it again.
	pub init(value: String) {
		self.value = value
	}
}

extend PreEscaped: Showable {
	// Returns a copy of the trusted bytes; no escaping is added.
	pub func show() -> String {
		self.value.to_string()
	}
}

// The HTML5 doctype declaration as trusted markup.
pub let DOCTYPE = PreEscaped(value: "<!DOCTYPE html>")

func escape_html(value: String) -> String {
	let escaped = ""
	for character in value {
		escaped = escaped + match character {
		'&' -> "&amp;",
		'<' -> "&lt;",
		'>' -> "&gt;",
		'"' -> "&quot;",
		'\'' -> "&#39;",
		_ -> character.to_string()
		}
	}
	escaped
}

// Converts a value to an HTML-safe string; the default escapes its `Showable` representation.
pub protocol RenderHtml where Self: Showable {
	// Returns HTML-safe text for insertion into markup.
	func render_html() -> String {
		escape_html(value: self.show())
	}
}

extend String: RenderHtml {}
extend Int: RenderHtml {}
extend Float: RenderHtml {}
extend Bool: RenderHtml {}
extend Character: RenderHtml {}

extend Markup: RenderHtml {
	// Returns the macro-produced markup without escaping it again.
	pub func render_html() -> String {
		self.value.to_string()
	}
}

extend PreEscaped: RenderHtml {
	// Returns the trusted escaped text unchanged.
	pub func render_html() -> String {
		self.value.to_string()
	}
}

// Dispatches to the value's HTML-safe rendering implementation.
pub func render_html<Value: RenderHtml>(value: Value) -> String {
	value.render_html()
}

// Appends one class value to an existing space-separated class list.
pub func append_html_class(classes: String, value: String) -> String {
	if classes.byte_count == 0 { return value }
	if value.byte_count == 0 { return classes }
	classes + " " + value
}

// Wraps a macro-generated class list in a leading-space `class` attribute.
//
// `value` is expected to contain trusted class-name text assembled by
// `append_html_class`; this helper does not perform HTML escaping.
pub func render_class_attribute(value: String) -> String {
	if value.byte_count == 0 { "" } else { " class=\"" + value + "\"" }
}

// Renders a leading-space attribute only when `value` is present.
//
// The attribute value passes through `RenderHtml`; `name` is trusted syntax
// generated by the macro and is not escaped here.
pub func render_optional_html_attribute<Value: RenderHtml>(name: String, consume value: Value?) -> String {
	match value {
		.some(found) -> " " + name + "=\"" + render_html(value: found) + "\"",
		.none -> ""
	}
}

// Concatenates a rendered macro body for every element in iteration order.
//
// `body` must return already-safe markup produced by the macro expansion; this
// helper joins strings directly and does not escape them again.
pub func render_html_loop<Values: Iterable>(values: Values, consume body: (Values.Element) -> String) -> String {
	let output = ""
	for value in values {
		output = output + body(value)
	}
	output
}

